	<parameter name="p_locale" class="java.lang.String"/>
	<parameter name="p_milk_type_code" class="java.lang.String"/>
	<queryString>
		<![CDATA[select b.from_date,b.to_date,b.total_milk_qty,b.total_milk_amount,b.bonus_criteria_amount as bonus_amount,
((100*bonus_criteria_amount)/total_milk_amount) as percentage,s.code as society_code,
case when $P{p_locale}='en' then s.name
     else s.name_local end as society_name
from bonus_summary b join society s on s.code=b.society_code where from_date>=$P{p_from_date} and to_date <=$P{p_to_date} and 
case when $P{p_milk_type_code}='0' then b.x_col1=b.x_col1 else b.x_col1=$P{p_locale} end
;]]>
	</queryString>
