	</variable>
	<variable name="Md_Mix_KgFat" class="java.math.BigDecimal" calculation="Sum">
		<variableExpression><![CDATA[ $V{Md_Total_Mix_Qty}.multiply( $V{Md_Mix_KgFat}).divide(new java.math.BigDecimal(100), java.math.RoundingMode.HALF_UP)]]></variableExpression>
	</variable>
	<variable name="Md_Mix_Fat" class="java.math.BigDecimal" calculation="Sum">
