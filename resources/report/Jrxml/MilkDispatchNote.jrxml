	</variable>
	<variable name="Md_Cow_Fat" class="java.math.BigDecimal" calculation="Sum">
		<variableExpression><![CDATA[$V{Md_Total_Cow_Qty}.compareTo(BigDecimal.ZERO)>0 ?$V{Md_Cow_AvgFat}.divide($V{Md_Total_Cow_Qty},18,2).multiply(new BigDecimal(100)): 0.0]]></variableExpression>
	</variable>
	<variable name="Md_Mix_AvgFat" class="java.math.BigDecimal" calculation="Sum">
