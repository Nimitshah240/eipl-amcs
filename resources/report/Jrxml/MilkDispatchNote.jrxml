	<variable name="Md_Fat" class="java.math.BigDecimal" calculation="Sum">
		<variableExpression><![CDATA[$V{Md_Total_Buff_Qty}.compareTo(BigDecimal.ZERO)>0 ?$V{Md_AvgFat}.divide($V{Md_Total_Buff_Qty},18,2).multiply(new BigDecimal(100)): 0.0]]></variableExpression>
