	<variable name="Total_Qty" class="java.math.BigDecimal" resetType="Group" resetGroup="AnimalType grp" calculation="Sum">
		<variableExpression><![CDATA[$F{qty}]]></variableExpression>
	</variable>
	<variable name="Avg_Fat" class="java.math.BigDecimal" resetType="Group" resetGroup="AnimalType grp" calculation="Sum">
		<variableExpression><![CDATA[$F{fat}.multiply($F{qty}).divide(new BigDecimal(100))]]></variableExpression>
	</variable>
	<variable name="kg_Fat" class="java.math.BigDecimal" resetType="Group" resetGroup="AnimalType grp">
		<variableExpression><![CDATA[$V{Total_Qty}.multiply($V{Avg_Fat}).divide(new java.math.BigDecimal(100), java.math.RoundingMode.HALF_UP)]]></variableExpression>
	</variable>
	<variable name="Fat" class="java.math.BigDecimal" resetType="Group" resetGroup="AnimalType grp">
		<variableExpression><![CDATA[$V{Total_Qty}.compareTo(BigDecimal.ZERO)>0 ?$V{Avg_Fat}.divide($V{Total_Qty},18,2).multiply(new BigDecimal(100)): 0.0]]></variableExpression>
	</variable>
	<variable name="Avg_Snf" class="java.math.BigDecimal" resetType="Group" resetGroup="AnimalType grp" calculation="Sum">
		<variableExpression><![CDATA[$F{snf}.multiply($F{qty}).divide(new BigDecimal(100))]]></variableExpression>
	</variable>
	<variable name="kg_Snf" class="java.math.BigDecimal" resetType="Group" resetGroup="AnimalType grp">
		<variableExpression><![CDATA[$V{Total_Qty}.multiply($V{Avg_Snf}).divide(new java.math.BigDecimal(100), java.math.RoundingMode.HALF_UP)]]></variableExpression>
	</variable>
	<variable name="Snf" class="java.math.BigDecimal" resetType="Group" resetGroup="AnimalType grp">
		<variableExpression><![CDATA[$V{Total_Qty}.compareTo(BigDecimal.ZERO)>0 ?$V{Avg_Snf}.divide($V{Total_Qty},18,2).multiply(new BigDecimal(100)): 0.0]]></variableExpression>
	</variable>
	<variable name="Total_Amount" class="java.math.BigDecimal" resetType="Group" resetGroup="AnimalType grp" calculation="Sum">
		<variableExpression><![CDATA[$F{amount}]]></variableExpression>
	</variable>
	<variable name="Total_Sample" class="java.lang.Integer" resetType="Group" resetGroup="AnimalType grp" calculation="Count">
		<variableExpression><![CDATA[$F{sample_no}]]></variableExpression>
	</variable>
	<variable name="edit" class="java.lang.Integer" calculation="Sum">
		<variableExpression><![CDATA[$F{edit}]]></variableExpression>
	</variable>
	<variable name="auto" class="java.lang.Integer" calculation="Sum">
		<variableExpression><![CDATA[$F{auto}]]></variableExpression>
	</variable>
	<group name="total_grp"/>
	<group name="grand_total_grp">
		<groupFooter>
			<band>
				<property name="com.jaspersoft.studio.unit.height" value="px"/>
				<printWhenExpression><![CDATA[$F{sr} == 2]]></printWhenExpression>
			</band>
