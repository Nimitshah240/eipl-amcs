                                        </ImageView>
                                    </graphic>
                                </Button>
                                <Button fx:id="btnClose" minHeight="35.0" minWidth="100.0" mnemonicParsing="true" text="%close">
                                    <graphic>
                                        <ImageView fitHeight="20.0" fitWidth="20.0" pickOnBounds="true" preserveRatio="true">
                                            <image>
                                                <Image url="@../images/close.png" />
                                            </image>
                                        </ImageView>
                                    </graphic>
                                </Button>
                            </children>
