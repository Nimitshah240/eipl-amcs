<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>

<?import com.eipl.amcs.controls.E_DatePicker?>
<?import com.eipl.amcs.controls.AutoSearchTextField?>
<StackPane fx:id="root" prefHeight="400.0" prefWidth="949.0" styleClass="pane-center" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.eipl.amcs.report.controller.MilkSaleDispatchMonthWiseController">
    <children>
        <VBox prefHeight="200.0" prefWidth="100.0" spacing="15.0">
            <children>
                <Label styleClass="header-text" text="%milksaledispatchmonthwise" />
            <GridPane hgap="10.0">
              <columnConstraints>
                  <ColumnConstraints hgrow="SOMETIMES" maxWidth="125.0" minWidth="10.0" percentWidth="13.0" prefWidth="100.0" />
                  <ColumnConstraints hgrow="SOMETIMES" maxWidth="125.0" minWidth="10.0" percentWidth="16.0" prefWidth="100.0" />
                  <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" percentWidth="17.0" prefWidth="100.0" />
                  <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" percentWidth="13.0" prefWidth="100.0" />
                  <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" percentWidth="19.0" prefWidth="100.0" />
                  <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" percentWidth="16.0" prefWidth="100.0" />
                <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" percentWidth="22.20000000000001" prefWidth="100.0" />
              </columnConstraints>
              <rowConstraints>
                <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
                <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
              </rowConstraints>
               <children>
                  <Label text="%fromdate" />
                  <Label text="%fromshift" GridPane.columnIndex="1" />
                  <E_DatePicker fx:id="dpFromDate" maxWidth="1.7976931348623157E308" prefHeight="25.0" prefWidth="104.0" GridPane.rowIndex="1" />
                  <AutoSearchTextField fx:id="cboxFromShift" maxWidth="1.7976931348623157E308" GridPane.columnIndex="1" GridPane.rowIndex="1" />
      
                      <HBox alignment="CENTER_RIGHT" prefHeight="35.0" prefWidth="40.0" spacing="10.0" GridPane.columnIndex="6" GridPane.rowIndex="1">
                          <children>
                              <Button fx:id="btnGenerate" minHeight="35.0" minWidth="100.0" mnemonicParsing="true" text="%generate">
                                  <graphic>
                                      <ImageView fitHeight="20.0" fitWidth="20.0" pickOnBounds="true" preserveRatio="true">
                                          <image>
                                              <Image url="@../images/generate.png" />
                                          </image>
                                      </ImageView>
                                  </graphic>
                              </Button>
                              <Button fx:id="btnClose" minHeight="35.0" minWidth="100.0" mnemonicParsing="true" text="%close">
                                  <graphic>
                                      <ImageView fitHeight="20.0" fitWidth="20.0" pickOnBounds="true" preserveRatio="true">
                                          <image>
                                              <Image url="@../images/close.png" />
                                          </image>
                                      </ImageView>
                                  </graphic>
                              </Button>
                          </children>
                      </HBox>
                  <Label text="%milktype" GridPane.columnIndex="4" />
                  <AutoSearchTextField fx:id="cboxMilkType" maxWidth="1.7976931348623157E308" GridPane.columnIndex="4" GridPane.rowIndex="1" />
                  <Label text="%toshift" GridPane.columnIndex="3" />
                  <AutoSearchTextField fx:id="cboxToShift" maxWidth="1.7976931348623157E308" GridPane.columnIndex="3" GridPane.rowIndex="1" />
                  <E_DatePicker fx:id="dpToDate" maxWidth="1.7976931348623157E308" GridPane.columnIndex="2" GridPane.rowIndex="1" />
                  <Label text="%todate" GridPane.columnIndex="2" />
                  <Label text="%language" GridPane.columnIndex="5" />
                  <AutoSearchTextField fx:id="cboxLanguage" prefWidth="150.0" GridPane.columnIndex="5" GridPane.rowIndex="1" />
               </children>
            </GridPane>
            </children>
        </VBox>
    </children>
</StackPane>
