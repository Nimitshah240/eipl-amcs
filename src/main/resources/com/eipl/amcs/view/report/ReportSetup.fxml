<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>

<AnchorPane fx:id="root" prefHeight="700.0" prefWidth="500.0" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.eipl.amcs.reportengine.controller.ReportSetupController">
   <children>
      <TableView fx:id="tblData" editable="true" layoutX="23.0" layoutY="27.0" prefHeight="700.0" prefWidth="500.0" AnchorPane.bottomAnchor="50.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
        <columns>
          <TableColumn fx:id="colVisible" prefWidth="75.0" text="#"/>
          <TableColumn fx:id="colTitle" prefWidth="300.0" text="Title" />
            <TableColumn fx:id="colSequence" prefWidth="75.0" text="Sequence"/>
        </columns>
      </TableView>
      <HBox layoutX="70.0" layoutY="654.0" spacing="10.0" AnchorPane.bottomAnchor="10.0" AnchorPane.rightAnchor="10.0">
         <children>
            <Button fx:id="btnSave" minWidth="75.0" mnemonicParsing="false" text="Save" />
            <Button fx:id="btnClose" minWidth="75.0" mnemonicParsing="false" text="Close" />
         </children>
      </HBox>
   </children>
   <padding>
      <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
   </padding>
</AnchorPane>
