<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.RadioButton?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.ToggleGroup?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.RowConstraints?>

<AnchorPane fx:id="root" prefHeight="600.0" prefWidth="800.0" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.eipl.amcs.reportengine.controller.ReportSetupController">
    <children>
        <TableView fx:id="tblData" editable="true" layoutX="23.0" layoutY="27.0" prefHeight="700.0" prefWidth="500.0" AnchorPane.bottomAnchor="50.0" AnchorPane.leftAnchor="200.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
            <columns>
                <TableColumn fx:id="colVisible" prefWidth="50.0" text="#" />
                <TableColumn fx:id="colTitle" prefWidth="250.0" text="Title" />
                <TableColumn fx:id="colWidth" prefWidth="75.0" text="Width" />
                <TableColumn fx:id="colAlignment" prefWidth="100.0" text="Alignment" />
                <TableColumn fx:id="colSequence" prefWidth="75.0" text="Sequence" />
            </columns>
        </TableView>
        <HBox layoutX="70.0" layoutY="654.0" spacing="10.0" AnchorPane.bottomAnchor="10.0" AnchorPane.rightAnchor="10.0">
            <children>
                <Button fx:id="btnSave" minWidth="75.0" mnemonicParsing="false" text="Save" />
                <Button fx:id="btnClose" minWidth="75.0" mnemonicParsing="false" text="Close" />
            </children>
        </HBox>
        <Label layoutX="14.0" layoutY="14.0" text="Report Layout" AnchorPane.leftAnchor="0.0" AnchorPane.topAnchor="0.0" />
        <RadioButton fx:id="rbtnPortrait" layoutX="10.0" layoutY="40.0" mnemonicParsing="false" selected="true" text="Portrait" AnchorPane.leftAnchor="0.0">
            <toggleGroup>
                <ToggleGroup fx:id="rptLayout" />
            </toggleGroup>
        </RadioButton>
        <RadioButton fx:id="rbtnLandscape" layoutX="10.0" layoutY="76.0" mnemonicParsing="false" text="Landscape" toggleGroup="$rptLayout" AnchorPane.leftAnchor="0.0" />
      <Label layoutX="14.0" layoutY="116.0" text="Page Size" AnchorPane.leftAnchor="0.0" AnchorPane.topAnchor="110.0" />
      <GridPane layoutX="14.0" layoutY="146.0" AnchorPane.leftAnchor="0.0" AnchorPane.topAnchor="135.0">
        <columnConstraints>
          <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="75.0" />
          <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0" />
        </columnConstraints>
        <rowConstraints>
          <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
          <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
        </rowConstraints>
         <children>
            <Label text="Width" />
            <Label text="Height" GridPane.rowIndex="1" />
            <Label fx:id="lblWidth" text="0" GridPane.columnIndex="1" />
            <Label fx:id="lblHeight" text="0" GridPane.columnIndex="1" GridPane.rowIndex="1" />
         </children>
      </GridPane>
    </children>
    <padding>
        <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
    </padding>
</AnchorPane>
