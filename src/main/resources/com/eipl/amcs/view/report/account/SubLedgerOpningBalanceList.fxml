<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<AnchorPane fx:id="root" prefHeight="600.0" prefWidth="800.0" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.eipl.amcs.master.account.controller.SubLedgerOpeningBalanceViewController">
	<padding>
		<Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
	</padding>
	<children>
		<VBox fx:id="vbox" prefHeight="600.0" prefWidth="600.0" spacing="15.0" styleClass="" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
			<children>
				<TableView fx:id="tableSubLedger" focusTraversable="false" maxHeight="1.7976931348623157E308" prefHeight="600.0" prefWidth="600.0" VBox.vgrow="ALWAYS">
					<columns>
						<TableColumn fx:id="colSubLedgerCode" minWidth="0.0" prefWidth="130.0" text="%code" />
						<TableColumn fx:id="colName" minWidth="0.0" prefWidth="225.0" text="%name" />
						<TableColumn fx:id="colCreditDebit" minWidth="0.0" prefWidth="225.0" text="%type" />
						<TableColumn fx:id="colBalance" minWidth="0.0" prefWidth="225.0" text="%balance" />
					</columns>
				</TableView>
				<AnchorPane>
					<children>
						<HBox layoutY="10.0" spacing="10.0" AnchorPane.bottomAnchor="10.0" AnchorPane.rightAnchor="10.0" AnchorPane.topAnchor="10.0">
							<children>
								<Label styleClass="label-bold" text="%total" AnchorPane.bottomAnchor="10.0" AnchorPane.rightAnchor="746.0" AnchorPane.topAnchor="10.0" />
								<Label fx:id="lblTotalBalance" styleClass="label-bold" text="0" AnchorPane.bottomAnchor="10.0" AnchorPane.topAnchor="10.0" />
							</children>
						</HBox>

						<Button fx:id="btnClose" layoutX="14.0" layoutY="6.0" prefHeight="30.0" prefWidth="80.0" text="%close" />
					</children>
				</AnchorPane>
			</children>
         <padding>
            <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
         </padding>
		</VBox>
	</children>
</AnchorPane>
