<?xml version="1.0" encoding="UTF-8"?>

<?import com.eipl.amcs.controls.E_Button?>
<?import com.eipl.amcs.controls.E_DatePicker?>
<?import com.eipl.amcs.controls.AutoSearchTextField?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.RadioButton?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.RowConstraints?>
<?import javafx.scene.layout.VBox?>

<!--<?import com.eipl.amcs.controls.ComboBox?>-->

<AnchorPane fx:id="root" prefHeight="600.0" prefWidth="800.0" xmlns="http://javafx.com/javafx/25"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.eipl.amcs.report.accounting.RptStockValuationController">
    <padding>
        <Insets bottom="10.0" left="10.0" right="10.0" top="10.0"/>
    </padding>
    <children>
        <VBox prefHeight="600.0" prefWidth="800.0" spacing="15.0" styleClass="pane-border" AnchorPane.bottomAnchor="0.0"
              AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
            <children>
                <HBox spacing="10.0">
                    <children>
                        <Label maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308"
                               styleClass="header-text" text="%stockvaluation" HBox.hgrow="ALWAYS"/>
                        <Label maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308"
                               HBox.hgrow="ALWAYS"/>
                        <E_DatePicker fx:id="dpStockValuation" maxHeight="1.7976931348623157E308"
                                      maxWidth="1.7976931348623157E308">
                            <HBox.margin>
                                <Insets/>
                            </HBox.margin>
                        </E_DatePicker>
                        <E_Button fx:id="btnGenerate1" graphicTextGap="5.0" minHeight="36.0" minWidth="100.0"
                                  text="%generate">
                            <graphic>
                                <ImageView fitHeight="20.0" fitWidth="20.0" pickOnBounds="true" preserveRatio="true">
                                    <image>
                                        <Image url="@../../images/plus.png"/>
                                    </image>
                                </ImageView>
                            </graphic>
                            <padding>
                                <Insets right="1.0"/>
                            </padding>
                        </E_Button>
                    </children>
                </HBox>
                <Separator prefWidth="200.0"/>
                <GridPane hgap="10.0" vgap="10.0">
                    <columnConstraints>
                        <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0"/>
                        <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0"/>
                        <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0"/>
                        <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0"/>
                        <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0"/>
                        <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0"/>
                        <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0"/>
                    </columnConstraints>
                    <rowConstraints>
                        <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES"/>
                        <RowConstraints vgrow="SOMETIMES"/>
                    </rowConstraints>
                    <children>
                        <E_DatePicker fx:id="dpFromDate1" maxHeight="1.7976931348623157E308"
                                      maxWidth="1.7976931348623157E308" GridPane.rowIndex="1"/>
                        <E_DatePicker fx:id="dpToDate1" maxHeight="1.7976931348623157E308"
                                      maxWidth="1.7976931348623157E308" GridPane.columnIndex="1" GridPane.rowIndex="1"/>
                        <AutoSearchTextField fx:id="cboxLanguage1" maxHeight="1.7976931348623157E308"
                                             maxWidth="1.7976931348623157E308" GridPane.columnIndex="2"
                                             GridPane.rowIndex="1"/>
                        <RadioButton fx:id="rbtVertical" text="Vertical" GridPane.columnIndex="3"/>
                        <RadioButton fx:id="rbtHorizontal" text="Horizontal" GridPane.columnIndex="3"
                                     GridPane.rowIndex="1"/>
                        <Label maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308" text="%fromdate"/>
                        <Label maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308" text="%todate"
                               GridPane.columnIndex="1"/>
                        <Label maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308" text="%language"
                               GridPane.columnIndex="2"/>
                        <HBox alignment="CENTER_RIGHT" spacing="15.0" GridPane.columnIndex="4" GridPane.columnSpan="3"
                              GridPane.rowIndex="1">
                            <children>
                                <E_Button fx:id="btnRojmed" minHeight="35.0" minWidth="100.0" mnemonicParsing="true"
                                          text="%rojmed">
                                    <graphic>
                                        <ImageView fitHeight="20.0" fitWidth="20.0" pickOnBounds="true"
                                                   preserveRatio="true">
                                            <image>
                                                <Image url="@../../images/generate.png"/>
                                            </image>
                                        </ImageView>
                                    </graphic>
                                </E_Button>
                                <E_Button fx:id="btnTrialBalance" minHeight="35.0" minWidth="100.0"
                                          mnemonicParsing="true" text="%trialbalance">
                                    <graphic>
                                        <ImageView fitHeight="20.0" fitWidth="20.0" pickOnBounds="true"
                                                   preserveRatio="true">
                                            <image>
                                                <Image url="@../../images/generate.png"/>
                                            </image>
                                        </ImageView>
                                    </graphic>
                                </E_Button>
                                <E_Button fx:id="btnTredingReport" minHeight="35.0" minWidth="100.0"
                                          mnemonicParsing="true" text="%tredingreport">
                                    <graphic>
                                        <ImageView fitHeight="20.0" fitWidth="20.0" pickOnBounds="true"
                                                   preserveRatio="true">
                                            <image>
                                                <Image url="@../../images/generate.png"/>
                                            </image>
                                        </ImageView>
                                    </graphic>
                                </E_Button>
                                <E_Button fx:id="btnProfitLoss" minHeight="35.0" minWidth="100.0" mnemonicParsing="true"
                                          text="%profitloss">
                                    <graphic>
                                        <ImageView fitHeight="20.0" fitWidth="20.0" pickOnBounds="true"
                                                   preserveRatio="true">
                                            <image>
                                                <Image url="@../../images/generate.png"/>
                                            </image>
                                        </ImageView>
                                    </graphic>
                                </E_Button>
                                <E_Button fx:id="btnBalanceSheet" minHeight="35.0" minWidth="100.0"
                                          mnemonicParsing="true" text="%balancesheet">
                                    <graphic>
                                        <ImageView fitHeight="20.0" fitWidth="20.0" pickOnBounds="true"
                                                   preserveRatio="true">
                                            <image>
                                                <Image url="@../../images/generate.png"/>
                                            </image>
                                        </ImageView>
                                    </graphic>
                                </E_Button>
                                <E_Button fx:id="btnBalanceSheetGrouping" minHeight="35.0" minWidth="100.0"
                                          mnemonicParsing="true" text="%balancesheetgrouping">
                                    <graphic>
                                        <ImageView fitHeight="20.0" fitWidth="20.0" pickOnBounds="true"
                                                   preserveRatio="true">
                                            <image>
                                                <Image url="@../../images/generate.png"/>
                                            </image>
                                        </ImageView>
                                    </graphic>
                                </E_Button>
                            </children>
                        </HBox>
                    </children>
                </GridPane>
                <Separator prefWidth="200.0"/>
                <Label maxWidth="1.7976931348623157E308" minHeight="35.0" styleClass="header-text"
                       text="%stockvaluation"/>
                <GridPane focusTraversable="true" hgap="10.0">
                    <columnConstraints>
                        <ColumnConstraints hgrow="NEVER" maxWidth="1.7976931348623157E308"/>
                        <ColumnConstraints hgrow="NEVER"/>
                        <ColumnConstraints hgrow="NEVER" maxWidth="1.7976931348623157E308"/>
                        <ColumnConstraints hgrow="NEVER" maxWidth="1.7976931348623157E308"/>
                        <ColumnConstraints hgrow="NEVER" maxWidth="1.7976931348623157E308" minWidth="10.0"
                                           prefWidth="100.0"/>
                        <ColumnConstraints hgrow="NEVER" maxWidth="1.7976931348623157E308"/>
                        <ColumnConstraints hgrow="NEVER" maxWidth="1.7976931348623157E308"/>
                    </columnConstraints>
                    <rowConstraints>
                        <RowConstraints minHeight="10.0" prefHeight="20.0" vgrow="SOMETIMES"/>
                        <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES"/>
                    </rowConstraints>
                    <children>
                        <E_DatePicker fx:id="dpAsOnDate" GridPane.columnIndex="2" GridPane.rowIndex="1"/>
                        <Label fx:id="lblAsOnDate" text="%asondate" GridPane.columnIndex="2"/>
                        <AutoSearchTextField fx:id="cboxFormat" editable="true" GridPane.rowIndex="1"/>
                        <AutoSearchTextField fx:id="cboxProduct" editable="true" GridPane.columnIndex="1"
                                             GridPane.rowIndex="1"/>
                        <E_DatePicker fx:id="dpFromDate" GridPane.columnIndex="2" GridPane.rowIndex="1"/>
                        <E_DatePicker fx:id="dpToDate" disable="true" GridPane.columnIndex="3" GridPane.rowIndex="1"/>
                        <AutoSearchTextField fx:id="cboxLanguage" prefWidth="150.0" GridPane.columnIndex="4"
                                             GridPane.rowIndex="1"/>
                        <Label disable="true" text="%todate" GridPane.columnIndex="3"/>
                        <Label text="%format"/>
                        <Label disable="true" text="%product" GridPane.columnIndex="1"/>
                        <E_Button fx:id="btnGenerate" minHeight="35.0" minWidth="100.0" mnemonicParsing="true"
                                  text="%generate" GridPane.columnIndex="5" GridPane.rowIndex="1">
                            <graphic>
                                <ImageView fitHeight="20.0" fitWidth="20.0" pickOnBounds="true" preserveRatio="true">
                                    <image>
                                        <Image url="@../../images/generate.png"/>
                                    </image>
                                </ImageView>
                            </graphic>
                        </E_Button>
                        <E_Button fx:id="btnClose" minHeight="35.0" minWidth="100.0" mnemonicParsing="true"
                                  text="%close" GridPane.columnIndex="6" GridPane.rowIndex="1">
                            <graphic>
                                <ImageView fitHeight="20.0" fitWidth="20.0" pickOnBounds="true" preserveRatio="true">
                                    <image>
                                        <Image url="@../../images/close.png"/>
                                    </image>
                                </ImageView>
                            </graphic>
                        </E_Button>
                        <Label text="Label" GridPane.columnIndex="4"/>

                    </children>
                    <VBox.margin>
                        <Insets left="10.0"/>
                    </VBox.margin>
                </GridPane>
            </children>
        </VBox>
    </children>
</AnchorPane>
