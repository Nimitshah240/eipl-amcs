<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<?import javafx.scene.image.ImageView?>
<?import javafx.scene.image.Image?>
<?import com.eipl.amcs.controls.AutoSearchTextField?>
<?import com.eipl.amcs.controls.E_DatePicker?>
<StackPane fx:id="root" prefHeight="400.0" prefWidth="600.0" styleClass="pane-center" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.eipl.amcs.report.controller.MemberBillingController">
    <children>
        <VBox prefHeight="400.0" prefWidth="622.0" spacing="15.0">
            <children>
                <Label styleClass="header-text" text="%memberbilling" />
                <GridPane hgap="8.0">
                    <columnConstraints>
                        <ColumnConstraints hgrow="SOMETIMES" percentWidth="20.0" />
                        <ColumnConstraints hgrow="SOMETIMES" percentWidth="20.0" />
                        <ColumnConstraints hgrow="SOMETIMES" percentWidth="20.0" />
                        <ColumnConstraints hgrow="SOMETIMES" />
                  <ColumnConstraints hgrow="NEVER" minWidth="100.0" prefWidth="100.0" />
                        <ColumnConstraints halignment="RIGHT" hgrow="SOMETIMES" percentWidth="20.0" />
                    </columnConstraints>
                    <rowConstraints>
                        <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
                        <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
                    </rowConstraints>
                    <children>

                        <Label text="%membercode" />
                        <AutoSearchTextField fx:id="cboxMemberCode" editable="true" maxWidth="1.7976931348623157E308" GridPane.rowIndex="1" />
                        <Label text="%type" GridPane.columnIndex="3" />
                        <AutoSearchTextField fx:id="cboxType" editable="true" maxWidth="1.7976931348623157E308" GridPane.columnIndex="3" GridPane.rowIndex="1" />
                        <Label text="%fromdate" GridPane.columnIndex="1" />
                        <E_DatePicker fx:id="dpFromDate" maxWidth="1.7976931348623157E308" GridPane.columnIndex="1" GridPane.hgrow="ALWAYS" GridPane.rowIndex="1" GridPane.vgrow="ALWAYS" />
                        <Label text="%todate" GridPane.columnIndex="2" />
                        <E_DatePicker fx:id="dpToDate" maxHeight="-Infinity" maxWidth="1.7976931348623157E308" GridPane.columnIndex="2" GridPane.hgrow="ALWAYS" GridPane.rowIndex="1" GridPane.vgrow="ALWAYS" />
                        <Button fx:id="btnGenerate" minHeight="35.0" minWidth="100.0" mnemonicParsing="true"
                                text="%generate" GridPane.columnIndex="5" GridPane.rowIndex="1">
                            <graphic>
                                <ImageView fitHeight="20.0" fitWidth="20.0" pickOnBounds="true"
                                           preserveRatio="true">
                                    <image>
                                        <Image url="@../images/generate.png"/>
                                    </image>
                                </ImageView>
                            </graphic>
                        </Button>
                  <Label text="%language" GridPane.columnIndex="4" />
                  <AutoSearchTextField fx:id="cboxLanguage" prefHeight="25.0" prefWidth="98.0" GridPane.columnIndex="4" GridPane.rowIndex="1" />


                    </children>
                </GridPane>
            <Separator prefWidth="200.0" />
            <Label styleClass="header-text" text="%summary" />
            <GridPane fx:id="cboxSummary" hgap="8.0">
               <columnConstraints>
                  <ColumnConstraints hgrow="SOMETIMES" percentWidth="20.0" />
                  <ColumnConstraints hgrow="SOMETIMES" percentWidth="20.0" />
                  <ColumnConstraints hgrow="SOMETIMES" />
                  <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" percentWidth="20.0" prefWidth="100.0" />
                  <ColumnConstraints hgrow="SOMETIMES" percentWidth="20.0" />
                  <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" percentWidth="20.0" prefWidth="100.0" />
                  <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" percentWidth="20.0" prefWidth="100.0" />
                  <ColumnConstraints halignment="RIGHT" hgrow="SOMETIMES" percentWidth="20.0" />
               </columnConstraints>
               <rowConstraints>
                  <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
                  <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
               </rowConstraints>
               <children>
                  <Label text="%membercode" />
                  <AutoSearchTextField fx:id="cboxMemberCodeSummary" disable="true" editable="true" maxWidth="1.7976931348623157E308" GridPane.rowIndex="1" />
                  <Label text="%fromdate" GridPane.columnIndex="1" />
                  <E_DatePicker fx:id="dpFromDateSummary" maxWidth="1.7976931348623157E308" GridPane.columnIndex="1" GridPane.hgrow="ALWAYS" GridPane.rowIndex="1" GridPane.vgrow="ALWAYS" />
                  <Label text="%todate" GridPane.columnIndex="4" />
                  <E_DatePicker fx:id="dpToDateSummary" maxHeight="-Infinity" maxWidth="1.7976931348623157E308" GridPane.columnIndex="4" GridPane.hgrow="ALWAYS" GridPane.rowIndex="1" GridPane.vgrow="ALWAYS" />
                   <Button fx:id="btnSummary" minHeight="35.0" minWidth="100.0" mnemonicParsing="true"
                           text="%generate" GridPane.columnIndex="7" GridPane.rowIndex="1">
                       <graphic>
                           <ImageView fitHeight="20.0" fitWidth="20.0" pickOnBounds="true"
                                      preserveRatio="true">
                               <image>
                                   <Image url="@../images/generate.png"/>
                               </image>
                           </ImageView>
                       </graphic>
                   </Button>
                  <AutoSearchTextField fx:id="cboxShiftFrom" editable="true" maxWidth="1.7976931348623157E308" GridPane.columnIndex="3" GridPane.rowIndex="1" />
                  <AutoSearchTextField fx:id="cboxShiftTo" editable="true" maxWidth="1.7976931348623157E308" GridPane.columnIndex="5" GridPane.rowIndex="1" />
                  <Label text="%fromshift" GridPane.columnIndex="3" />
                  <Label text="%toshift" GridPane.columnIndex="5" />
                  <AutoSearchTextField fx:id="cboxLanguage1" prefWidth="150.0" GridPane.columnIndex="6" GridPane.rowIndex="1" />
                  <Label text="%language" GridPane.columnIndex="6" />
               </children>
            </GridPane>
            </children>
        </VBox>
    </children>
</StackPane>
