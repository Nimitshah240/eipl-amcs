<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<StackPane fx:id="root" prefHeight="400.0" prefWidth="600.0" styleClass="pane-center" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.eipl.amcs.report.controller.MemberWiseHeadPivotingController">
    <children>
        <VBox prefHeight="400.0" prefWidth="622.0" spacing="15.0">
            <children>
                <Label styleClass="header-text" text="%memberwiseheadpivoting" />
                <GridPane hgap="8.0">
                    <columnConstraints>
                        <ColumnConstraints hgrow="SOMETIMES" percentWidth="30.0" />
                        <ColumnConstraints hgrow="SOMETIMES" percentWidth="30.0" />
                  <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" percentWidth="30.0" prefWidth="100.0" />
                        <ColumnConstraints halignment="RIGHT" hgrow="SOMETIMES" percentWidth="40.0" />
                    </columnConstraints>
                    <rowConstraints>
                        <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
                        <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
                    </rowConstraints>
                    <children>

                        <Label text="%member" />
                        <ComboBox fx:id="cboxMemberCode" editable="true" maxWidth="1.7976931348623157E308" GridPane.rowIndex="1" />
                        <Button fx:id="btnGenerate" mnemonicParsing="true" styleClass="button-primary" text="%generate" GridPane.columnIndex="3" GridPane.rowIndex="1" />
                  <Label text="%societypaymentcycle" GridPane.columnIndex="1" />
                  <ComboBox fx:id="cboxSocietyPaymentCycleCode" editable="true" maxWidth="1.7976931348623157E308" prefHeight="25.0" prefWidth="127.0" GridPane.columnIndex="1" GridPane.rowIndex="1" />
                  <Label text="%language" GridPane.columnIndex="2" />
                  <ComboBox fx:id="cboxLanguage" prefWidth="150.0" GridPane.columnIndex="2" GridPane.rowIndex="1" />


                    </children>
                </GridPane>
            </children>
        </VBox>
    </children>
</StackPane>
