<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane fx:id="root" prefHeight="400.0" prefWidth="600.0" styleClass="pane-center" xmlns="http://javafx.com/javafx/18" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.eipl.amcs.operation.share.controller.ShareTransferController">
    <children>
        <VBox spacing="15.0">
            <children>
                <HBox spacing="5.0">
                    <children>
                        <Label styleClass="header-text" text="%listofsharetransfer" HBox.hgrow="ALWAYS">
                            <HBox.margin>
                                <Insets />
                            </HBox.margin>
                        </Label>
                    </children>
                </HBox>
                <TableView fx:id="tableShareTransfer" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="colVoucherNo" prefWidth="80.0" styleClass="cell-center-aligned" text="%voucherno" />
                        <TableColumn fx:id="colDate" prefWidth="90.0" styleClass="cell-center-aligned" text="%date" />
                        <TableColumn fx:id="colNoOfShare" prefWidth="110.0" text="%noofshare" />
                        <TableColumn fx:id="colAmount" prefWidth="100.0" styleClass="cell-right-aligned" text="%amount" />
                  <TableColumn fx:id="colOldMemberCode" prefWidth="125.0" text="%oldmembercode" />
                        <TableColumn fx:id="colOldMemberName" prefWidth="125.0" text="%oldmembername" />
                  <TableColumn fx:id="colNewMemberCode" prefWidth="125.0" text="%newmembercode" />
                  <TableColumn fx:id="colNewMemberName" prefWidth="125.0" text="%newmembername" />
                    </columns>
               <columnResizePolicy>
                  <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
               </columnResizePolicy>
                </TableView>
                <HBox spacing="15">
                    <children>
                        <Button fx:id="btnAdd" prefHeight="30.0" prefWidth="80.0" styleClass="button-primary" text="%add" />
                        <Button fx:id="btnClose" layoutX="200.0" layoutY="10.0" prefHeight="30.0" prefWidth="80.0" text="%close" />
                  <Label maxWidth="1.7976931348623157E308" HBox.hgrow="ALWAYS" />
                  <Button fx:id="btnRevert" disable="true" prefHeight="30.0" prefWidth="80.0" text="%revert" />
                  <Button fx:id="btnReport" prefHeight="30.0" prefWidth="80.0" text="%report" />
                    </children>
                </HBox>
            </children>
        </VBox>
    </children>
</StackPane>
