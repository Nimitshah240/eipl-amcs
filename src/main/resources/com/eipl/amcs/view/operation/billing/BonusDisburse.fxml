<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane fx:id="root" prefHeight="400.0" prefWidth="700.0" styleClass="pane-center" xmlns="http://javafx.com/javafx/11" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.eipl.amcs.operation.billing.controller.BonusDisburseController">
    <children>
        <VBox spacing="15.0">
            <children>
                <Label styleClass="header-text" text="%bonus.disburse" />
            <VBox spacing="5.0">
               <children>
                      <HBox alignment="CENTER_LEFT" spacing="10.0">
                          <children>
                              <CheckBox fx:id="chkSelectAll" mnemonicParsing="false" text="%selectall" />
                              <Label maxWidth="1.7976931348623157E308" HBox.hgrow="ALWAYS" />
                              <DatePicker fx:id="dpDisburseDate" prefWidth="125.0" />
                              <Button fx:id="btnDisburse" mnemonicParsing="false" text="%disburse" />
                          </children>
                      </HBox>
               </children>
            </VBox>
                <TableView fx:id="tableBonusDisburse" prefHeight="350.0" prefWidth="600.0" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="colSelect" editable="false" prefWidth="50.0" text="#" />
                        <TableColumn fx:id="colMemberCode" prefWidth="80.0" styleClass="cell-center-aligned" text="%code" />
                        <TableColumn fx:id="colMemberName" prefWidth="120.0" text="%name" />
                        <TableColumn fx:id="colMilkQty" prefWidth="120.0" styleClass="cell-right-aligned" text="%milkqty" />
                        <TableColumn fx:id="colMilkAmount" prefWidth="120.0" styleClass="cell-right-aligned" text="%milkamt" />
                        <TableColumn fx:id="colBonusAmt" prefWidth="120.0" styleClass="cell-right-aligned" text="%bonusamt" />
                  <TableColumn fx:id="colType" prefWidth="75.0" text="%type" />
                        <TableColumn fx:id="colStatus" prefWidth="100.0" styleClass="cell-center-aligned" text="%status" />
                    </columns>
                </TableView>
                <HBox prefWidth="200.0" spacing="15.0">
                    <children>
                        <Button fx:id="btnExport" mnemonicParsing="true" prefHeight="30.0" prefWidth="80.0" text="%export" />
                        <Button fx:id="btnClose" mnemonicParsing="true" prefHeight="30.0" prefWidth="80.0" text="%close" />
                    </children>
                </HBox>
            </children>
        </VBox>
    </children>
</StackPane>
