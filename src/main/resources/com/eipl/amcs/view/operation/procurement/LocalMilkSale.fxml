<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.RowConstraints?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>

<StackPane fx:id="root" prefHeight="400.0" prefWidth="600.0" styleClass="pane-center"
           xmlns="http://javafx.com/javafx/18" xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="com.eipl.amcs.operation.procurement.controller.LocalMilkSaleController">
    <children>
        <VBox prefHeight="200.0" prefWidth="100.0" spacing="15.0">
            <children>
                <HBox prefHeight="51.0" prefWidth="600.0" spacing="5.0">
                    <children>
                        <Label styleClass="header-text" text="%localmilksale" HBox.hgrow="ALWAYS">
                            <HBox.margin>
                                <Insets/>
                            </HBox.margin>
                        </Label>
                        <Label contentDisplay="RIGHT" prefHeight="31.0" prefWidth="176.0" text=" "/>
                        <HBox alignment="TOP_RIGHT" nodeOrientation="LEFT_TO_RIGHT" HBox.hgrow="ALWAYS">
                            <children>
                                <GridPane alignment="TOP_RIGHT" hgap="10.0" prefHeight="40.0" prefWidth="600.0"
                                          vgap="5.0">
                                    <columnConstraints>
                                        <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" percentWidth="23.0"
                                                           prefWidth="100.0"/>
                                        <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" percentWidth="20.0"
                                                           prefWidth="100.0"/>
                                        <ColumnConstraints hgrow="SOMETIMES" maxWidth="106.0" minWidth="10.0"
                                                           percentWidth="23.0" prefWidth="102.0"/>
                                        <ColumnConstraints hgrow="SOMETIMES" maxWidth="117.0" minWidth="10.0"
                                                           percentWidth="23.0" prefWidth="106.0"/>
                                        <ColumnConstraints halignment="RIGHT" hgrow="SOMETIMES" maxWidth="88.0"
                                                           minWidth="10.0" percentWidth="13.0" prefWidth="69.0"/>
                                    </columnConstraints>
                                    <rowConstraints>
                                        <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES"/>
                                        <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES"/>
                                    </rowConstraints>
                                    <children>
                                        <Label text="%fromdate" GridPane.columnIndex="2"/>
                                        <DatePicker fx:id="dpFromDate" GridPane.columnIndex="2" GridPane.rowIndex="1"/>
                                        <Label text="%todate" GridPane.columnIndex="3"/>
                                        <DatePicker fx:id="dpToDate" GridPane.columnIndex="3" GridPane.rowIndex="1"/>
                                        <Button fx:id="btnSearch" alignment="CENTER" contentDisplay="RIGHT"
                                                graphicTextGap="0.0" maxWidth="1.7976931348623157E308"
                                                mnemonicParsing="false" text="%search" GridPane.columnIndex="4"
                                                GridPane.rowIndex="1"/>
                                    </children>
                                </GridPane>
                            </children>
                        </HBox>
                    </children>
                </HBox>
                <TableView fx:id="tableLocalMilkSale" prefHeight="317.0" prefWidth="600.0" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="colDate" prefWidth="80.0" styleClass="cell-center-aligned" text="%date"/>
                        <TableColumn fx:id="colShift" prefWidth="80.0" styleClass="cell-center-aligned" text="%shift"/>
                        <TableColumn fx:id="colConsumerType" prefWidth="130.0" text="%consumertype"/>
                        <TableColumn fx:id="colConsumerCode" prefWidth="75.0" styleClass="cell-center-aligned"
                                     text="%code"/>
                        <TableColumn fx:id="colConsumerName" prefWidth="135.0" text="%consumername"/>
                        <TableColumn fx:id="colMilkType" prefWidth="90.0" styleClass="cell-center-aligned"
                                     text="%milktype"/>
                        <TableColumn fx:id="colClass" prefWidth="75.0" styleClass="cell-center-aligned" text="%class"/>
                        <TableColumn fx:id="colQuantity" prefWidth="75.0" styleClass="cell-right-aligned"
                                     text="%quantity"/>
                        <TableColumn fx:id="colRate" prefWidth="75.0" styleClass="cell-right-aligned" text="%rate"/>
                        <TableColumn fx:id="colAmount" prefWidth="100.0" styleClass="cell-right-aligned"
                                     text="%amount"/>
                        <!--                        <TableColumn fx:id="colCouponBalance" prefWidth="100.0" styleClass="cell-right-aligned" text="%couponbalance" />-->
                    </columns>
                </TableView>
                <HBox prefWidth="200.0" spacing="15">
                    <children>
                        <Button fx:id="btnAdd" contentDisplay="TOP" graphicTextGap="5.0" prefHeight="50.0"
                                prefWidth="70.0" text="%add">
                            <graphic>
                                <ImageView fitHeight="40.0" fitWidth="40.0" pickOnBounds="true" preserveRatio="true">
                                    <image>
                                        <Image url="@../../images/add.png"/>
                                    </image>
                                </ImageView>
                            </graphic>
                        </Button>
                        <Button fx:id="btnEdit" contentDisplay="TOP" disable="true" graphicTextGap="5.0"
                                mnemonicParsing="true" prefHeight="50.0" prefWidth="70.0" text="%edit">
                            <graphic>
                                <ImageView fitHeight="40.0" fitWidth="40.0" pickOnBounds="true" preserveRatio="true">
                                    <image>
                                        <Image url="@../../images/edit.png"/>
                                    </image>
                                </ImageView>
                            </graphic>
                        </Button>
                        <Button fx:id="btnDelete" contentDisplay="TOP" disable="true" graphicTextGap="5.0"
                                mnemonicParsing="true" prefHeight="50.0" prefWidth="70.0" text="%delete">
                            <graphic>
                                <ImageView fitHeight="40.0" fitWidth="40.0" pickOnBounds="true" preserveRatio="true">
                                    <image>
                                        <Image url="@../../images/delete.png"/>
                                    </image>
                                </ImageView>
                            </graphic>
                        </Button>
                        <Button fx:id="btnClose" contentDisplay="TOP" graphicTextGap="5.0" prefHeight="50.0"
                                prefWidth="70.0" text="%close">
                            <graphic>
                                <ImageView fitHeight="40.0" fitWidth="40.0" pickOnBounds="true" preserveRatio="true">
                                    <image>
                                        <Image url="@../../images/close.png"/>
                                    </image>
                                </ImageView>
                            </graphic>
                        </Button>
                    </children>
                </HBox>
            </children>
        </VBox>
    </children>
</StackPane>
