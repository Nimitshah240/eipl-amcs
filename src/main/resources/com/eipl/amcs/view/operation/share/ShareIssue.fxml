<?xml version="1.0" encoding="UTF-8"?>

<?import com.eipl.amcs.controls.E_Button?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<?import com.eipl.amcs.controls.E_Label?>
<StackPane fx:id="root" prefHeight="400.0" prefWidth="600.0" styleClass="pane-center" xmlns="http://javafx.com/javafx/18" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.eipl.amcs.operation.share.controller.ShareIssueController">
    <children>
        <VBox spacing="15.0">
            <children>
                <HBox spacing="5.0">
                    <children>
                        <E_Label styleClass="header-text" text="%listofshareissue" HBox.hgrow="ALWAYS">
                            <HBox.margin>
                                <Insets />
                            </HBox.margin>
                        </E_Label>
                    </children>
                </HBox>
                <TableView fx:id="tableShareIssue" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="colVoucherNo" prefWidth="80.0" styleClass="cell-center-aligned" text="%voucherno" />
                        <TableColumn fx:id="colDate" prefWidth="80.0" styleClass="cell-center-aligned" text="%date" />
                        <TableColumn fx:id="colNoOfShare" prefWidth="75.0" text="%noofshare" />
                        <TableColumn fx:id="colMemberCode" prefWidth="75.0" styleClass="cell-center-aligned" text="%code" />
                        <TableColumn fx:id="colMemberName" prefWidth="200.0" text="%membername" />
                        <TableColumn fx:id="colAmount" prefWidth="100.0" styleClass="cell-right-aligned" text="%amount" />
                    </columns>
               <columnResizePolicy>
                  <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
               </columnResizePolicy>
                </TableView>
                <HBox spacing="15">
                    <children>
                        <E_Button fx:id="btnAdd" prefHeight="30.0" prefWidth="80.0" styleClass="button-primary" text="%add" />
                        <E_Button fx:id="btnCancel" disable="true" prefHeight="30.0" prefWidth="80.0" text="%cancel" />
                        <E_Button fx:id="btnClose" layoutX="200.0" layoutY="10.0" prefHeight="30.0" prefWidth="80.0" text="%close" />
                  <E_Label maxWidth="1.7976931348623157E308" HBox.hgrow="ALWAYS" />
                  <E_Button fx:id="btnDelete"  disable="true" prefHeight="30.0" prefWidth="80.0" text="%delete" />
                  <E_Button fx:id="btnReport" prefHeight="30.0" prefWidth="80.0" text="%report" />
                    </children>
                </HBox>
            </children>
        </VBox>
    </children>
</StackPane>
