<?xml version="1.0" encoding="UTF-8"?>

<?import com.eipl.amcs.controls.E_ComboBox?>
<?import com.eipl.amcs.controls.E_DatePicker?>
<?import com.eipl.amcs.controls.E_NumericField?>
<?import com.eipl.amcs.controls.E_TextField?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.RowConstraints?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane fx:id="root" prefWidth="600.0" styleClass="pane-center" xmlns="http://javafx.com/javafx/20.0.1"
           xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="com.eipl.amcs.operation.inventory.controller.DeadStockAddEditController">
    <children>
        <VBox spacing="20.0">
            <children>
                <GridPane fx:id="gridMaster" hgap="10.0" VBox.vgrow="ALWAYS">
                    <columnConstraints>
                        <ColumnConstraints hgrow="SOMETIMES" percentWidth="25.0"/>
                        <ColumnConstraints hgrow="SOMETIMES" percentWidth="25.0"/>
                        <ColumnConstraints hgrow="SOMETIMES" percentWidth="25.0"/>
                        <ColumnConstraints hgrow="SOMETIMES" percentWidth="25.0"/>
                    </columnConstraints>
                    <rowConstraints>
                        <RowConstraints minHeight="28.0" prefHeight="30.0"/>
                        <RowConstraints minHeight="28.0" prefHeight="30.0"/>
                        <RowConstraints minHeight="28.0"/>
                        <RowConstraints minHeight="20.0" vgrow="SOMETIMES"/>
                        <RowConstraints minHeight="28.0"/>
                        <RowConstraints minHeight="10.0" prefHeight="30.0"/>
                        <RowConstraints/>
                        <RowConstraints percentHeight="0.0" vgrow="SOMETIMES"/>
                    </rowConstraints>
                    <children>
                        <E_DatePicker fx:id="dpPurchaseDate" maxWidth="1.7976931348623157E308" GridPane.columnIndex="1"
                                      GridPane.rowIndex="1"/>
                        <E_TextField fx:id="txtName" maxWidth="1.7976931348623157E308" GridPane.columnIndex="2"
                                     GridPane.columnSpan="2" GridPane.rowIndex="1"/>
                        <E_NumericField fx:id="txtQuantity" maxWidth="1.7976931348623157E308" GridPane.rowIndex="3"/>
                        <E_NumericField fx:id="txtAmount" maxWidth="1.7976931348623157E308" GridPane.columnIndex="1"
                                        GridPane.rowIndex="3"/>

                        <Label maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308" text="%purchasedate"
                               GridPane.columnIndex="1"/>
                        <E_TextField fx:id="txtNameLocal" maxWidth="1.7976931348623157E308" GridPane.columnIndex="2"
                                     GridPane.columnSpan="2" GridPane.rowIndex="3"/>
                        <E_ComboBox fx:id="cboxLedger" editable="true" maxHeight="1.7976931348623157E308"
                                    maxWidth="1.7976931348623157E308" GridPane.columnSpan="3" GridPane.rowIndex="5"/>
                        <E_NumericField fx:id="txtCode" disable="true" editable="false"
                                        maxWidth="1.7976931348623157E308" GridPane.rowIndex="1"/>
                        <Label maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308" text="%qantity"
                               GridPane.rowIndex="2"/>
                        <Label maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308" text="%name"
                               GridPane.columnIndex="2"/>
                        <Label maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308" text="%account"
                               GridPane.rowIndex="4"/>
                        <Label maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308" text="%namelocal"
                               GridPane.columnIndex="2" GridPane.rowIndex="2"/>
                        <Label maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308" text="%amount"
                               GridPane.columnIndex="1" GridPane.rowIndex="2"/>
                        <Label maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308" text="%code"/>
                    </children>
                </GridPane>
                <HBox fx:id="hboxMaster" alignment="CENTER_LEFT" spacing="15.0">
                    <children>
                        <Button fx:id="btnSaveUpdate" contentDisplay="TOP" graphicTextGap="5.0" prefHeight="50.0"
                                prefWidth="70.0" text="%save">
                            <graphic>
                                <ImageView fitHeight="40.0" fitWidth="40.0" pickOnBounds="true" preserveRatio="true">
                                    <image>
                                        <Image url="@../../images/save.png"/>
                                    </image>
                                </ImageView>
                            </graphic>
                        </Button>
                        <Button fx:id="btnClose" contentDisplay="TOP" graphicTextGap="5.0" prefHeight="50.0"
                                prefWidth="70.0" text="%close">
                            <graphic>
                                <ImageView fitHeight="40.0" fitWidth="40.0" pickOnBounds="true" preserveRatio="true">
                                    <image>
                                        <Image url="@../../images/close.png"/>
                                    </image>
                                </ImageView>
                            </graphic>
                        </Button>
                        <Label maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308"
                               HBox.hgrow="ALWAYS"/>
                    </children>
                    <padding>
                        <Insets bottom="5.0"/>
                    </padding>
                </HBox>
            </children>
        </VBox>
    </children>
    <padding>
        <Insets bottom="15.0" left="15.0" right="15.0" top="15.0"/>
    </padding>
</StackPane>
