<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane fx:id="root" prefHeight="400.0" prefWidth="600.0" styleClass="pane-center" xmlns="http://javafx.com/javafx/11" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.eipl.amcs.operation.administartion.controller.MeetingAgendaController">
    <children>
        <VBox prefHeight="200.0" prefWidth="100.0" spacing="15.0">
            <children>
                <Label styleClass="header-text" text="%meetinglist" />
                <TableView fx:id="tableMeeting" prefHeight="350.0" prefWidth="600.0" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="colCode" prefWidth="125.0" styleClass="cell-center-aligned" text="%code" />
                        <TableColumn fx:id="colDate" prefWidth="200.0" text="%date" />
                        <TableColumn fx:id="colSubjectLine" prefWidth="200.0" text="%subline" />
                        <TableColumn fx:id="colMeetingDate" prefWidth="200.0" text="%meetingdate" />
                        <TableColumn fx:id="colMeetingTime" prefWidth="100.0" styleClass="cell-center-aligned" text="%meetingtime" />
                        <TableColumn fx:id="colMeetingType" prefWidth="100.0" styleClass="cell-center-aligned" text="%meetingtype" />
                    </columns>
               <columnResizePolicy>
                  <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
               </columnResizePolicy>
                </TableView>
                <HBox prefHeight="25.0" prefWidth="600.0" spacing="15">
                    <children>
                        <Button fx:id="btnAdd" mnemonicParsing="true" prefHeight="30.0" prefWidth="80.0" text="%add" />
                  <Button fx:id="btnEdit" disable="true" layoutX="10.0" layoutY="10.0" mnemonicParsing="true" prefHeight="30.0" prefWidth="80.0" text="%edit" />
                  <Button fx:id="btnDelete" disable="true" layoutX="105.0" layoutY="10.0" mnemonicParsing="true" prefHeight="30.0" prefWidth="80.0" text="%delete" />
                  <Button fx:id="btnClose" layoutX="200.0" layoutY="10.0" mnemonicParsing="true" prefHeight="30.0" prefWidth="80.0" text="%close" />
                  <Label maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308" text=" " HBox.hgrow="ALWAYS" />
                  <Button fx:id="btnMom" disable="true" mnemonicParsing="true" prefHeight="30.0" prefWidth="80.0" text="%mom" />
                  <Button fx:id="btnReport" disable="true" mnemonicParsing="true" prefHeight="30.0" prefWidth="80.0" text="%report" />
                    </children>
                </HBox>
            </children>
        </VBox>
    </children>
</StackPane>
