<?xml version="1.0" encoding="UTF-8"?>

<?import com.eipl.amcs.controls.E_ComboBox?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane fx:id="root" prefHeight="400.0" prefWidth="700.0" styleClass="pane-center" xmlns="http://javafx.com/javafx/20.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.eipl.amcs.operation.billing.controller.MemberBillController">
    <children>
        <VBox spacing="15.0">
            <children>
                <Label styleClass="header-text" text="%member.bill" />
            <VBox spacing="5.0">
               <children>
                      <HBox alignment="CENTER_LEFT" spacing="10.0">
                          <children>
                              <Label text="%paymentcycleid" />
                              <ComboBox fx:id="cboxPaymentCycle" editable="true" prefWidth="230.0" />
                              <Button fx:id="btnGenerate" mnemonicParsing="false" text="%generate" />
                        <Button fx:id="btnReport" mnemonicParsing="false" text="%generalreport" />
                        <Label maxWidth="1.7976931348623157E308" HBox.hgrow="ALWAYS" />
                            <HBox alignment="CENTER_LEFT" spacing="10.0">
                                <children>
                                    <DatePicker fx:id="dpDisburseDate" disable="true" prefWidth="125.0" />
                              <E_ComboBox fx:id="cboxBank" prefWidth="230.0"  />
                                    <Button fx:id="btnDisburse" mnemonicParsing="false" text="%disburse" />
                                </children>
                            </HBox>
                          </children>
                      </HBox>
               </children>
            </VBox>
                <TableView fx:id="tableBill" prefHeight="350.0" prefWidth="600.0" VBox.vgrow="ALWAYS">
                    <columns>
<!--                        <TableColumn fx:id="colSelect" prefWidth="50.0" text="#" />-->
                        <TableColumn fx:id="colMemberCode" prefWidth="80.0" styleClass="cell-center-aligned" text="%code" />
                        <TableColumn fx:id="colMemberName" prefWidth="150.0" text="%name" />
                        <TableColumn fx:id="colMilkQty" prefWidth="100.0" styleClass="cell-right-aligned" text="%milkqty" />
                        <TableColumn fx:id="colMilkAmount" prefWidth="100.0" styleClass="cell-right-aligned" text="%milkamt" />
                        <TableColumn fx:id="colProductSale" prefWidth="100.0" styleClass="cell-right-aligned" text="%productsaleamt" />
                        <TableColumn fx:id="colLocalSale" prefWidth="100.0" styleClass="cell-right-aligned" text="%localsaleamt" />
                        <TableColumn fx:id="colLoan" prefWidth="100.0" styleClass="cell-right-aligned" text="%loanamt" />
                        <TableColumn fx:id="colOtherAdd" prefWidth="100.0" styleClass="cell-right-aligned" text="%otheradd" />
                        <TableColumn fx:id="colOtherDed" prefWidth="100.0" styleClass="cell-right-aligned" text="%otherded" />
                        <TableColumn fx:id="colNetAmount" prefWidth="120.0" styleClass="cell-right-aligned" text="%netamount" />
                        <TableColumn fx:id="colPaymentMode" prefWidth="100.0" styleClass="cell-center-aligned" text="%paymentmode" />
                        <TableColumn fx:id="colStatus" prefWidth="100.0" styleClass="cell-center-aligned" text="%status" />
                    </columns>
                </TableView>
                <HBox prefWidth="200.0" spacing="15.0">
                    <children>
                        <Button fx:id="btnEdit" disable="true" mnemonicParsing="true" prefHeight="30.0" prefWidth="80.0" text="%edit" />
                        <Button fx:id="btnClose" mnemonicParsing="true" prefHeight="30.0" prefWidth="80.0" text="%close" />
                        <Label maxWidth="1.7976931348623157E308" HBox.hgrow="ALWAYS" />
                        <Button fx:id="btnFinalize" mnemonicParsing="true" prefHeight="30.0" prefWidth="80.0" text="%finalize" />
                        <Button fx:id="btnExport" mnemonicParsing="true" prefHeight="30.0" prefWidth="80.0" text="%export" />
                    </children>
                </HBox>
            </children>
        </VBox>
    </children>
</StackPane>
