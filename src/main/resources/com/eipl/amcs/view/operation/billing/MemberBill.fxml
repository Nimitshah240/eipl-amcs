<?xml version="1.0" encoding="UTF-8"?>

<?import com.eipl.amcs.controls.AutoSearchTextField?>
<?import com.eipl.amcs.controls.E_Button?>
<?import com.eipl.amcs.controls.E_DatePicker?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.RowConstraints?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane fx:id="root" prefHeight="400.0" prefWidth="700.0" styleClass="pane-center" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.eipl.amcs.operation.billing.controller.MemberBillController">
    <children>
        <VBox spacing="15.0">
            <children>
                <Label styleClass="header-text" text="%member.bill" />
                <GridPane hgap="10.0" maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308" vgap="10.0">
                    <columnConstraints>
                        <ColumnConstraints minWidth="10.0" prefWidth="250.0" />
                        <ColumnConstraints maxWidth="-Infinity" minWidth="10.0" prefWidth="150.0" />
                        <ColumnConstraints maxWidth="-Infinity" minWidth="10.0" prefWidth="150.0" />
                        <ColumnConstraints hgrow="ALWAYS" minWidth="10.0" prefWidth="100.0" />
                        <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0" />
                        <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0" />
                        <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0" />
                        <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0" />
                    </columnConstraints>
                    <rowConstraints>
                        <RowConstraints />
                        <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
                        <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
                    </rowConstraints>
                    <children>
                        <Label text="%paymentcycleid" GridPane.rowIndex="1" />
                        <AutoSearchTextField fx:id="cboxPaymentCycle" editable="true" prefWidth="230.0" GridPane.rowIndex="2" />
                        <E_DatePicker fx:id="dpDeductionFromDate" GridPane.columnIndex="1" GridPane.halignment="LEFT" GridPane.rowIndex="2" />
                        <E_DatePicker fx:id="dpDeductionToDate" GridPane.columnIndex="2" GridPane.halignment="LEFT" GridPane.rowIndex="2" />
                        <E_Button fx:id="btnGenerate" mnemonicParsing="false" text="%generate" GridPane.columnIndex="3" GridPane.hgrow="ALWAYS" GridPane.rowIndex="2" />
                        <E_Button fx:id="btnReport" mnemonicParsing="false" text="%generalreport" GridPane.columnIndex="4" GridPane.rowIndex="2" />
                        <Label text="%deductionfromdate" GridPane.columnIndex="1" GridPane.rowIndex="1" />
                        <Label text="%deductiontodate" GridPane.columnIndex="2" GridPane.rowIndex="1" />
                        <HBox alignment="CENTER_RIGHT" spacing="10.0" GridPane.columnIndex="5" GridPane.columnSpan="3" GridPane.rowIndex="2">
                            <children>
                                <E_DatePicker fx:id="dpDisburseDate" disable="true" prefWidth="125.0" />
                                <AutoSearchTextField fx:id="cboxBank" prefWidth="230.0" />
                                <E_Button fx:id="btnDisburse" mnemonicParsing="false" text="%disburse" />
                            </children>
                        </HBox>
                    </children>
                </GridPane>
                <TableView fx:id="tableBill" prefHeight="350.0" prefWidth="600.0" VBox.vgrow="ALWAYS">
                    <columns>
                        <!--                        <TableColumn fx:id="colSelect" prefWidth="50.0" text="#" />-->
                        <TableColumn fx:id="colMemberCode" prefWidth="80.0" styleClass="cell-center-aligned" text="%code" />
                        <TableColumn fx:id="colMemberName" prefWidth="150.0" text="%name" />
                        <TableColumn fx:id="colMilkQty" prefWidth="100.0" styleClass="cell-right-aligned" text="%milkqty" />
                        <TableColumn fx:id="colMilkAmount" prefWidth="100.0" styleClass="cell-right-aligned" text="%milkamt" />
                        <TableColumn fx:id="colProductSale" prefWidth="100.0" styleClass="cell-right-aligned" text="%productsaleamt" />
                        <TableColumn fx:id="colLocalSale" prefWidth="100.0" styleClass="cell-right-aligned" text="%localsaleamt" />
                        <TableColumn fx:id="colLoan" prefWidth="100.0" styleClass="cell-right-aligned" text="%loanamt" />
                        <TableColumn fx:id="colOtherAdd" prefWidth="100.0" styleClass="cell-right-aligned" text="%otheradd" />
                        <TableColumn fx:id="colOtherDed" prefWidth="100.0" styleClass="cell-right-aligned" text="%otherded" />
                        <TableColumn fx:id="colNetAmount" prefWidth="120.0" styleClass="cell-right-aligned" text="%netamount" />
                        <TableColumn fx:id="colPaymentMode" prefWidth="100.0" styleClass="cell-center-aligned" text="%paymentmode" />
                        <TableColumn fx:id="colStatus" prefWidth="100.0" styleClass="cell-center-aligned" text="%status" />
                    </columns>
                </TableView>
                <HBox prefWidth="200.0" spacing="15.0">
                    <children>
                        <E_Button fx:id="btnEdit" disable="true" mnemonicParsing="true" prefHeight="30.0" prefWidth="80.0" text="%edit" />
                        <E_Button fx:id="btnClose" mnemonicParsing="true" prefHeight="30.0" prefWidth="80.0" text="%close" />
                        <Label maxWidth="1.7976931348623157E308" HBox.hgrow="ALWAYS" />
                        <E_Button fx:id="btnFinalize" mnemonicParsing="true" prefHeight="30.0" prefWidth="80.0" text="%finalize" />
                        <E_Button fx:id="btnExport" mnemonicParsing="true" prefHeight="30.0" prefWidth="80.0" text="%export" />
                    </children>
                    <padding>
                        <Insets bottom="10.0" />
                    </padding>
                </HBox>
            </children>
        </VBox>
    </children>
</StackPane>
