<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane fx:id="root" prefHeight="400.0" prefWidth="700.0" styleClass="pane-center" xmlns="http://javafx.com/javafx/11" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.eipl.amcs.operation.billing.controller.MilkSummaryDataEntryController">
    <children>
        <VBox spacing="15.0">
            <children>
                <Label styleClass="header-text" text="%milkcollectionsummarydataentry" />
            <HBox alignment="CENTER_RIGHT" prefWidth="200.0" spacing="10.0">
               <children>
                  <DatePicker fx:id="dpFromDate" prefWidth="120.0" />
                  <Label maxHeight="1.7976931348623157E308" text="%to" />
                  <DatePicker fx:id="dpToDate" prefWidth="120.0" />
                  <Button fx:id="btnSearch" mnemonicParsing="false" text="%search" />
               </children>
            </HBox>
                <TableView fx:id="tableMilkCollectionSummary" prefHeight="350.0" prefWidth="600.0" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="colDate" prefWidth="88.0" styleClass="cell-center-aligned" text="%date" />
                        <TableColumn fx:id="colPaymentCycle" prefWidth="200.0" text="%paymentcycle" />
                        <TableColumn fx:id="colMemberCode" prefWidth="80.0" styleClass="cell-center-aligned" text="%membercode" />
                        <TableColumn fx:id="colMemberName" prefWidth="150.0" text="%membername" />
                        <TableColumn fx:id="colMilkType" prefWidth="100.0" styleClass="cell-center-aligned" text="%milktype" />
                        <TableColumn fx:id="colMilkQuantity" prefWidth="100.0" styleClass="cell-right-aligned" text="%milkquantity" />
                        <TableColumn fx:id="colMilkAmount" prefWidth="120.0" styleClass="cell-right-aligned" text="%milkAmount" />
                    </columns>
                </TableView>
                <HBox prefWidth="200.0" spacing="15.0">
                    <children>
                        <Button fx:id="btnAdd" mnemonicParsing="true" prefHeight="30.0" prefWidth="80.0" styleClass="button-primary" text="%add" />
                        <Button fx:id="btnEdit" disable="true" mnemonicParsing="true" prefWidth="80.0" text="%edit" />
                        <Button fx:id="btnDelete" disable="true" mnemonicParsing="true" prefHeight="30.0" prefWidth="80.0" text="%delete" />
                        <Button fx:id="btnClose" mnemonicParsing="true" prefHeight="30.0" prefWidth="80.0" text="%close" />
                  <Label maxWidth="1.7976931348623157E308" HBox.hgrow="ALWAYS" />
                  <Button fx:id="btnImport" alignment="CENTER" mnemonicParsing="false" prefHeight="30.0" prefWidth="80.0" text="%import" HBox.hgrow="ALWAYS" />
                    </children>
                </HBox>
            </children>
        </VBox>
    </children>
</StackPane>
