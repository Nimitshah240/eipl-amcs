<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane prefHeight="400.0" prefWidth="600.0" styleClass="pane-center" xmlns="http://javafx.com/javafx/20.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.eipl.amcs.operation.inventory.controller.DeadStockController">
    <children>
        <VBox prefHeight="200.0" prefWidth="100.0" spacing="15.0">
            <children>
                <HBox alignment="CENTER_RIGHT" spacing="5.0">
                    <children>
                        <Label maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308" styleClass="header-text" text="%deadstock" />
                        <Label maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308" HBox.hgrow="ALWAYS" />
                        <DatePicker fx:id="dpFromDate" prefWidth="130.0">
                            <HBox.margin>
                                <Insets />
                            </HBox.margin>
                        </DatePicker>
                        <Label alignment="CENTER" contentDisplay="CENTER" text="%to" textAlignment="CENTER">
                            <HBox.margin>
                                <Insets />
                            </HBox.margin>
                            <opaqueInsets>
                                <Insets />
                            </opaqueInsets>
                            <padding>
                                <Insets top="5.0" />
                            </padding>
                        </Label>
                        <DatePicker fx:id="dpToDate" prefWidth="130.0">
                            <HBox.margin>
                                <Insets />
                            </HBox.margin>
                        </DatePicker>
                        <Button fx:id="btnSearch" minHeight="35.0" minWidth="100.0" mnemonicParsing="false" text="%search">
                            <HBox.margin>
                                <Insets />
                            </HBox.margin>
                            <graphic>
                                <ImageView fitHeight="20.0" fitWidth="20.0" nodeOrientation="RIGHT_TO_LEFT" pickOnBounds="true" preserveRatio="true">
                                    <image>
                                        <Image url="@../../images/search.png" />
                                    </image>
                                </ImageView>
                            </graphic>
                        </Button>
                    </children>
               <padding>
                  <Insets right="10.0" />
               </padding>
                </HBox>
                <TableView fx:id="tableDeadStock" prefHeight="350.0" prefWidth="600.0" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="colCode" prefWidth="250.0" text="%code" />
                        <TableColumn fx:id="colPurchaseDate" prefWidth="125.0" text="%purchasedate" />
                        <TableColumn fx:id="colName" prefWidth="150.0" text="%name" />
                        <TableColumn fx:id="colNameLocal" prefWidth="150.0" text="%namelocal" />
                        <TableColumn fx:id="colLedgerAccount" prefWidth="150.0" text="%ledgeraccount" />
                        <TableColumn fx:id="colQty" prefWidth="125.0" text="%qty" />
                        <TableColumn fx:id="colAmount" prefWidth="150.0" text="%amount" />
                    </columns>
                </TableView>
                <HBox prefWidth="200.0" spacing="15">
                    <children>
                        <Button fx:id="btnAdd" contentDisplay="TOP" graphicTextGap="5.0" prefHeight="50.0" prefWidth="70.0" text="%add">
                            <graphic>
                                <ImageView fitHeight="40.0" fitWidth="40.0" pickOnBounds="true" preserveRatio="true">
                                    <image>
                                        <Image url="@../../images/add.png" />
                                    </image>
                                </ImageView>
                            </graphic>
                        </Button>
                        <Button fx:id="btnEdit" contentDisplay="TOP" disable="true" graphicTextGap="5.0" mnemonicParsing="true" prefHeight="50.0" prefWidth="70.0" text="%edit">
                            <graphic>
                                <ImageView fitHeight="40.0" fitWidth="40.0" pickOnBounds="true" preserveRatio="true">
                                    <image>
                                        <Image url="@../../images/edit.png" />
                                    </image>
                                </ImageView>
                            </graphic>
                        </Button>
                        <Button fx:id="btnDelete" contentDisplay="TOP" disable="true" graphicTextGap="5.0" mnemonicParsing="true" prefHeight="50.0" prefWidth="70.0" text="%delete">
                            <graphic>
                                <ImageView fitHeight="40.0" fitWidth="40.0" pickOnBounds="true" preserveRatio="true">
                                    <image>
                                        <Image url="@../../images/delete.png" />
                                    </image>
                                </ImageView>
                            </graphic>
                        </Button>
                        <Button fx:id="btnClose" contentDisplay="TOP" graphicTextGap="5.0" prefHeight="50.0" prefWidth="70.0" text="%close">
                            <graphic>
                                <ImageView fitHeight="40.0" fitWidth="40.0" pickOnBounds="true" preserveRatio="true">
                                    <image>
                                        <Image url="@../../images/close.png" />
                                    </image>
                                </ImageView>
                            </graphic>
                        </Button>
                  <Label maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308" HBox.hgrow="ALWAYS" />
                  <Button fx:id="btnExport" contentDisplay="TOP" graphicTextGap="5.0" prefHeight="50.0" prefWidth="70.0" text="%export">
                     <graphic>
                        <ImageView fitHeight="40.0" fitWidth="40.0" pickOnBounds="true" preserveRatio="true">
                           <image>
                              <Image url="@../../images/excel.png" />
                           </image>
                        </ImageView>
                     </graphic>
                  </Button>
                    </children>
                    <padding>
                        <Insets bottom="5.0" left="10.0" right="10.0" />
                    </padding>
                </HBox>
            </children>
        </VBox>
    </children>
</StackPane>
