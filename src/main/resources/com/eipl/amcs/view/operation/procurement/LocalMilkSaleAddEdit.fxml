<?xml version="1.0" encoding="UTF-8"?>

<?import com.eipl.amcs.controls.E_ComboBox?>
<?import com.eipl.amcs.controls.E_DatePicker?>
<?import com.eipl.amcs.controls.E_TextField?>
<?import com.eipl.amcs.controls.E_Button?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.RowConstraints?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane fx:id="root" prefWidth="600.0" xmlns="http://javafx.com/javafx/20.0.1" xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="com.eipl.amcs.operation.procurement.controller.LocalMilkSaleAddEditController">
    <children>
        <VBox prefHeight="200.0" prefWidth="100.0" spacing="20.0" styleClass="pane-white-drop-border">
            <children>
                <HBox>
                    <children>
                        <Label styleClass="header-text" text="%localmilksale"/>
                        <HBox alignment="TOP_RIGHT" HBox.hgrow="ALWAYS"/>
                    </children>
                </HBox>
                <GridPane hgap="10.0" prefHeight="141.0" prefWidth="196.0" vgap="5.0">
                    <columnConstraints>
                        <ColumnConstraints hgrow="SOMETIMES" maxWidth="186.0" minWidth="10.0" percentWidth="33.0"
                                           prefWidth="167.0"/>
                        <ColumnConstraints hgrow="SOMETIMES" maxWidth="191.0" minWidth="10.0" percentWidth="33.0"
                                           prefWidth="150.0"/>
                        <ColumnConstraints hgrow="SOMETIMES" maxWidth="81.0" minWidth="10.0" percentWidth="33.0"
                                           prefWidth="77.0"/>
                    </columnConstraints>
                    <rowConstraints>
                        <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="ALWAYS"/>
                        <RowConstraints vgrow="ALWAYS"/>
                        <RowConstraints vgrow="SOMETIMES"/>
                        <RowConstraints vgrow="SOMETIMES"/>
                        <RowConstraints vgrow="SOMETIMES"/>
                        <RowConstraints vgrow="SOMETIMES"/>
                        <RowConstraints vgrow="SOMETIMES"/>
                        <RowConstraints vgrow="SOMETIMES"/>
                        <RowConstraints minHeight="0.0" vgrow="SOMETIMES"/>
                        <RowConstraints minHeight="0.0" vgrow="SOMETIMES"/>
                        <RowConstraints minHeight="0.0" vgrow="SOMETIMES"/>
                        <RowConstraints minHeight="40.0" prefHeight="50.0" vgrow="SOMETIMES"/>
                    </rowConstraints>

                    <children>

                        <E_DatePicker fx:id="dpSellDate" disable="false" editable="false" GridPane.rowIndex="1"/>
                        <E_ComboBox fx:id="cboxShift" maxWidth="1.7976931348623157E308" GridPane.columnIndex="1"
                                    GridPane.rowIndex="1"/>
                        <E_ComboBox fx:id="cboxConsumertype" maxWidth="1.7976931348623157E308" GridPane.rowIndex="3"/>
                        <Label text="%consumercode" GridPane.columnIndex="1" GridPane.rowIndex="2"/>
                        <E_TextField fx:id="txtConsumerCode" maxWidth="1.7976931348623157E308" GridPane.columnIndex="1"
                                     GridPane.rowIndex="3"/>
                        <Label text="%consumername" GridPane.columnIndex="2" GridPane.rowIndex="2"/>
                        <E_TextField fx:id="txtConsumerName" disable="true" maxWidth="1.7976931348623157E308"
                                     GridPane.columnIndex="2" GridPane.rowIndex="3"/>
                        <Label text="%consumertype" GridPane.rowIndex="2"/>
                        <Label text="%paymenttype" GridPane.rowIndex="4"/>
                        <Label text="%milktype" GridPane.columnIndex="1" GridPane.rowIndex="4"/>
                        <Label text="%class" GridPane.columnIndex="2" GridPane.rowIndex="4"/>
                        <Label text="%quantity" GridPane.rowIndex="6"/>
                        <Label text="%rate" GridPane.columnIndex="1" GridPane.rowIndex="6"/>
                        <Label text="%amount" GridPane.columnIndex="2" GridPane.rowIndex="6"/>
                        <Label text="%couponbalance" GridPane.rowIndex="11"/>
                        <E_ComboBox fx:id="cboxPaymentType" maxWidth="1.7976931348623157E308" GridPane.rowIndex="5"/>
                        <E_ComboBox fx:id="cboxMilkType" maxWidth="1.7976931348623157E308" GridPane.columnIndex="1"
                                    GridPane.rowIndex="5"/>
                        <E_ComboBox fx:id="cboxClass" maxWidth="1.7976931348623157E308" GridPane.columnIndex="2"
                                    GridPane.rowIndex="5"/>
                        <E_TextField fx:id="txtQuantity" maxWidth="1.7976931348623157E308" GridPane.rowIndex="7"/>
                        <E_TextField fx:id="txtRate" maxWidth="1.7976931348623157E308" GridPane.columnIndex="1"
                                     GridPane.rowIndex="7"/>
                        <E_TextField fx:id="txtAmount" maxWidth="1.7976931348623157E308" GridPane.columnIndex="2"
                                     GridPane.rowIndex="7"/>
                        <E_TextField fx:id="txtCouponBalance" disable="true" maxWidth="1.7976931348623157E308"
                                     GridPane.columnIndex="1" GridPane.rowIndex="11"/>
                        <E_TextField fx:id="txtCash" disable="true" maxWidth="1.7976931348623157E308" opacity="0.0"
                                     visible="false" GridPane.rowIndex="9"/>
                        <E_TextField fx:id="txtCredit" disable="true" maxWidth="1.7976931348623157E308" opacity="0.0"
                                     visible="false" GridPane.columnIndex="1" GridPane.rowIndex="9"/>
                        <E_TextField fx:id="txtCoupon" disable="true" maxWidth="1.7976931348623157E308" opacity="0.0"
                                     visible="false" GridPane.columnIndex="2" GridPane.rowIndex="9"/>
                        <Label disable="true" opacity="0.0" text="%cash" visible="false" GridPane.rowIndex="8"/>
                        <Label disable="true" opacity="0.0" text="%credit" visible="false" GridPane.columnIndex="1"
                               GridPane.rowIndex="8"/>
                        <Label disable="true" opacity="0.0" text="%coupon" visible="false" GridPane.columnIndex="2"
                               GridPane.rowIndex="8"/>


                        <Label text="%date"/>
                        <Label text="%shift" GridPane.columnIndex="1"/>
                        <HBox alignment="CENTER_RIGHT" focusTraversable="true" prefWidth="200.0" spacing="15"
                              GridPane.columnIndex="2" GridPane.rowIndex="11">
                            <children>
                                <E_Button fx:id="btnSaveUpdate" contentDisplay="TOP" graphicTextGap="5.0"
                                          prefHeight="50.0" prefWidth="70.0" text="%save">
                                    <graphic>
                                        <ImageView fitHeight="40.0" fitWidth="40.0" pickOnBounds="true"
                                                   preserveRatio="true">
                                            <image>
                                                <Image url="@../../images/add.png"/>
                                            </image>
                                        </ImageView>
                                    </graphic>
                                </E_Button>
                                <E_Button fx:id="btnClose" contentDisplay="TOP" graphicTextGap="5.0" prefHeight="50.0"
                                          prefWidth="70.0" text="%close">
                                    <graphic>
                                        <ImageView fitHeight="40.0" fitWidth="40.0" pickOnBounds="true"
                                                   preserveRatio="true">
                                            <image>
                                                <Image url="@../../images/close.png"/>
                                            </image>
                                        </ImageView>
                                    </graphic>
                                </E_Button>
                            </children>
                        </HBox>
                    </children>
                </GridPane>
            </children>
            <padding>
                <Insets bottom="25.0" left="25.0" right="25.0" top="25.0"/>
            </padding>
        </VBox>
    </children>
    <padding>
        <Insets bottom="15.0" left="15.0" right="15.0" top="15.0"/>
    </padding>
</StackPane>
