<?xml version="1.0" encoding="UTF-8"?>

<?import com.eipl.amcs.controls.AutoSearchTextField?>
<?import com.eipl.amcs.controls.E_DatePicker?>
<?import com.eipl.amcs.controls.E_TextField?>
<?import com.eipl.amcs.controls.E_Button?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.RowConstraints?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<StackPane fx:id="root" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="com.eipl.amcs.operation.inventory.controller.KapaatAddEditController">
    <children>
        <VBox spacing="20.0" styleClass="">
            <children>
                <!--                <Label styleClass="header-text" text="%kapaat"/>-->
                <GridPane fx:id="grid" hgap="15.0" vgap="5.0">
                    <columnConstraints>
                        <ColumnConstraints hgrow="SOMETIMES" percentWidth="0.0"/>
                        <ColumnConstraints hgrow="SOMETIMES" percentWidth="0.0"/>
                        <ColumnConstraints hgrow="SOMETIMES" percentWidth="0.0"/>
                        <ColumnConstraints hgrow="SOMETIMES" percentWidth="0.0"/>
                    </columnConstraints>
                    <rowConstraints>
                        <RowConstraints/>
                        <RowConstraints minHeight="25.0" vgrow="SOMETIMES"/>
                        <RowConstraints minHeight="25.0" vgrow="SOMETIMES"/>
                        <RowConstraints minHeight="25.0" prefHeight="30.0" vgrow="SOMETIMES"/>
                        <RowConstraints minHeight="25.0" prefHeight="30.0" vgrow="SOMETIMES"/>
                        <RowConstraints minHeight="25.0" prefHeight="30.0" vgrow="SOMETIMES"/>
                        <RowConstraints minHeight="25.0" prefHeight="30.0" vgrow="SOMETIMES"/>
                        <RowConstraints minHeight="25.0" prefHeight="30.0" vgrow="SOMETIMES"/>
                    </rowConstraints>
                    <children>
                        <Label text="%deductiondate" GridPane.columnIndex="1" GridPane.columnSpan="2"
                               GridPane.rowIndex="1"/>
                        <AutoSearchTextField fx:id="cboxPaymentCycle" maxHeight="1.7976931348623157E308"
                                             maxWidth="1.7976931348623157E308" GridPane.rowIndex="2"/>
                        <E_DatePicker fx:id="dpDeductionDate" maxHeight="1.7976931348623157E308"
                                      maxWidth="1.7976931348623157E308" GridPane.columnIndex="1" GridPane.rowIndex="2"/>
                        <E_TextField fx:id="txtCode" maxHeight="1.7976931348623157E308"
                                     maxWidth="1.7976931348623157E308" promptText="Member Code" GridPane.rowIndex="4"/>
                        <Label text="%code" GridPane.rowIndex="3"/>
                        <AutoSearchTextField fx:id="cboxProduct" maxHeight="1.7976931348623157E308"
                                             maxWidth="1.7976931348623157E308" GridPane.columnSpan="2"
                                             GridPane.rowIndex="6"/>
                        <E_TextField fx:id="txtAmount" maxHeight="1.7976931348623157E308"
                                     maxWidth="1.7976931348623157E308" promptText="Amount" GridPane.columnIndex="2"
                                     GridPane.rowIndex="6"/>
                        <HBox alignment="CENTER_RIGHT" spacing="5.0" GridPane.columnIndex="3" GridPane.rowIndex="7">
                            <children>
                                <E_Button fx:id="btnAdd" graphicTextGap="5.0" minHeight="36.0" minWidth="100.0"
                                        text="%add">
                                    <graphic>
                                        <ImageView fitHeight="20.0" fitWidth="20.0" pickOnBounds="true"
                                                   preserveRatio="true">
                                            <image>
                                                <Image url="@../../images/plus.png"/>
                                            </image>
                                        </ImageView>
                                    </graphic>
                                </E_Button>
                                <E_Button fx:id="btnDelete" graphicTextGap="5.0" minHeight="36.0" minWidth="100.0"
                                        text="%delete">
                                    <graphic>
                                        <ImageView fitHeight="24.0" fitWidth="24.0" pickOnBounds="true"
                                                   preserveRatio="true">
                                            <image>
                                                <Image url="@../../images/close.png"/>
                                            </image>
                                        </ImageView>
                                    </graphic>
                                </E_Button>
                            </children>
                            <padding>
                                <Insets top="10.0"/>
                            </padding>
                        </HBox>

                        <E_TextField fx:id="txtBalance" disable="true" GridPane.columnIndex="2" GridPane.rowIndex="2">
                            <font>
                                <Font name="System Bold" size="16.0"/>
                            </font>
                        </E_TextField>
                        <Label contentDisplay="RIGHT" maxWidth="1.7976931348623157E308" text="%balance"
                               GridPane.columnIndex="2" GridPane.rowIndex="1"/>
                        <E_TextField fx:id="txtDue" disable="true" GridPane.columnIndex="3" GridPane.rowIndex="2">
                            <font>
                                <Font name="System Bold" size="16.0"/>
                            </font>
                        </E_TextField>
                        <E_TextField fx:id="txtTotal" disable="true" GridPane.columnIndex="3" GridPane.rowIndex="6">
                            <font>
                                <Font name="System Bold" size="16.0"/>
                            </font>
                        </E_TextField>
                        <E_TextField fx:id="txtName" disable="true" maxHeight="1.7976931348623157E308"
                                     maxWidth="1.7976931348623157E308" promptText="Member Name" GridPane.columnIndex="1"
                                     GridPane.columnSpan="2" GridPane.rowIndex="4"/>
                        <E_TextField fx:id="txtMobileNo" maxHeight="1.7976931348623157E308" disable="true"
                                     maxWidth="1.7976931348623157E308" promptText="Mobile No" GridPane.columnIndex="3"
                                     GridPane.rowIndex="4"/>
                        <Label maxWidth="1.7976931348623157E308" text="%kapaat" GridPane.columnIndex="3"
                               GridPane.rowIndex="1"/>
                        <Label text="%societypaymentcycle" GridPane.rowIndex="1"/>
                        <Label text="%product" GridPane.rowIndex="5"/>
                        <Label text="%amount" GridPane.columnIndex="2" GridPane.rowIndex="5"/>
                        <Label text="%name" GridPane.columnIndex="1" GridPane.rowIndex="3"/>
                        <Label text="%mobileno" GridPane.columnIndex="3" GridPane.rowIndex="3"/>
                        <Label fx:id="lblTotal" maxWidth="1.7976931348623157E308" text="%total" GridPane.columnIndex="3"
                               GridPane.rowIndex="5"/>
                    </children>
                </GridPane>
                <TableView fx:id="tableData" prefHeight="200.0" prefWidth="200.0">
                    <columns>
                        <TableColumn fx:id="colProduct" prefWidth="100.0" text="%name"/>
                        <TableColumn fx:id="colAmount" prefWidth="100.0" text="%amount"/>
                    </columns>
                    <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                    </columnResizePolicy>
                </TableView>
                <HBox alignment="CENTER_RIGHT" prefWidth="200.0" spacing="15">
                    <children>
                        <Button fx:id="btnSave" contentDisplay="TOP" graphicTextGap="5.0" prefHeight="50.0"
                                prefWidth="70.0" text="%save">
                            <graphic>
                                <ImageView fitHeight="40.0" fitWidth="40.0" pickOnBounds="true" preserveRatio="true">
                                    <image>
                                        <Image url="@../../images/add.png"/>
                                    </image>
                                </ImageView>
                            </graphic>
                        </Button>
                        <Button fx:id="btnClose" contentDisplay="TOP" graphicTextGap="5.0" prefHeight="50.0"
                                prefWidth="70.0" text="%close">
                            <graphic>
                                <ImageView fitHeight="40.0" fitWidth="40.0" pickOnBounds="true" preserveRatio="true">
                                    <image>
                                        <Image url="@../../images/close.png"/>
                                    </image>
                                </ImageView>
                            </graphic>
                        </Button>
                    </children>
                </HBox>
            </children>
            <padding>
                <Insets bottom="10.0" left="10.0" right="10.0" top="10.0"/>
            </padding>
            <StackPane.margin>
                <Insets bottom="10.0" left="10.0" right="10.0" top="10.0"/>
            </StackPane.margin>
        </VBox>
    </children>
    <padding>
        <Insets bottom="15.0" left="15.0" right="15.0" top="15.0"/>
    </padding>
</StackPane>
