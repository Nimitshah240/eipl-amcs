<?xml version="1.0" encoding="UTF-8"?>

<?import com.eipl.amcs.controls.E_DatePicker?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.RowConstraints?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane fx:id="root" prefHeight="300.0" prefWidth="600.0" styleClass="pane-center" xmlns="http://javafx.com/javafx/20.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.eipl.amcs.operation.billing.controller.GeneralBonusReportController">
    <children>
        <VBox maxHeight="300.0" maxWidth="722.0" minHeight="300.0" minWidth="722.0" prefHeight="300.0" prefWidth="722.0" spacing="15.0" styleClass="">
            <children>
                <Label styleClass="header-text" text="%bonus" />
                <GridPane hgap="8.0" vgap="5.0">
                    <columnConstraints>
                  <ColumnConstraints hgrow="SOMETIMES" maxWidth="1.7976931348623157E308" percentWidth="33.0" />
                  <ColumnConstraints hgrow="SOMETIMES" maxWidth="1.7976931348623157E308" minWidth="10.0" percentWidth="33.0" prefWidth="100.0" />
                  <ColumnConstraints hgrow="SOMETIMES" maxWidth="1.7976931348623157E308" minWidth="10.0" percentWidth="33.0" prefWidth="100.0" />
                  <ColumnConstraints hgrow="SOMETIMES" maxWidth="1.7976931348623157E308" minWidth="10.0" percentWidth="33.0" prefWidth="100.0" />
                    </columnConstraints>
                    <rowConstraints>
                        <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
                  <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
                  <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
                  <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
                  <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
                    </rowConstraints>
                    <children>
                  <HBox alignment="CENTER_RIGHT" spacing="5.0" GridPane.columnIndex="3" GridPane.halignment="RIGHT" GridPane.hgrow="ALWAYS" GridPane.rowIndex="3">
                     <children>
                              <Button fx:id="btnGenerate" mnemonicParsing="true" styleClass="button-primary" text="%generate" />
                        <Button fx:id="btnClose" mnemonicParsing="true" prefHeight="25.0" prefWidth="64.0" styleClass="button-primary" text="%close" />
                     </children>
                  </HBox>
                  <Label text="%reporttype" GridPane.rowIndex="2" />
                  <Label text="%bank" GridPane.columnIndex="1" GridPane.rowIndex="2" />
                  <E_DatePicker fx:id="dpFromDate" maxWidth="1.7976931348623157E308" GridPane.rowIndex="1" />
                  <E_DatePicker fx:id="dpToDate" maxWidth="1.7976931348623157E308" GridPane.columnIndex="1" GridPane.rowIndex="1" />
                  <ComboBox fx:id="cboxType" editable="true" maxWidth="1.7976931348623157E308" GridPane.columnIndex="2" GridPane.rowIndex="1" />
                  <ComboBox fx:id="cboxReportType" editable="true" maxWidth="1.7976931348623157E308" GridPane.rowIndex="3" />
                  <ComboBox fx:id="cboxBank" editable="true" maxWidth="1.7976931348623157E308" GridPane.columnIndex="1" GridPane.rowIndex="3" />
                  <Label text="%fromdate" />
                  <Label text="%todate" GridPane.columnIndex="1" />
                  <ComboBox fx:id="cboxMember" editable="true" maxWidth="1.7976931348623157E308" GridPane.columnIndex="2" GridPane.rowIndex="3" />
                  <Label text="%member" GridPane.columnIndex="2" GridPane.rowIndex="2" />
                  <Label text="%type" GridPane.columnIndex="2" />
                  <Label text="%milktype" GridPane.columnIndex="3" />
                  <ComboBox fx:id="cboxMilkType" editable="true" maxWidth="1.7976931348623157E308" GridPane.columnIndex="3" GridPane.rowIndex="1" />


                    </children>
                </GridPane>
            </children>
         <padding>
            <Insets bottom="15.0" left="15.0" right="15.0" top="15.0" />
         </padding>
        </VBox>
    </children>
</StackPane>
