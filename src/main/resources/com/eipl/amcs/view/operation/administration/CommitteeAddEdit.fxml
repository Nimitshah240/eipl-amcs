<?xml version="1.0" encoding="UTF-8"?>

<?import com.eipl.amcs.controls.*?>
<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>


<StackPane fx:id="root" prefWidth="800.0" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.eipl.amcs.operation.administartion.controller.CommitteeAddEditController">
    <children>
        <VBox prefHeight="200.0" prefWidth="100.0" spacing="20.0" styleClass="pane-white">
            <children>
                <GridPane fx:id="gridCommitteeMembers" hgap="10.0">
                    <columnConstraints>
                        <ColumnConstraints hgrow="SOMETIMES" />
                        <ColumnConstraints hgrow="SOMETIMES" />
                        <ColumnConstraints hgrow="SOMETIMES" />
                        <ColumnConstraints />
                    </columnConstraints>
                    <rowConstraints>
                        <RowConstraints minHeight="30.0" prefHeight="30.0" vgrow="SOMETIMES" />
                        <RowConstraints minHeight="30.0" prefHeight="30.0" vgrow="SOMETIMES" />
                        <RowConstraints minHeight="30.0" prefHeight="30.0" vgrow="SOMETIMES" />
                        <RowConstraints minHeight="30.0" prefHeight="30.0" vgrow="SOMETIMES" />
                        <RowConstraints minHeight="30.0" prefHeight="30.0" vgrow="SOMETIMES" />
                        <RowConstraints minHeight="30.0" prefHeight="30.0" vgrow="SOMETIMES" />
                        <RowConstraints minHeight="30.0" prefHeight="30.0" vgrow="SOMETIMES" />
                        <RowConstraints minHeight="30.0" prefHeight="30.0" vgrow="SOMETIMES" />
                        <RowConstraints minHeight="30.0" prefHeight="30.0" vgrow="SOMETIMES" />
                    </rowConstraints>
                    <children>
                        <Label maxWidth="1.7976931348623157E308" text="%electiondate" GridPane.rowIndex="2" />
                        <Label text="%registrationdate" GridPane.columnIndex="1" GridPane.rowIndex="7" />
                        <Label text="%committeename" />

                        <Label text="%joiningdate" GridPane.rowIndex="7" />
                        <E_TextField fx:id="txtName" maxWidth="1.7976931348623157E308" GridPane.columnSpan="2" GridPane.rowIndex="1" />
                        <E_TextField fx:id="txtNameLocal" maxWidth="1.7976931348623157E308" prefWidth="250.0" GridPane.columnIndex="2" GridPane.columnSpan="2" GridPane.rowIndex="1" />
                        <E_DatePicker fx:id="dpElectionDate" maxWidth="1.7976931348623157E308" GridPane.rowIndex="3" />
                        <E_DatePicker fx:id="dpFormation" maxWidth="1.7976931348623157E308" GridPane.columnIndex="1" GridPane.rowIndex="3" />
                        <E_TextField fx:id="txtMemberName" maxWidth="1.7976931348623157E308" GridPane.columnSpan="2" GridPane.rowIndex="6" />
                        <E_ComboBox fx:id="cboxDesignation" maxWidth="1.7976931348623157E308" prefWidth="150.0" GridPane.columnIndex="2" GridPane.rowIndex="6" />
                        <E_DatePicker fx:id="dpJoiningDate" maxWidth="1.7976931348623157E308" GridPane.rowIndex="8" />
                        <E_DatePicker fx:id="dpRegistrationdate" maxWidth="1.7976931348623157E308" GridPane.columnIndex="1" GridPane.rowIndex="8" />
                        <Label text="%designation" GridPane.columnIndex="2" GridPane.rowIndex="5" />
                        <Label text="%committeename.local" GridPane.columnIndex="2" />
                        <Label maxWidth="1.7976931348623157E308" text="%formationdate" GridPane.columnIndex="1" GridPane.rowIndex="2" />
                        <Label text="%committeemembers" GridPane.rowIndex="4"  styleClass="sub-header-text-primary" />
                        <Separator maxHeight="1.7976931348623157E308" GridPane.columnIndex="1" GridPane.columnSpan="3" GridPane.rowIndex="4" />
                        <Label text="%member.name" GridPane.rowIndex="5" />
                        <HBox spacing="10.0" GridPane.columnIndex="2" GridPane.rowIndex="8">
                            <children>
                                <E_Button fx:id="btnAdd" graphicTextGap="5.0" minHeight="36.0" minWidth="100.0" text="%add">
                                    <graphic>
                                        <ImageView fitHeight="20.0" fitWidth="20.0" pickOnBounds="true" preserveRatio="true">
                                            <image>
                                                <Image url="@../../images/plus.png" />
                                            </image>
                                        </ImageView>
                                    </graphic>
                                </E_Button>
                                <E_Button fx:id="btnDelete" graphicTextGap="5.0" minHeight="36.0" minWidth="100.0" text="%delete">
                                    <graphic>
                                        <ImageView fitHeight="24.0" fitWidth="24.0" pickOnBounds="true" preserveRatio="true">
                                            <image>
                                                <Image url="@../../images/close.png" />
                                            </image>
                                        </ImageView>
                                    </graphic>
                                </E_Button>
                            </children>
                        </HBox>
                        <E_TextField fx:id="txtCommMemberCode" disable="true" editable="false" visible="false" GridPane.columnIndex="1" GridPane.rowIndex="5" />
                        <E_TextField fx:id="txtCommitteeCode" disable="true" editable="false" visible="false" GridPane.columnIndex="1" />

                    </children>
                </GridPane>
                <HBox>
                    <children>
                        <Label text="%committeememberlist" styleClass="sub-header-text-primary" />
                        <Separator maxHeight="1.7976931348623157E308" HBox.hgrow="ALWAYS" />
                    </children>
                </HBox>
                <TableView fx:id="tableCommitteeMembers" maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308" minHeight="-Infinity" prefHeight="150.0">
                    <columns>
                        <TableColumn fx:id="colMemberName" prefWidth="75.0" text="%member.name" />
                        <TableColumn fx:id="colDesignation" prefWidth="75.0" text="%designation" />
                        <TableColumn fx:id="colJoiningDate" prefWidth="75.0" text="%joiningdate" />
                        <TableColumn fx:id="colRegistrationDate" prefWidth="75.0" text="%registrationdate" />
                        <TableColumn fx:id="colCode" prefWidth="75.0" text="code" visible="false" />
                    </columns>
                    <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                    </columnResizePolicy>
                </TableView>
                <HBox alignment="CENTER_LEFT" prefWidth="200.0" spacing="15">
                    <children>
                        <E_Button fx:id="btnSave" contentDisplay="TOP" graphicTextGap="5.0" prefHeight="50.0" prefWidth="70.0" text="%save">
                            <graphic>
                                <ImageView fitHeight="40.0" fitWidth="40.0" pickOnBounds="true" preserveRatio="true">
                                    <image>
                                        <Image url="@../../images/save.png" />
                                    </image>
                                </ImageView>
                            </graphic>
                        </E_Button>
                        <E_Button fx:id="btnClose" contentDisplay="TOP" graphicTextGap="5.0" prefHeight="50.0" prefWidth="70.0" text="%close">
                            <graphic>
                                <ImageView fitHeight="40.0" fitWidth="40.0" pickOnBounds="true" preserveRatio="true">
                                    <image>
                                        <Image url="@../../images/close.png" />
                                    </image>
                                </ImageView>
                            </graphic>
                        </E_Button>
                        <Label maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308" HBox.hgrow="ALWAYS" />
                        <E_Button fx:id="btnExport" contentDisplay="TOP" graphicTextGap="5.0" prefHeight="50.0" prefWidth="70.0" text="%export">
                            <graphic>
                                <ImageView fitHeight="40.0" fitWidth="40.0" pickOnBounds="true" preserveRatio="true">
                                    <image>
                                        <Image url="@../../images/excel.png" />
                                    </image>
                                </ImageView>
                            </graphic>
                        </E_Button>
                    </children>
                </HBox>
            </children>
            <padding>
                <Insets bottom="25.0" left="25.0" right="25.0" top="25.0" />
            </padding>
        </VBox>
    </children>
<!--    <padding>-->
<!--        <Insets bottom="15.0" left="15.0" right="15.0" top="15.0"/>-->
<!--    </padding>-->
</StackPane>
