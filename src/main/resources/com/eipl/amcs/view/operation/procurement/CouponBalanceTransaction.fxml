<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<StackPane fx:id="root" prefHeight="400.0" prefWidth="600.0" styleClass="pane-center" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.eipl.amcs.operation.procurement.controller.CouponBalanceController">
    <children>
        <VBox prefHeight="200.0" prefWidth="100.0" spacing="15.0" styleClass="pane-white-drop-border">
            <children>
                <HBox prefWidth="600.0" spacing="5.0">
                    <children>
                        <Label styleClass="header-text" text="%couponissue.transaction" HBox.hgrow="ALWAYS">
                            <HBox.margin>
                                <Insets />
                            </HBox.margin>
                        </Label>
                        <Label contentDisplay="RIGHT" prefHeight="31.0" prefWidth="176.0" text=" " />
                        <HBox alignment="TOP_RIGHT" nodeOrientation="LEFT_TO_RIGHT" HBox.hgrow="ALWAYS">
                        </HBox>
                    </children>
               <padding>
                  <Insets left="10.0" />
               </padding>
                </HBox>
                <TableView fx:id="tableIssueCoupon" prefHeight="317.0" prefWidth="600.0" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="colCode" prefWidth="125.0" text="%couponissue.table.consumercode" />
                        <TableColumn fx:id="colName" prefWidth="125.0" text="%couponissue.table.consumername" />
                        <TableColumn fx:id="colMilkType" prefWidth="100.0" text="%couponissue.table.milktype" />
                        <TableColumn fx:id="colBalance" prefWidth="150.0" text="%couponissue.table.couponamount" />
                    </columns>
                </TableView>
                <HBox prefWidth="200.0" spacing="15">
                    <children>
                        <Button fx:id="btnCancel" layoutX="200.0" layoutY="10.0" prefHeight="30.0" prefWidth="80.0" text="%close" />
                    </children>
                    <padding>
                        <Insets bottom="10.0" left="10.0" />
                    </padding>
                </HBox>
            </children>
        </VBox>
    </children>
</StackPane>
