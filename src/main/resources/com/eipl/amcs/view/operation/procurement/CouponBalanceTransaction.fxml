<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane fx:id="root" prefHeight="400.0" prefWidth="600.0" styleClass="pane-center" xmlns="http://javafx.com/javafx/20.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.eipl.amcs.operation.procurement.controller.CouponBalanceController">
    <children>
        <VBox prefHeight="200.0" prefWidth="100.0" spacing="15.0" styleClass="">
            <children>
                <HBox prefWidth="600.0" spacing="5.0">
                    <children>
                        <Label styleClass="header-text" text="%couponissue.transaction" HBox.hgrow="ALWAYS">
                            <HBox.margin>
                                <Insets />
                            </HBox.margin>
                        </Label>
                        <Label contentDisplay="RIGHT" prefHeight="31.0" prefWidth="176.0" text=" " />
                        <HBox alignment="TOP_RIGHT" nodeOrientation="LEFT_TO_RIGHT" HBox.hgrow="ALWAYS">
                        </HBox>
                    </children>
               <padding>
                  <Insets left="10.0" />
               </padding>
                </HBox>
                <TableView fx:id="tableIssueCoupon" prefHeight="317.0" prefWidth="600.0" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="colCode" prefWidth="125.0" text="%couponissue.table.consumercode" />
                        <TableColumn fx:id="colName" prefWidth="125.0" text="%couponissue.table.consumername" />
                        <TableColumn fx:id="colMilkType" prefWidth="100.0" text="%couponissue.table.milktype" />
                        <TableColumn fx:id="colBalance" prefWidth="150.0" text="%couponissue.table.couponamount" />
                    </columns>
                </TableView>
                <HBox prefWidth="200.0" spacing="15">
                    <children>
                  <Button fx:id="btnCancel" contentDisplay="TOP" graphicTextGap="5.0" prefHeight="50.0" prefWidth="70.0" text="%close">
                     <graphic>
                        <ImageView fitHeight="40.0" fitWidth="40.0" pickOnBounds="true" preserveRatio="true">
                           <image>
                              <Image url="@../../images/close.png" />
                           </image>
                        </ImageView>
                     </graphic>
                  </Button>
                    </children>
                    <padding>
                        <Insets bottom="10.0" left="10.0" />
                    </padding>
                </HBox>
            </children>
        </VBox>
    </children>
</StackPane>
