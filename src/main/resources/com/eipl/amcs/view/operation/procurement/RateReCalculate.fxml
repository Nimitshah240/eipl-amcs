<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane fx:id="root" prefHeight="400.0" prefWidth="600.0" styleClass="pane-center" xmlns="http://javafx.com/javafx/11" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.eipl.amcs.operation.procurement.controller.RateRecalculateController">
    <children>
        <VBox prefHeight="200.0" prefWidth="100.0" spacing="15.0">
            <children>
                <HBox alignment="CENTER_RIGHT" prefWidth="200.0" spacing="10.0">
                    <children>
                      <Label styleClass="header-text" text="%raterecalculate" />
                  <Label maxWidth="1.7976931348623157E308" HBox.hgrow="ALWAYS" />
                        <DatePicker fx:id="dpFromDate" prefWidth="120.0" />
                        <ComboBox fx:id="cboxFromShift" editable="true" prefWidth="100.0" />
                        <Label text="%to" />
                        <DatePicker fx:id="dpToDate" prefWidth="120.0" />
                        <ComboBox fx:id="cboxToShift" editable="true" prefWidth="100.0" />
                        <Button fx:id="btnSearch" mnemonicParsing="false" text="%search" />
                    </children>
                </HBox>
                <TableView fx:id="tableCollection" prefHeight="350.0" prefWidth="600.0" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="colSampleNo" prefWidth="125.0" styleClass="cell-center-aligned" text="%sampleno" />
                        <TableColumn fx:id="colMemberCode" prefWidth="100.0" styleClass="cell-center-aligned" text="%membercode" />
                        <TableColumn fx:id="colMemberName" prefWidth="200.0" text="%name" />
                        <TableColumn fx:id="colDate" prefWidth="120.0" styleClass="cell-center-aligned" text="%date" />
                        <TableColumn fx:id="colShift" prefWidth="100.0" styleClass="cell-center-aligned" text="%shift" />
                        <TableColumn fx:id="colMilkType" prefWidth="100.0" styleClass="cell-center-aligned" text="%milktype" />
                        <TableColumn fx:id="colQty" prefWidth="100.0" styleClass="cell-right-aligned" text="%qty" />
                        <TableColumn fx:id="colFat" prefWidth="100.0" styleClass="cell-right-aligned" text="%fat" />
                        <TableColumn fx:id="colSnf" prefWidth="100.0" styleClass="cell-right-aligned" text="%snf" />
                        <TableColumn fx:id="colRate" prefWidth="100.0" styleClass="cell-right-aligned" text="%rate" />
                        <TableColumn fx:id="colAmount" prefWidth="125.0" styleClass="cell-right-aligned" text="%amount" />
                  <TableColumn fx:id="colNewRate" prefWidth="120.0" styleClass="cell-right-aligned" text="%new.rate" />
                  <TableColumn fx:id="colNewAmount" prefWidth="120.0" styleClass="cell-right-aligned" text="%new.amount" />
                    </columns>
                </TableView>
                <HBox prefWidth="200.0" spacing="15">
                    <children>
                        <ComboBox fx:id="cboxRateChart" editable="true" maxWidth="1.7976931348623157E308" prefHeight="25.0" prefWidth="155.0" />
                  <Button fx:id="btnRecalculate" mnemonicParsing="false" text="%recalculation" />
                  <Button fx:id="btnClose" prefHeight="30.0" prefWidth="80.0" text="%close" />
                        <Label maxWidth="1.7976931348623157E308" HBox.hgrow="ALWAYS" />
                        <Button fx:id="btnSubmit" prefHeight="30.0" prefWidth="80.0" text="%save" />
                    </children>
                </HBox>
            </children>
        </VBox>
    </children>
</StackPane>
