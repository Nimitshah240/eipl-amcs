<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane fx:id="root" prefHeight="600.0" prefWidth="800.0" styleClass="pane-center" xmlns="http://javafx.com/javafx/16" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.eipl.amcs.operation.inventory.controller.ProductDispatchController">
    <children>
        <VBox spacing="15.0">
            <children>
                <HBox alignment="CENTER_RIGHT" spacing="10.0">
                    <children>
                        <Label styleClass="header-text" text="%productdispatch" />
                        <Label maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308" HBox.hgrow="ALWAYS" />
                        <DatePicker fx:id="dpFromDate" prefWidth="125.0" />
                        <Label text="%to" />
                        <DatePicker fx:id="dpToDate" prefWidth="125.0" />
                        <Button fx:id="btnSearch" mnemonicParsing="false" text="%search" />
                    </children>
                </HBox>
                <TableView fx:id="tableProductDispatch" prefHeight="350.0" prefWidth="600.0" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="colChallanDate" minWidth="150.0" prefWidth="150.0" styleClass="cell-center-aligned" text="%challandate" />
                        <TableColumn fx:id="colChallanNo" minWidth="150.0" prefWidth="150.0" styleClass="cell-center-aligned" text="%challanno" />
                        <TableColumn fx:id="colStatus" minWidth="150.0" prefWidth="150.0" styleClass="cell-center-aligned" text="%status" />
                        <TableColumn fx:id="colProduct" minWidth="400.0" prefWidth="400.0" styleClass="cell-center-aligned" text="%product" />
                        <TableColumn fx:id="colQty" minWidth="150.0" prefWidth="150.0" styleClass="cell-center-aligned" text="%qty" />
<!--                        <TableColumn fx:id="colRate" prefWidth="120.0" styleClass="cell-center-aligned" text="%rate" />-->
<!--                  <TableColumn fx:id="colAmount" prefWidth="120.0" styleClass="cell-center-aligned" text="%amount" />-->
                    </columns>
                </TableView>
                <HBox prefWidth="200.0" spacing="15.0">
                    <children>
                        <Button fx:id="btnClose" mnemonicParsing="true" prefHeight="30.0" prefWidth="80.0" text="%close" />
                        <Label maxWidth="1.7976931348623157E308" HBox.hgrow="ALWAYS" />
                    </children>
                </HBox>
            </children>
        </VBox>
    </children>
</StackPane>
