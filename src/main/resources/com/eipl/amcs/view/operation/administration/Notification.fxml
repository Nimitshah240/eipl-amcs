<?xml version="1.0" encoding="UTF-8"?>

<?import com.eipl.amcs.controls.E_ComboBox?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane fx:id="root" prefHeight="400.0" prefWidth="600.0" styleClass="pane-center" xmlns="http://javafx.com/javafx/11" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.eipl.amcs.operation.administartion.controller.NotificationController">
    <children>
        <VBox prefHeight="200.0" prefWidth="100.0" spacing="15.0">
            <children>
            <HBox alignment="CENTER_LEFT">
               <children>
                      <Label styleClass="header-text" text="%notification" />
                  <Label maxWidth="1.7976931348623157E308" styleClass="header-text" HBox.hgrow="ALWAYS" />
                  <E_ComboBox fx:id="cbox" maxWidth="1.7976931348623157E308" minWidth="100.0" prefWidth="100.0">
                     <HBox.margin>
                        <Insets right="10.0" top="10.0" />
                     </HBox.margin>
                  </E_ComboBox>
               </children>
            </HBox>
                <TableView fx:id="tableData" prefHeight="350.0" prefWidth="600.0" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="colTitle" prefWidth="100.0" styleClass="cell-center-aligned" text="%title" />
                        <TableColumn fx:id="colMessage" prefWidth="200.0" text="%message" />
                        <TableColumn fx:id="colPeriod" prefWidth="200.0" text="%period" />
                        <TableColumn fx:id="col" prefWidth="200.0" text="%attachment" />
                    </columns>
                </TableView>
                <HBox prefWidth="200.0">
                    <children>
                        <Button fx:id="btnClose" mnemonicParsing="true" prefHeight="30.0" prefWidth="80.0" text="%close" />
                    </children>
                </HBox>
            </children>
        </VBox>
    </children>
</StackPane>
