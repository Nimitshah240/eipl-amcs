<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<StackPane fx:id="root" prefHeight="100.0" prefWidth="600.0" styleClass="pane-center" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.eipl.amcs.operation.procurement.controller.MilkDispatchReportController">
    <children>
        <VBox maxHeight="150.0" minHeight="150.0" prefHeight="150.0" prefWidth="622.0" spacing="15.0" styleClass="">
            <children>
                <Label styleClass="header-text" text="%milkdispatch" />
                <GridPane hgap="8.0">
                    <columnConstraints>
                        <ColumnConstraints hgrow="SOMETIMES" maxWidth="1.7976931348623157E308" percentWidth="75.0" />
                  <ColumnConstraints halignment="RIGHT" hgrow="SOMETIMES" maxWidth="1.7976931348623157E308" minWidth="10.0" percentWidth="50.0" prefWidth="100.0" />
                        <ColumnConstraints halignment="RIGHT" hgrow="SOMETIMES" maxWidth="1.7976931348623157E308" percentWidth="50.0" />
                  <ColumnConstraints />
                    </columnConstraints>
                    <rowConstraints>
                        <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
                        <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
                    </rowConstraints>
                    <children>
                  <ComboBox fx:id="cboxLanguage" editable="true" prefHeight="25.0" prefWidth="162.0" GridPane.columnIndex="1" GridPane.rowIndex="1" />

                        <Label text="%format" />
                        <ComboBox fx:id="cboxFormat" editable="true" maxWidth="1.7976931348623157E308" GridPane.rowIndex="1" />
                  <HBox alignment="CENTER_RIGHT" spacing="5.0" GridPane.columnIndex="2" GridPane.columnSpan="2" GridPane.halignment="RIGHT" GridPane.hgrow="ALWAYS" GridPane.rowIndex="1">
                     <children>
                              <Button fx:id="btnGenerate" mnemonicParsing="true" styleClass="button-primary" text="%generate" />
                        <Button fx:id="btnClose" mnemonicParsing="true" prefHeight="25.0" prefWidth="64.0" styleClass="button-primary" text="%close" />
                     </children>
                  </HBox>
                  <Label prefHeight="17.0" prefWidth="177.0" text="%language" GridPane.columnIndex="1" />


                    </children>
                </GridPane>
            </children>
         <padding>
            <Insets bottom="15.0" left="15.0" right="15.0" top="15.0" />
         </padding>
        </VBox>
    </children>
</StackPane>
