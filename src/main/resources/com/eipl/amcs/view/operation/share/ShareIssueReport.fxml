<?xml version="1.0" encoding="UTF-8"?>

<?import com.eipl.amcs.controls.E_DatePicker?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.RowConstraints?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane fx:id="root" prefHeight="150.0" prefWidth="600.0" styleClass="pane-center" xmlns="http://javafx.com/javafx/18" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.eipl.amcs.operation.share.controller.ShareIssueReportController">
    <children>
        <VBox maxHeight="150.0" minHeight="150.0" prefHeight="150.0" prefWidth="622.0" spacing="15.0" styleClass="pane-white-drop-border">
            <children>
                <Label styleClass="header-text" text="%shareissue" />
                <GridPane hgap="8.0" vgap="5.0">
                    <columnConstraints>
                  <ColumnConstraints hgrow="SOMETIMES" maxWidth="1.7976931348623157E308" percentWidth="36.0" />
                  <ColumnConstraints hgrow="SOMETIMES" maxWidth="1.7976931348623157E308" minWidth="10.0" percentWidth="36.0" prefWidth="100.0" />
                  <ColumnConstraints hgrow="SOMETIMES" maxWidth="1.7976931348623157E308" minWidth="10.0" percentWidth="36.0" prefWidth="100.0" />
                  <ColumnConstraints hgrow="SOMETIMES" maxWidth="1.7976931348623157E308" minWidth="10.0" percentWidth="24.0" prefWidth="100.0" />
                  <ColumnConstraints hgrow="SOMETIMES" maxWidth="1.7976931348623157E308" minWidth="10.0" percentWidth="24.0" prefWidth="100.0" />
                    </columnConstraints>
                    <rowConstraints>
                        <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
                  <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
                  <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
                    </rowConstraints>
                    <children>
                  <HBox alignment="CENTER_RIGHT" prefHeight="26.0" prefWidth="100.0" spacing="5.0" GridPane.columnIndex="3" GridPane.halignment="RIGHT" GridPane.hgrow="ALWAYS" GridPane.rowIndex="1">
                     <children>
                              <Button fx:id="btnGenerate" mnemonicParsing="true" styleClass="button-primary" text="%generate" />
                     </children>
                  </HBox>
                  <E_DatePicker fx:id="dpFromDate" maxWidth="1.7976931348623157E308" GridPane.rowIndex="1" />
                  <E_DatePicker fx:id="dpToDate" maxWidth="1.7976931348623157E308" prefHeight="25.0" prefWidth="113.0" GridPane.columnIndex="1" GridPane.rowIndex="1" />
                  <Label text="%fromdate" />
                  <Label text="%todate" GridPane.columnIndex="1" />
                  <ComboBox fx:id="cboxFormat" editable="true" prefWidth="150.0" GridPane.columnIndex="2" GridPane.rowIndex="1" />
                  <Label text="%format" GridPane.columnIndex="2" />
                  <Button fx:id="btnClose" contentDisplay="CENTER" mnemonicParsing="true" prefHeight="30.0" prefWidth="80.0" styleClass="button-primary" text="%close" GridPane.columnIndex="4" GridPane.rowIndex="1" />


                    </children>
                </GridPane>
            </children>
         <padding>
            <Insets bottom="15.0" left="15.0" right="15.0" top="15.0" />
         </padding>
        </VBox>
    </children>
</StackPane>
