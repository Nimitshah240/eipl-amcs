                                                                            </image>
                                                                        </ImageView>
                                                                    </graphic>
                                                                </E_Button>
                                                            </children>
                                                        </HBox>
                                                    </children>
                                                </GridPane>
                                                <TableView fx:id="tableBmcChillerInfo" prefHeight="200.0" prefWidth="200.0">
                                                    <columns>
                                                        <TableColumn fx:id="colBmcFacilator" prefWidth="75.0" text="%bmcfacilator" />
                                                        <TableColumn fx:id="colBcuCapacity" prefWidth="75.0" text="%bcucapacity" />
                                                        <TableColumn fx:id="colOwnerName" prefWidth="75.0" text="%ownername" />
                                                        <TableColumn fx:id="colAgreementPeriod" prefWidth="75.0" text="%agreementperiod" />
                                                        <TableColumn fx:id="colAgreementFromDate" prefWidth="75.0" text="%agreementfromdate" />
                                                        <TableColumn fx:id="colAgreementToDate" prefWidth="75.0" text="%agreementtodate" />
                                                    </columns>
                                                    <columnResizePolicy>
                                                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                                                    </columnResizePolicy>
                                                </TableView>
                                            </children>
                                        </VBox>
                                    </children>
                                </AnchorPane>
                            </content>
                        </Tab>
                    </tabs>
                </TabPane>
                <Separator prefWidth="200.0" />
                <HBox prefWidth="200.0" spacing="5.0">
                    <children>
                        <Button fx:id="btnSave" contentDisplay="TOP" graphicTextGap="5.0" prefHeight="50.0" prefWidth="70.0" text="%save">
                            <graphic>
                                <ImageView fitHeight="40.0" fitWidth="40.0" pickOnBounds="true" preserveRatio="true">
                                    <image>
                                        <Image url="@../../images/save.png" />
                                    </image>
                                </ImageView>
                            </graphic>
                        </Button>
                        <Button fx:id="btnClose" contentDisplay="TOP" graphicTextGap="5.0" prefHeight="50.0" prefWidth="70.0" text="%close">
                            <graphic>
                                <ImageView fitHeight="40.0" fitWidth="40.0" pickOnBounds="true" preserveRatio="true">
                                    <image>
                                        <Image url="@../../images/close.png" />
                                    </image>
                                </ImageView>
                            </graphic>
                        </Button>
                    </children>
                    <padding>
                        <Insets bottom="5.0" left="5.0" />
                    </padding>
                </HBox>
            </children>
        </VBox>
    </children>
</StackPane>
