<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<StackPane fx:id="root" prefHeight="400.0" prefWidth="600.0" styleClass="pane-center" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.eipl.amcs.master.operation.controller.BillCriteriaController">
    <children>
        <VBox prefHeight="200.0" prefWidth="100.0" spacing="15.0">
            <children>
                <Label fx:id="btnBillCriteria" styleClass="header-text" text="%billcriteria" />
                <TableView fx:id="tableBillCriteria" prefHeight="350.0" prefWidth="600.0" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="colCode" prefWidth="100.0" styleClass="cell-center-aligned" text="%code" />
                        <TableColumn fx:id="colCriteria" prefWidth="200.0" text="%criteria" />
                        <TableColumn fx:id="colFormula" prefWidth="200.0" text="%formula" />
                        <TableColumn fx:id="colBillHead" prefWidth="200.0" text="%billhead" />
                        <TableColumn fx:id="colStatus" prefWidth="100.0" styleClass="cell-center-aligned" text="%status" />
                  <TableColumn fx:id="colStartDate" prefWidth="100.0" styleClass="cell-center-aligned" text="%startdate" />
                  <TableColumn fx:id="colEndDate" prefWidth="100.0" styleClass="cell-center-aligned" text="%enddate" />
                    </columns>
                </TableView>
                <HBox alignment="CENTER_LEFT" spacing="15.0">
                    <children>
                        <Button fx:id="btnAdd" mnemonicParsing="true" prefHeight="30.0" prefWidth="80.0" text="%add" />
                        <Button fx:id="btnEdit" disable="true" layoutX="10.0" layoutY="10.0" mnemonicParsing="true" prefHeight="30.0" prefWidth="80.0" text="%edit" />
                        <Button fx:id="btnDelete" disable="true" layoutX="90.0" layoutY="10.0" mnemonicParsing="true" prefHeight="30.0" prefWidth="80.0" text="%delete" />
                        <Button fx:id="btnClose" layoutX="170.0" layoutY="10.0" mnemonicParsing="true" prefHeight="30.0" prefWidth="80.0" text="%close" />
                    </children>
                </HBox>
            </children>
        </VBox>
    </children>
</StackPane>
