<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane fx:id="root" prefHeight="400.0" prefWidth="600.0" styleClass="pane-center" xmlns="http://javafx.com/javafx/11" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.eipl.amcs.master.org.controller.RouteController">
    <children>
        <VBox prefHeight="200.0" prefWidth="100.0" spacing="15.0">
            <children>
                <Label styleClass="header-text" text="%route" />
                <TableView fx:id="tableRoute" editable="true" prefHeight="350.0" prefWidth="600.0" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="colCode" prefWidth="100.0" styleClass="cell-center-aligned" text="%code" />
                        <TableColumn fx:id="colCodeEx" prefWidth="120.0" styleClass="cell-center-aligned" text="%codeex" />
                        <TableColumn fx:id="colBmc" prefWidth="200.0" text="%bmc" />
                        <TableColumn fx:id="colName" prefWidth="200.0" text="%name" />
                        <TableColumn fx:id="colLocalName" prefWidth="200.0" text="%localname" />
                        <TableColumn fx:id="colCapacity" prefWidth="120.0" styleClass="cell-center-aligned" text="%capacity" />
                        <TableColumn fx:id="colLengthKms" prefWidth="120.0" styleClass="cell-center-aligned" text="%lengthkms" />
                        <TableColumn fx:id="colStartTime" prefWidth="120.0" styleClass="cell-center-aligned" text="%starttime" />
                        <TableColumn fx:id="colReturnTime" prefWidth="120.0" styleClass="cell-center-aligned" text="%returntime" />
                    </columns>
                </TableView>
                <HBox prefWidth="200.0" spacing="5.0">
                    <children>
                        <Button fx:id="btnSave" mnemonicParsing="true" prefHeight="30.0" prefWidth="80.0" text="%update" />
                        <Button fx:id="btnClose" mnemonicParsing="true" prefHeight="30.0" prefWidth="80.0" text="%close" />
                    </children>
                </HBox>
            </children>
        </VBox>
    </children>
</StackPane>
