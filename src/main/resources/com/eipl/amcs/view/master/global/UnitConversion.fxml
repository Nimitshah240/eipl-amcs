<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.HBox?>

<StackPane xmlns:fx="http://javafx.com/fxml/1" fx:id="root" prefHeight="400.0" prefWidth="600.0"
           styleClass="pane-center" xmlns="http://javafx.com/javafx/11"
           fx:controller="com.eipl.amcs.master.global.controller.UnitConversionController">
    <children>
        <VBox prefHeight="200.0" prefWidth="100.0" spacing="15.0">
            <children>
                <Label styleClass="header-text" text="%unitconversion"/>
                <TableView fx:id="tableUnitConversions" prefHeight="350.0" prefWidth="600.0" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="colCode" prefWidth="75.0" styleClass="cell-center-aligned"
                                     text="%code"/>
                        <TableColumn fx:id="colFromUnit" prefWidth="200.0" text="%fromunit"/>
                        <TableColumn fx:id="colToUnit" prefWidth="200.0" text="%tounit"/>
                        <TableColumn fx:id="colConversionFactor" prefWidth="150.0" text="%conversionfactor"
                                     styleClass="cell-right-aligned"/>
                    </columns>
                </TableView>
                <HBox prefWidth="200.0">
                    <children>
                        <Button fx:id="btnClose" mnemonicParsing="true" prefHeight="30.0" prefWidth="80.0"
                                text="%close"/>
                    </children>
                </HBox>
            </children>
        </VBox>
    </children>
</StackPane>
