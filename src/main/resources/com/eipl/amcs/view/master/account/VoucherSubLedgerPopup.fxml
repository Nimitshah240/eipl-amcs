<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane fx:id="root" prefWidth="700.0" xmlns="http://javafx.com/javafx/16" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.eipl.amcs.master.account.controller.VoucherSubLedgerPopupController">
    <children>
        <VBox spacing="20.0" styleClass="pane-white-drop-border">
            <children>
                <Label styleClass="header-text" text="%subledger" />
                <TableView fx:id="tableData" focusTraversable="false" prefHeight="200.0" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="colCode" minWidth="100.0" prefWidth="120.0" styleClass="cell-center-aligned" text="%code" />
                        <TableColumn fx:id="colSubLedger" minWidth="100.0" prefWidth="100.0" styleClass="cell-center-aligned" text="%subledger" />
                        <TableColumn fx:id="colAmount" minWidth="100.0" prefWidth="120.0" styleClass="cell-center-aligned" text="%amount" />
                    </columns>
                    <VBox.margin>
                        <Insets />
                    </VBox.margin>
               <columnResizePolicy>
                  <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
               </columnResizePolicy>
                </TableView>
                <HBox alignment="CENTER_RIGHT" prefWidth="200.0" spacing="15">
                    <children>
                        <Button fx:id="btnClose" mnemonicParsing="true" prefHeight="30.0" prefWidth="80.0" text="%close" />
                    </children>
                </HBox>
            </children>
            <padding>
                <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
            </padding>
        </VBox>
    </children>
    <padding>
        <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
    </padding>
</StackPane>
