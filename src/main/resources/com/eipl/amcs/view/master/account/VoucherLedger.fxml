<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane fx:id="root" prefHeight="400.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/18" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.eipl.amcs.master.account.controller.VoucherLedgerController">
    <children>
        <VBox spacing="10.0">
            <children>
                <Label styleClass="header-text" text="%ledger" />
            <AnchorPane maxWidth="1.7976931348623157E308" prefWidth="600.0" VBox.vgrow="ALWAYS">
               <children>
                  <HBox maxWidth="1.7976931348623157E308" spacing="5.0" AnchorPane.bottomAnchor="5.0" AnchorPane.leftAnchor="5.0" AnchorPane.rightAnchor="5.0" AnchorPane.topAnchor="5.0">
                     <children>
                        <TableView fx:id="table2" focusTraversable="false" maxWidth="1.7976931348623157E308" HBox.hgrow="ALWAYS">
                           <columns>
                              <TableColumn fx:id="colName1" maxWidth="-1.0" minWidth="200.0" prefWidth="200.0" text="%name" />
                              <TableColumn fx:id="colAmount1" minWidth="100.0" prefWidth="160.0" styleClass="cell-center-aligned" text="%amount" />
                              <TableColumn fx:id="colType1" minWidth="100.0" prefWidth="160.0" styleClass="cell-center-aligned" text="%type" />
                           </columns>
                        </TableView>
                            <TableView fx:id="table1" focusTraversable="false" maxWidth="1.7976931348623157E308" HBox.hgrow="ALWAYS">
                                <columns>
                                    <TableColumn fx:id="colName" maxWidth="-1.0" minWidth="200.0" prefWidth="200.0" text="%name" />
                                    <TableColumn fx:id="colAmount" minWidth="100.0" prefWidth="160.0" styleClass="cell-center-aligned" text="%amount" />
                              <TableColumn fx:id="colType" minWidth="100.0" prefWidth="160.0" styleClass="cell-center-aligned" text="%type" />
                                </columns>
                            </TableView>
                     </children>
                  </HBox>
               </children>
            </AnchorPane>
                <HBox alignment="CENTER_RIGHT" prefWidth="200.0" spacing="15">
                    <children>
                        <Button fx:id="btnSubLedger" mnemonicParsing="true" prefHeight="30.0" text="%subledger" />
                        <Button fx:id="btnClose" mnemonicParsing="true" prefHeight="30.0" prefWidth="80.0" text="%close" />
                    </children>
                </HBox>
            </children>
            <padding>
                <Insets bottom="5.0" left="5.0" right="5.0" top="5.0" />
            </padding>
         <StackPane.margin>
            <Insets bottom="5.0" left="5.0" right="5.0" top="5.0" />
         </StackPane.margin>
        </VBox>
    </children>
    <padding>
        <Insets bottom="15.0" left="15.0" right="15.0" top="15.0" />
    </padding>
</StackPane>
