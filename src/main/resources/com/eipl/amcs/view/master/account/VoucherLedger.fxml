<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane fx:id="root" prefHeight="400.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/20.0.1"
           xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="com.eipl.amcs.master.account.controller.VoucherLedgerController">
    <children>
        <VBox spacing="10.0">
            <children>
                <Label styleClass="header-text" text="%ledger"/>
                <AnchorPane maxWidth="1.7976931348623157E308" prefWidth="600.0" VBox.vgrow="ALWAYS">
                    <children>
                        <HBox maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308" spacing="5.0"
                              AnchorPane.bottomAnchor="5.0" AnchorPane.leftAnchor="5.0" AnchorPane.rightAnchor="5.0"
                              AnchorPane.topAnchor="5.0">
                            <children>
                                <TableView fx:id="tblVoucherLedger" HBox.hgrow="ALWAYS">
                                    <columns>
                                        <TableColumn fx:id="colLedgerCode" prefWidth="30.0" text="%ledgercode"/>
                                        <TableColumn fx:id="colLedgerName" prefWidth="75.0" text="%ledgername"/>
                                        <TableColumn fx:id="colNarration" prefWidth="75.0"
                                                     styleClass="cell-center-aligned" text="%narration"/>
                                        <TableColumn fx:id="colType" prefWidth="75.0" styleClass="cell-center-aligned"
                                                     text="%type"/>
                                        <TableColumn fx:id="colAmountCredit" prefWidth="75.0"
                                                     styleClass="cell-center-aligned" text="%credit"/>
                                        <TableColumn fx:id="colAmountDebit" prefWidth="75.0"
                                                     styleClass="cell-center-aligned" text="%debit"/>
                                    </columns>
                                    <columnResizePolicy>
                                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                                    </columnResizePolicy>
                                </TableView>
                            </children>
                        </HBox>
                    </children>
                </AnchorPane>
                <HBox alignment="CENTER_RIGHT" prefWidth="200.0" spacing="15">
                    <children>
                        <Button fx:id="btnSubLedger" contentDisplay="TOP" mnemonicParsing="true" prefHeight="30.0"
                                text="%subledger">
                            <graphic>
                                <ImageView fitHeight="40.0" fitWidth="40.0" pickOnBounds="true" preserveRatio="true">
                                    <image>
                                        <Image url="@../../images/ledger.png"/>
                                    </image>
                                </ImageView>
                            </graphic>
                        </Button>
                        <Button fx:id="btnClose" contentDisplay="TOP" graphicTextGap="5.0" mnemonicParsing="true"
                                prefHeight="30.0" prefWidth="80.0" text="%close">
                            <graphic>
                                <ImageView fitHeight="40.0" fitWidth="40.0" pickOnBounds="true" preserveRatio="true">
                                    <image>
                                        <Image url="@../../images/close.png"/>
                                    </image>
                                </ImageView>
                            </graphic>
                        </Button>
                    </children>
                </HBox>
            </children>
            <padding>
                <Insets bottom="5.0" left="5.0" right="5.0" top="5.0"/>
            </padding>
            <StackPane.margin>
                <Insets bottom="5.0" left="5.0" right="5.0" top="5.0"/>
            </StackPane.margin>
        </VBox>
    </children>
    <padding>
        <Insets bottom="15.0" left="15.0" right="15.0" top="15.0"/>
    </padding>
</StackPane>
