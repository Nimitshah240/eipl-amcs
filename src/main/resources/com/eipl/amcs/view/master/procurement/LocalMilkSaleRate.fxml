<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane fx:id="root" prefHeight="400.0" prefWidth="600.0" styleClass="pane-center"
           xmlns="http://javafx.com/javafx/11" xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="com.eipl.amcs.master.procurement.controller.LocalMilkSaleRateController">
    <children>
        <VBox prefHeight="200.0" prefWidth="100.0" spacing="15.0">
            <children>
                <Label styleClass="header-text" text="%localmilksalerate"/>
                <TableView fx:id="tableLocalMilkSaleRates" prefHeight="350.0" prefWidth="600.0" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="colWefDate" prefWidth="100.0" styleClass="cell-center-aligned"
                                     text="%wefdate"/>
                        <TableColumn fx:id="colMilkType" prefWidth="125.0" text="%milktype"/>
                        <TableColumn fx:id="colMilkClass" prefWidth="125.0" text="%milkclass"
                                     styleClass="cell-center-aligned"/>
                        <TableColumn fx:id="colRate" prefWidth="100.0" text="%rate" styleClass="cell-right-aligned"/>
                    </columns>
                </TableView>
                <HBox prefWidth="200.0" spacing="15">
                    <children>
                        <Button fx:id="btnAdd" mnemonicParsing="true" prefHeight="30.0" prefWidth="80.0"
                                styleClass="button-primary" text="%add"/>
                        <Button fx:id="btnDelete" mnemonicParsing="true" prefHeight="30.0" prefWidth="80.0"
                                text="%delete"/>
                        <Button fx:id="btnClose" mnemonicParsing="true" prefHeight="30.0" prefWidth="80.0"
                                text="%close"/>
                    </children>
                </HBox>
            </children>
        </VBox>
    </children>
</StackPane>
