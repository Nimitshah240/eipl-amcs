<?xml version="1.0" encoding="UTF-8"?>

<?import com.eipl.amcs.controls.E_Button?>
<?import com.eipl.amcs.controls.E_DatePicker?>
<?import com.eipl.amcs.controls.E_TextField?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.RowConstraints?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane fx:id="root" prefWidth="600.0" xmlns="http://javafx.com/javafx/20.0.1" xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="com.eipl.amcs.master.operation.controller.BillCriteriaAddEditController">
    <children>
        <VBox prefHeight="200.0" prefWidth="100.0" spacing="20.0" styleClass="">
            <children>
                <Label styleClass="header-text" text="%billcriteria"/>
                <GridPane fx:id="grid" hgap="15.0" prefWidth="395.0">
                    <columnConstraints>
                        <ColumnConstraints/>
                        <ColumnConstraints/>
                        <ColumnConstraints hgrow="ALWAYS"/>
                    </columnConstraints>
                    <rowConstraints>
                        <RowConstraints minHeight="30.0" prefHeight="30.0" vgrow="SOMETIMES"/>
                        <RowConstraints minHeight="30.0" prefHeight="30.0" vgrow="SOMETIMES"/>
                        <RowConstraints minHeight="30.0" prefHeight="30.0" vgrow="SOMETIMES"/>
                        <RowConstraints minHeight="30.0" prefHeight="30.0" vgrow="SOMETIMES"/>
                        <RowConstraints minHeight="30.0" prefHeight="30.0" vgrow="SOMETIMES"/>
                        <RowConstraints minHeight="30.0" prefHeight="30.0" vgrow="SOMETIMES"/>
                    </rowConstraints>
                    <children>
                        <Label maxWidth="1.7976931348623157E308" text="%name" GridPane.columnIndex="1"/>
                        <Label text="%startdate" GridPane.rowIndex="2"/>
                        <Label text="%status" GridPane.columnIndex="2" GridPane.rowIndex="4"/>
                        <Label text="%enddate" GridPane.columnIndex="1" GridPane.rowIndex="2"/>
                        <E_TextField fx:id="txtName" maxHeight="1.7976931348623157E308"
                                     maxWidth="1.7976931348623157E308" GridPane.columnIndex="1" GridPane.columnSpan="2"
                                     GridPane.rowIndex="1"/>
                        <ComboBox fx:id="cboxBillHead" editable="true" maxHeight="1.7976931348623157E308"
                                  maxWidth="1.7976931348623157E308" GridPane.columnSpan="2" GridPane.rowIndex="5"/>
                        <E_TextField fx:id="txtCode" disable="true" maxHeight="1.7976931348623157E308"
                                     maxWidth="1.7976931348623157E308" GridPane.rowIndex="1"/>
                        <Label maxWidth="1.7976931348623157E308" text="%code"/>
                        <E_DatePicker fx:id="dpStartDate" GridPane.rowIndex="3"/>
                        <E_DatePicker fx:id="dpEndDate" GridPane.columnIndex="1" GridPane.rowIndex="3"/>
                        <Label text="%billhead" GridPane.rowIndex="4"/>
                        <HBox alignment="CENTER_RIGHT" prefWidth="200.0" spacing="15" GridPane.columnIndex="2"
                              GridPane.rowIndex="5">
                            <children>
                                <CheckBox fx:id="chkStatus" maxHeight="1.7976931348623157E308" mnemonicParsing="false"/>
                                <Label maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308"
                                       HBox.hgrow="ALWAYS"/>
                                <Label/>
                                <E_Button fx:id="btnSaveUpdate" contentDisplay="TOP" graphicTextGap="5.0"
                                          mnemonicParsing="true" prefHeight="25.0" prefWidth="76.0" text="%save">
                                    <graphic>
                                        <ImageView fitHeight="40.0" fitWidth="40.0" pickOnBounds="true"
                                                   preserveRatio="true">
                                            <image>
                                                <Image url="@../../images/save.png"/>
                                            </image>
                                        </ImageView>
                                    </graphic>
                                </E_Button>
                                <E_Button fx:id="btnClose" contentDisplay="TOP" graphicTextGap="5.0"
                                          mnemonicParsing="true" prefHeight="30.0" prefWidth="80.0" text="%close">
                                    <graphic>
                                        <ImageView fitHeight="40.0" fitWidth="40.0" pickOnBounds="true"
                                                   preserveRatio="true">
                                            <image>
                                                <Image url="@../../images/close.png"/>
                                            </image>
                                        </ImageView>
                                    </graphic>
                                </E_Button>
                            </children>
                        </HBox>
                        <ComboBox fx:id="cboxFormula" editable="true" maxHeight="1.7976931348623157E308"
                                  maxWidth="1.7976931348623157E308" GridPane.columnIndex="2" GridPane.rowIndex="3"/>
                        <Label text="%formula" GridPane.columnIndex="2" GridPane.rowIndex="2"/>
                    </children>
                </GridPane>
            </children>
            <padding>
                <Insets bottom="25.0" left="25.0" right="25.0" top="25.0"/>
            </padding>
        </VBox>
    </children>
    <padding>
        <Insets bottom="15.0" left="15.0" right="15.0" top="15.0"/>
    </padding>
</StackPane>
