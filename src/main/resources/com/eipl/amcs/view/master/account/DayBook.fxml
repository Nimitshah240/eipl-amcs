<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<StackPane fx:id="root" prefHeight="400.0" prefWidth="700.0" styleClass="pane-center" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.eipl.amcs.master.account.controller.DayBookController">
    <children>
        <VBox spacing="15.0">
            <children>
            <HBox alignment="TOP_RIGHT" VBox.vgrow="NEVER">
               <children>
                      <Label maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308" styleClass="header-text" text="%daybook" HBox.hgrow="ALWAYS" />
                  <Label maxWidth="1.7976931348623157E308" styleClass="header-text" HBox.hgrow="ALWAYS" />
                  <GridPane alignment="TOP_RIGHT" hgap="10.0" vgap="5.0">
                     <columnConstraints>
                        <ColumnConstraints minWidth="10.0" />
                        <ColumnConstraints minWidth="10.0" />
                        <ColumnConstraints minWidth="10.0" />
                     </columnConstraints>
                     <rowConstraints>
                        <RowConstraints minHeight="10.0" vgrow="SOMETIMES" />
                        <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
                     </rowConstraints>
                     <children>
                              <Label text="%fromdate" />
                              <DatePicker fx:id="dpFromdate" prefWidth="125.0" GridPane.rowIndex="1" />
                              <Button fx:id="btnSearch" mnemonicParsing="false" text="%search" GridPane.columnIndex="2" GridPane.rowIndex="1" />
                        <Label text="%todate" GridPane.columnIndex="1" />
                        <DatePicker fx:id="dpToDate" prefWidth="125.0" GridPane.columnIndex="1" GridPane.rowIndex="1" />
                     </children>
                  </GridPane>
               </children>
            </HBox>
                <TableView fx:id="tableDayBook" prefHeight="350.0" prefWidth="600.0" VBox.vgrow="ALWAYS">
                    <columns>
<!--                        <TableColumn fx:id="colSelect" prefWidth="50.0" text="#" />-->
                        <TableColumn fx:id="colVoucherdate" prefWidth="80.0" styleClass="cell-center-aligned" text="%voucherdate" />
                        <TableColumn fx:id="colVoucherNo" prefWidth="150.0" text="%voucherno" />
                        <TableColumn fx:id="colVoucherType" prefWidth="100.0" styleClass="cell-right-aligned" text="%vouchertype" />
                        <TableColumn fx:id="colLedgerName" prefWidth="100.0" styleClass="cell-right-aligned" text="%ledgername" />
                        <TableColumn fx:id="colCredit" prefWidth="100.0" styleClass="cell-right-aligned" text="%credit" />
                        <TableColumn fx:id="colDebit" prefWidth="100.0" styleClass="cell-right-aligned" text="%debit" />
                    </columns>
               <columnResizePolicy>
                  <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
               </columnResizePolicy>
                </TableView>
                <HBox prefWidth="200.0" spacing="15.0">
                    <children>
                        <Button fx:id="btnClose" mnemonicParsing="true" prefHeight="30.0" prefWidth="80.0" text="%close" />
                        <Label maxWidth="1.7976931348623157E308" HBox.hgrow="ALWAYS" />
<!--                        <Button fx:id="btnExport" mnemonicParsing="true" prefHeight="30.0" prefWidth="80.0" text="%export" />-->
                    </children>
               <padding>
                  <Insets bottom="5.0" />
               </padding>
                </HBox>
            </children>
        </VBox>
    </children>
</StackPane>
