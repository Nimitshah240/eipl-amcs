<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane fx:id="root" prefHeight="400.0" prefWidth="600.0" styleClass="pane-center" xmlns="http://javafx.com/javafx/11" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.eipl.amcs.master.procurement.controller.MemberMilkPurchaseRateController">
    <children>
        <VBox prefHeight="200.0" prefWidth="100.0" spacing="15.0">
            <children>
                <Label styleClass="header-text" text="%membermilkpurchaserate" />
                <TableView fx:id="tableMemberMilkPurchaseRates" prefHeight="350.0" prefWidth="600.0" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="colCode" prefWidth="100.0" styleClass="cell-center-aligned" text="%code" />
                        <TableColumn fx:id="colRateGenMethodCode" prefWidth="150.0" styleClass="cell-center-aligned" text="%rategenmethod" />
                        <TableColumn fx:id="colRateType" prefWidth="150.0" styleClass="cell-center-aligned" text="%ratetype" />
                        <TableColumn fx:id="colWefDate" prefWidth="150.0" styleClass="cell-center-aligned" text="%wefdate" />
                        <TableColumn fx:id="colShift" prefWidth="120.0" text="%shift" />
                        <TableColumn fx:id="colShiftApplicable" prefWidth="150.0" text="%shiftapplicable" />
                        <TableColumn fx:id="colDescription" prefWidth="200.0" text="%description" />
                    </columns>
                </TableView>
                <HBox prefWidth="200.0" spacing="15">
                    <children>
                        <Button fx:id="btnAdd" mnemonicParsing="true" prefHeight="30.0" prefWidth="80.0" styleClass="button-primary" text="%add" />
                        <Button fx:id="btnClose" mnemonicParsing="true" prefHeight="30.0" prefWidth="80.0" text="%close" />
                        <Label maxWidth="1.7976931348623157E308" HBox.hgrow="ALWAYS" />
                        <Button fx:id="btnSync" mnemonicParsing="true" prefHeight="30.0" prefWidth="80.0" text="%sync" />
                  <Button fx:id="btnView" disable="true" mnemonicParsing="true" prefHeight="30.0" prefWidth="80.0" text="%view" />
                    </children>
                </HBox>
            </children>
        </VBox>
    </children>
</StackPane>
