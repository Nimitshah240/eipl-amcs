<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.RowConstraints?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane fx:id="root" prefWidth="700.0" xmlns="http://javafx.com/javafx/11" xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="com.eipl.amcs.master.procurement.controller.SocietyPaymentCycleGenerateController">
    <children>
        <VBox spacing="20.0" styleClass="">
            <children>
                <Label styleClass="header-text" text="%societypaymentcycle"/>
                <GridPane fx:id="grid" hgap="15.0">
                    <columnConstraints>
                        <ColumnConstraints hgrow="SOMETIMES" maxWidth="121.0" minWidth="-Infinity" percentWidth="25.0"
                                           prefWidth="121.0"/>
                        <ColumnConstraints hgrow="SOMETIMES" maxWidth="-Infinity" minWidth="-Infinity"
                                           percentWidth="25.0"/>
                        <ColumnConstraints hgrow="SOMETIMES" maxWidth="213.0" minWidth="10.0" percentWidth="25.0"
                                           prefWidth="213.0"/>
                        <ColumnConstraints hgrow="SOMETIMES" maxWidth="137.0" minWidth="10.0" percentWidth="25.0"
                                           prefWidth="72.0"/>
                    </columnConstraints>
                    <rowConstraints>
                        <RowConstraints minHeight="25.0" vgrow="SOMETIMES"/>
                        <RowConstraints minHeight="25.0" vgrow="SOMETIMES"/>
                        <RowConstraints minHeight="25.0" vgrow="SOMETIMES"/>
                        <RowConstraints minHeight="25.0" vgrow="SOMETIMES"/>
                    </rowConstraints>
                    <children>
                        <Label text="%interval" GridPane.rowIndex="2"/>
                        <Label text="%fromshift" GridPane.columnIndex="1"/>
                        <Label text="%todate" GridPane.columnIndex="2"/>
                        <DatePicker fx:id="dpFromDate" maxWidth="1.7976931348623157E308" GridPane.rowIndex="1"/>
                        <ComboBox fx:id="cboxFromShift" editable="true" maxWidth="1.7976931348623157E308"
                                  GridPane.columnIndex="1" GridPane.rowIndex="1"/>
                        <DatePicker fx:id="dpToDate" maxWidth="1.7976931348623157E308" GridPane.columnIndex="2"
                                    GridPane.rowIndex="1"/>
                        <ComboBox fx:id="cboxToShift" editable="true" maxWidth="1.7976931348623157E308"
                                  prefWidth="150.0" GridPane.columnIndex="3" GridPane.rowIndex="1"/>
                        <TextField fx:id="txtInterval" GridPane.rowIndex="3"/>
                        <CheckBox fx:id="chkCheckMonth" disable="true" mnemonicParsing="false" text="%checkmonth"
                                  GridPane.columnIndex="1" GridPane.rowIndex="3"/>
                        <Label text="%toshift" GridPane.columnIndex="3"/>
                        <Label text="%fromdate"/>
                        <Button fx:id="btnGenerate" mnemonicParsing="false" styleClass="button-primary" text="%generate"
                                GridPane.columnIndex="3" GridPane.halignment="RIGHT" GridPane.rowIndex="3"/>
                    </children>
                </GridPane>
                <TableView fx:id="tablePaymentCycle" focusTraversable="false" prefHeight="200.0" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="colFromDate" minWidth="100.0" prefWidth="120.0" text="%fromdate"
                                     styleClass="cell-center-aligned"/>
                        <TableColumn fx:id="colFromShift" minWidth="100.0" prefWidth="100.0" text="%fromshift"
                                     styleClass="cell-center-aligned"/>
                        <TableColumn fx:id="colToDate" minWidth="100.0" prefWidth="120.0" text="%todate"
                                     styleClass="cell-center-aligned"/>
                        <TableColumn fx:id="colToShift" minWidth="100.0" prefWidth="100.0" text="%toshift"
                                     styleClass="cell-center-aligned"/>
                        <TableColumn fx:id="colInterval" prefWidth="100.0" text="%interval"
                                     styleClass="cell-center-aligned"/>
                    </columns>
                    <VBox.margin>
                        <Insets/>
                    </VBox.margin>
                </TableView>
                <HBox alignment="CENTER_RIGHT" prefWidth="200.0" spacing="15">
                    <children>
                        <Button fx:id="btnSaveUpdate" mnemonicParsing="true" prefHeight="30.0" prefWidth="80.0"
                                styleClass="button-primary" text="%save"/>
                        <Button fx:id="btnClose" mnemonicParsing="true" prefHeight="30.0" prefWidth="80.0"
                                text="%close"/>
                    </children>
                </HBox>
            </children>
            <padding>
                <Insets bottom="25.0" left="25.0" right="25.0" top="25.0"/>
            </padding>
        </VBox>
    </children>
    <padding>
        <Insets bottom="15.0" left="15.0" right="15.0" top="15.0"/>
    </padding>
</StackPane>
