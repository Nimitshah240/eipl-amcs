<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<StackPane xmlns:fx="http://javafx.com/fxml/1" fx:id="root" prefHeight="400.0" prefWidth="600.0"
           styleClass="pane-center" xmlns="http://javafx.com/javafx/11"
           fx:controller="com.eipl.amcs.master.org.controller.UnionController">
    <children>
        <VBox prefHeight="200.0" prefWidth="100.0" spacing="15.0">
            <children>
                <Label styleClass="header-text" text="%union"/>
                <TableView fx:id="tableUnion" prefHeight="350.0" prefWidth="600.0" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="colCode" prefWidth="100.0" styleClass="cell-center-aligned" text="%code"/>
                        <TableColumn fx:id="colCodeEx" prefWidth="100.0" text="%codeex"
                                     styleClass="cell-center-aligned"/>
                        <TableColumn fx:id="colRegistrationCode" prefWidth="200.0" text="%registrationcode"
                                     styleClass="cell-center-aligned"/>
                        <TableColumn fx:id="colName" prefWidth="200.0" text="%name"/>
                        <TableColumn fx:id="colLocalName" prefWidth="200.0" text="%localname"/>
                        <TableColumn fx:id="colRegistrationDate" prefWidth="200.0" text="%registrationdate"
                                     styleClass="cell-center-aligned"/>
                        <TableColumn fx:id="colPhoneNo" prefWidth="150.0" text="%phoneno"/>
                        <TableColumn fx:id="colCity" prefWidth="150.0" text="%city"/>
                        <TableColumn fx:id="colContactPerson" prefWidth="200.0" text="%contactperson"/>
                        <TableColumn fx:id="colContactPersonMobileNo" prefWidth="200.0" text="%contactpersonmobileno"/>
                        <TableColumn fx:id="colStatus" prefWidth="100.0" text="%status"
                                     styleClass="cell-center-aligned"/>
                    </columns>
                </TableView>
                <HBox prefWidth="200.0">
                    <children>
                        <Button fx:id="btnClose" mnemonicParsing="true" prefHeight="30.0" prefWidth="80.0"
                                text="%close"/>
                    </children>
                </HBox>
            </children>
        </VBox>
    </children>
</StackPane>
