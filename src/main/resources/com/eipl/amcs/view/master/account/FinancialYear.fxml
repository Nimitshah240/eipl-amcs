<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane xmlns:fx="http://javafx.com/fxml/1" prefHeight="400.0" prefWidth="600.0" styleClass="pane-center"
           xmlns="http://javafx.com/javafx/11"
           fx:controller="com.eipl.amcs.master.account.controller.FinancialYearController">
    <children>
        <VBox prefHeight="200.0" prefWidth="100.0" spacing="15.0">
            <children>
                <Label styleClass="header-text" text="%financialyear"/>
                <TableView fx:id="tableFinancialYear" prefHeight="350.0" prefWidth="600.0" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="colCode" prefWidth="125.0" text="%code" styleClass="cell-center-aligned"/>
                        <TableColumn fx:id="colStartDate" prefWidth="125.0" text="%startdate"
                                     styleClass="cell-center-aligned"/>
                        <TableColumn fx:id="colEndDate" prefWidth="125.0" text="%enddate"
                                     styleClass="cell-center-aligned"/>
                        <TableColumn fx:id="colStatus" prefWidth="100.0" text="%status"
                                     styleClass="cell-center-aligned"/>
                    </columns>
                </TableView>
                <HBox prefWidth="200.0" spacing="15">
                    <children>
                        <Button fx:id="btnClose" mnemonicParsing="true" prefHeight="30.0" prefWidth="80.0"
                                text="%close"/>
                    </children>
                </HBox>
            </children>
        </VBox>
    </children>
</StackPane>
