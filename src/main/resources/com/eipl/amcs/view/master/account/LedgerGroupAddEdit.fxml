<?xml version="1.0" encoding="UTF-8"?>

<?import com.eipl.amcs.controls.E_Button?>
<?import com.eipl.amcs.controls.E_ComboBox?>
<?import com.eipl.amcs.controls.E_TextField?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.RowConstraints?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane fx:id="root" prefWidth="600.0" xmlns="http://javafx.com/javafx/20.0.1" xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="com.eipl.amcs.master.account.controller.LedgerGroupAddEditController">
    <children>
        <VBox prefHeight="200.0" prefWidth="100.0" spacing="20.0" styleClass="pane-white-drop-border">
            <children>
                <HBox>
                    <children>
                        <Label styleClass="header-text" text="%ledgergroup"/>
                        <HBox alignment="TOP_RIGHT" HBox.hgrow="ALWAYS"/>
                    </children>
                </HBox>
                <GridPane hgap="10.0" prefHeight="141.0" prefWidth="196.0" vgap="5.0">
                    <columnConstraints>
                        <ColumnConstraints hgrow="SOMETIMES" maxWidth="186.0" minWidth="10.0" percentWidth="33.0"
                                           prefWidth="167.0"/>
                        <ColumnConstraints hgrow="SOMETIMES" maxWidth="186.0" minWidth="10.0" percentWidth="33.0"
                                           prefWidth="167.0"/>
                        <ColumnConstraints hgrow="SOMETIMES" maxWidth="191.0" minWidth="10.0" percentWidth="33.0"
                                           prefWidth="150.0"/>
                        <ColumnConstraints hgrow="SOMETIMES" maxWidth="81.0" minWidth="10.0" percentWidth="33.0"
                                           prefWidth="77.0"/>
                    </columnConstraints>
                    <rowConstraints>
                        <RowConstraints minHeight="30.0" prefHeight="30.0" vgrow="SOMETIMES"/>
                        <RowConstraints minHeight="30.0" prefHeight="30.0" vgrow="SOMETIMES"/>
                        <RowConstraints vgrow="SOMETIMES"/>
                    </rowConstraints>

                    <children>
                        <Label text="%name" GridPane.columnIndex="1"/>
                        <E_TextField fx:id="txtName" maxWidth="1.7976931348623157E308" GridPane.columnIndex="1"
                                     GridPane.rowIndex="1"/>
                        <Label text="%localname" GridPane.columnIndex="2"/>
                        <E_TextField fx:id="txtLocalName" maxWidth="1.7976931348623157E308" GridPane.columnIndex="2"
                                     GridPane.rowIndex="1"/>
                        <E_ComboBox fx:id="cboxLedgertype" maxWidth="1.7976931348623157E308" GridPane.columnIndex="3"
                                    GridPane.rowIndex="1"/>

                        <Label text="%ledgertype" GridPane.columnIndex="3"/>
                        <Label text="%code"/>
                        <E_TextField fx:id="txtCode" disable="true" GridPane.rowIndex="1"/>
                    </children>
                </GridPane>
                <HBox alignment="CENTER_RIGHT" prefHeight="100.0" prefWidth="200.0"/>
                <HBox alignment="CENTER_RIGHT" prefWidth="200.0" spacing="15">
                    <children>
                        <E_Button fx:id="btnSaveUpdate" contentDisplay="TOP" graphicTextGap="5.0" mnemonicParsing="true"
                                  prefHeight="25.0" prefWidth="76.0" text="%save">
                            <graphic>
                                <ImageView fitHeight="40.0" fitWidth="40.0" pickOnBounds="true" preserveRatio="true">
                                    <image>
                                        <Image url="@../../images/save.png"/>
                                    </image>
                                </ImageView>
                            </graphic>
                        </E_Button>
                        <E_Button fx:id="btnClose" contentDisplay="TOP" graphicTextGap="5.0" mnemonicParsing="true"
                                  prefHeight="30.0" prefWidth="80.0" text="%close">
                            <graphic>
                                <ImageView fitHeight="40.0" fitWidth="40.0" pickOnBounds="true" preserveRatio="true">
                                    <image>
                                        <Image url="@../../images/close.png"/>
                                    </image>
                                </ImageView>
                            </graphic>
                        </E_Button>
                    </children>
                </HBox>
            </children>
            <padding>
                <Insets bottom="25.0" left="25.0" right="25.0" top="25.0"/>
            </padding>
        </VBox>
    </children>
    <padding>
        <Insets bottom="15.0" left="15.0" right="15.0" top="15.0"/>
    </padding>
</StackPane>
