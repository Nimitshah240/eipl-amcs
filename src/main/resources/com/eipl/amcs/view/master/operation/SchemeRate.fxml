<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane fx:id="root" prefHeight="400.0" prefWidth="600.0" styleClass="pane-center" xmlns="http://javafx.com/javafx/20.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.eipl.amcs.master.operation.controller.SchemeRateController">
    <children>
        <VBox prefHeight="200.0" prefWidth="600.0" spacing="15.0">
            <children>
                <HBox prefHeight="51.0" prefWidth="600.0" spacing="5.0">
                    <children>
                        <Label maxHeight="1.7976931348623157E308" styleClass="header-text" text="%schemerate" HBox.hgrow="ALWAYS">
                            <HBox.margin>
                                <Insets />
                            </HBox.margin>
                        </Label>
                  <Label fx:id="lblInsurance" alignment="CENTER" maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308" style="-fx-font-size: 18; -fx-text-fill: red;" HBox.hgrow="ALWAYS">
                     <HBox.margin>
                        <Insets left="15.0" />
                     </HBox.margin>
                  </Label>
                    </children>
                </HBox>
                <TableView fx:id="tableSchemeRateApplicability" maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308" prefHeight="317.0" prefWidth="600.0" VBox.vgrow="ALWAYS">
                    <columns>
                  <TableColumn fx:id="colRateAppCode" minWidth="-1.0" prefWidth="100.0" styleClass="cell-center-aligned" text="%code" />
                        <TableColumn fx:id="colFromDate" minWidth="-1.0" prefWidth="100.0"  text="%fromdate" />
                        <TableColumn fx:id="colFromShift" minWidth="-1.0" prefWidth="100.0" text="%fromshift" />
                        <TableColumn fx:id="colToDate" minWidth="-1.0" prefWidth="100.0" text="%todate" />
                        <TableColumn fx:id="colToShift" minWidth="-1.0" prefWidth="100.0"  text="%toshift" />
                        <TableColumn fx:id="colRtpl" minWidth="-1.0" prefWidth="100.0"  text="%rate" />
                        <TableColumn fx:id="colDescription" minWidth="-1.0" prefWidth="150.0" text="%description" />
<!--                        <TableColumn fx:id="colStatus" prefWidth="75.0" styleClass="cell-right-aligned" text="%status" />-->
                    </columns>
               <columnResizePolicy>
                  <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
               </columnResizePolicy>
                </TableView>
                <HBox prefWidth="600.0" spacing="15">
                    <children>
                        <Button fx:id="btnClose" layoutX="200.0" layoutY="10.0" prefHeight="30.0" prefWidth="80.0" text="%close" />
                  <Label maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308" HBox.hgrow="ALWAYS" />
<!--                  <E_Button fx:id="btnReport" layoutX="530.0" layoutY="10.0" prefHeight="30.0" prefWidth="80.0" styleClass="button-primary" text="%report" />-->
                    </children>
                </HBox>
            </children>
        </VBox>
    </children>
</StackPane>
