<?xml version="1.0" encoding="UTF-8"?>

<?import com.eipl.amcs.controls.E_Button?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane fx:id="root" prefWidth="600.0" styleClass="pane-center" xmlns="http://javafx.com/javafx/20.0.1"
           xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="com.eipl.amcs.master.account.controller.TaxDetailController">
    <children>
        <VBox spacing="20.0" styleClass="">
            <children>
                <Label styleClass="header-text" text="%taxdetail"/>
                <TableView fx:id="tableTaxDetail" prefHeight="200.0" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="colType" minWidth="120.0" prefWidth="-1.0" text="%type"/>
                        <TableColumn fx:id="colPercentage" minWidth="120.0" prefWidth="-1.0" text="%percentage"/>
                        <TableColumn fx:id="colBasicTax" minWidth="120.0" prefWidth="-1.0" text="%basictax"/>
                    </columns>
                </TableView>
                <HBox prefWidth="200.0">
                    <children>
                        <E_Button fx:id="btnClose" contentDisplay="TOP" graphicTextGap="5.0" mnemonicParsing="true"
                                  prefHeight="30.0" prefWidth="80.0" text="%close">
                            <graphic>
                                <ImageView fitHeight="40.0" fitWidth="40.0" pickOnBounds="true" preserveRatio="true">
                                    <image>
                                        <Image url="@../../images/close.png"/>
                                    </image>
                                </ImageView>
                            </graphic>
                        </E_Button>
                    </children>
                </HBox>
            </children>
            <StackPane.margin>
                <Insets/>
            </StackPane.margin>
            <padding>
                <Insets bottom="25.0" left="25.0" right="25.0" top="25.0"/>
            </padding>
        </VBox>
    </children>
    <padding>
        <Insets bottom="15.0" left="15.0" right="15.0" top="15.0"/>
    </padding>
</StackPane>
