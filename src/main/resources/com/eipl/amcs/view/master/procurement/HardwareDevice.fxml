<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.HBox?>

<StackPane fx:id="root" prefHeight="400.0" prefWidth="600.0" styleClass="pane-center"
           xmlns="http://javafx.com/javafx/11" xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="com.eipl.amcs.master.procurement.controller.HardwareDeviceController">
    <children>
        <VBox prefHeight="200.0" prefWidth="100.0" spacing="15.0">
            <children>
                <Label styleClass="header-text" text="%hardwaredevice"/>
                <TableView fx:id="tableHardwareDevices" prefHeight="350.0" prefWidth="600.0" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="colCode" prefWidth="100.0" styleClass="cell-center-aligned"
                                     text="%code"/>
                        <TableColumn fx:id="colDeviceName" prefWidth="200.0" text="%devicename"/>
                        <TableColumn fx:id="colDeviceType" prefWidth="100.0" text="%devicetype"
                                     styleClass="cell-center-aligned"/>
                        <TableColumn fx:id="colBaudRate" prefWidth="100.0" text="%baudrate"
                                     styleClass="cell-center-aligned"/>
                        <TableColumn fx:id="colBitRate" prefWidth="100.0" text="%bitrate"
                                     styleClass="cell-center-aligned"/>
                        <TableColumn fx:id="colParity" prefWidth="100.0" text="%parity"
                                     styleClass="cell-center-aligned"/>
                        <TableColumn fx:id="colStartChar" prefWidth="100.0" text="%startchar"/>
                        <TableColumn fx:id="colEndChar" prefWidth="100.0" text="%endchar"/>
                        <TableColumn fx:id="colTareChar" prefWidth="100.0" text="%tarechar"/>
                    </columns>
                </TableView>
                <HBox prefWidth="200.0">
                    <children>
                        <Button fx:id="btnClose" mnemonicParsing="true" prefHeight="30.0" prefWidth="80.0"
                                text="%close"/>
                    </children>
                </HBox>
            </children>
        </VBox>
    </children>
</StackPane>
