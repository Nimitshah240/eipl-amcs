<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane prefHeight="400.0" prefWidth="600.0" styleClass="pane-center" xmlns="http://javafx.com/javafx/16" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.eipl.amcs.master.inventory.controller.ProductController">
    <children>
        <VBox prefHeight="200.0" prefWidth="100.0" spacing="15.0">
            <children>
                <Label styleClass="header-text" text="%product" />
                <TableView fx:id="tableProduct" prefHeight="350.0" prefWidth="600.0" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="colCode" minWidth="150.0" prefWidth="150.0" styleClass="cell-center-aligned" text="%code" />
                        <TableColumn fx:id="colReferenceCode" minWidth="150.0" prefWidth="150.0" styleClass="cell-center-aligned" text="%referencecode" />
                        <TableColumn fx:id="colName" minWidth="200.0" prefWidth="200.0" text="%name" />
                        <TableColumn fx:id="colLocalName" minWidth="200.0" prefWidth="200.0" text="%localname" />
<!--                        <TableColumn fx:id="colProductGroup" prefWidth="130.0" text="%productgroup" />-->
<!--                        <TableColumn fx:id="colPrimaryUnit" prefWidth="100.0" text="%primaryunit" />-->
<!--                        <TableColumn fx:id="colTax" prefWidth="100.0" text="%tax" />-->
<!--                        <TableColumn fx:id="colIsActive" prefWidth="75.0" styleClass="cell-center-aligned" text="%status" />-->
                    </columns>
                </TableView>
                <HBox prefWidth="200.0" spacing="15">
                    <children>
                        <Button fx:id="btnAdd" mnemonicParsing="true" prefHeight="30.0" prefWidth="80.0" styleClass="button-primary" text="%add" />
                        <Button fx:id="btnEdit" disable="true" mnemonicParsing="true" prefHeight="30.0" prefWidth="80.0" text="%edit" />
                        <Button fx:id="btnDelete" disable="true" mnemonicParsing="true" prefHeight="30.0" prefWidth="80.0" text="%delete" />
                        <Button fx:id="btnClose" mnemonicParsing="true" prefHeight="30.0" prefWidth="80.0" text="%close" />
                    </children>
                </HBox>
            </children>
        </VBox>
    </children>
</StackPane>
