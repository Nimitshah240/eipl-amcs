<?xml version="1.0" encoding="UTF-8"?>

<?import com.eipl.amcs.controls.E_NumericField?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<StackPane fx:id="root" prefWidth="500.0" xmlns="http://javafx.com/javafx/11" xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="com.eipl.amcs.master.procurement.controller.LocalMilkSaleRateAddEditController">
    <children>
        <VBox prefHeight="200.0" prefWidth="100.0" spacing="20.0" styleClass="">
            <children>
                <Label styleClass="header-text" text="%localmilksalerate"/>
                <GridPane fx:id="grid" hgap="15.0">
                    <columnConstraints>
                        <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" percentWidth="33.0" prefWidth="100.0"/>
                        <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" percentWidth="33.0" prefWidth="100.0"/>
                        <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" percentWidth="33.0" prefWidth="100.0"/>
                    </columnConstraints>
                    <rowConstraints>
                        <RowConstraints minHeight="30.0" prefHeight="30.0" vgrow="SOMETIMES"/>
                        <RowConstraints minHeight="30.0" prefHeight="30.0" vgrow="SOMETIMES"/>
                        <RowConstraints minHeight="30.0" prefHeight="30.0" vgrow="SOMETIMES"/>
                        <RowConstraints minHeight="30.0" prefHeight="30.0" vgrow="SOMETIMES"/>
                    </rowConstraints>
                    <children>
                        <Label text="%wefdate"/>
                        <Label text="%milktype" GridPane.columnIndex="1"/>
                        <Label text="%milkclass" GridPane.columnIndex="2"/>
                        <Label text="%rateltr" GridPane.rowIndex="2"/>
                        <DatePicker fx:id="dpWefDate" maxWidth="1.7976931348623157E308" GridPane.rowIndex="1"/>
                        <ComboBox fx:id="cboxMilkType" maxWidth="1.7976931348623157E308"
                                  GridPane.columnIndex="1" GridPane.rowIndex="1"/>
                        <ComboBox fx:id="cboxMilkClass" maxWidth="1.7976931348623157E308"
                                  GridPane.columnIndex="2" GridPane.rowIndex="1"/>
                        <E_NumericField fx:id="txtRate" GridPane.rowIndex="3"/>
                    </children>
                </GridPane>
                <HBox alignment="CENTER_RIGHT" prefWidth="200.0" spacing="15">
                    <children>
                        <Button fx:id="btnSaveUpdate" mnemonicParsing="true" prefHeight="30.0" prefWidth="80.0"
                                styleClass="button-primary" text="%save"/>
                        <Button fx:id="btnClose" mnemonicParsing="true" prefHeight="30.0" prefWidth="80.0"
                                text="%close"/>
                    </children>
                </HBox>
            </children>
            <padding>
                <Insets bottom="25.0" left="25.0" right="25.0" top="25.0"/>
            </padding>
        </VBox>
    </children>
    <padding>
        <Insets bottom="15.0" left="15.0" right="15.0" top="15.0"/>
    </padding>
</StackPane>
