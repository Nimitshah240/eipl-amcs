<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane prefHeight="400.0" prefWidth="600.0" styleClass="pane-center" xmlns="http://javafx.com/javafx/20.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.eipl.amcs.master.operation.controller.MemberEkycController">
    <children>
        <VBox prefHeight="200.0" prefWidth="100.0" spacing="15.0">
            <children>
            <HBox alignment="TOP_RIGHT">
               <children>
                      <Label alignment="CENTER_RIGHT" styleClass="header-text" text="%memberekyc" />
                  <Label maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308" text=" " HBox.hgrow="ALWAYS" />
               </children>
            </HBox>
                <TableView fx:id="tableMemberEkyc" prefHeight="350.0" prefWidth="600.0" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="colCode" prefWidth="100.0" styleClass="cell-center-aligned" text="%code" />
                        <TableColumn fx:id="colName" prefWidth="300.0" text="%name" />
                        <TableColumn fx:id="colMobileNo" prefWidth="125.0" styleClass="cell-center-aligned" text="%mobileno" />
                        <TableColumn fx:id="colAadharNo" prefWidth="125.0" styleClass="cell-center-aligned" text="%aadharno" />
                        <TableColumn fx:id="colIsStatus" prefWidth="100.0" styleClass="cell-center-aligned" text="%status" />
                  <TableColumn fx:id="colIsVerified" prefWidth="100.0" styleClass="cell-center-aligned" text="%verified" />
                    </columns>
               <columnResizePolicy>
                  <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
               </columnResizePolicy>
                </TableView>
                <HBox alignment="CENTER_LEFT" prefWidth="200.0" spacing="15">
                    <children>
                        <Button fx:id="btnClose" mnemonicParsing="true" prefHeight="30.0" prefWidth="80.0" text="%close" />
                        <Label fx:id="lblStatus" alignment="CENTER" contentDisplay="CENTER" maxWidth="1.7976931348623157E308" HBox.hgrow="ALWAYS" />
                    </children>
               <padding>
                  <Insets bottom="5.0" left="5.0" />
               </padding>
                </HBox>
            </children>
        </VBox>
    </children>
</StackPane>
