<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane xmlns:fx="http://javafx.com/fxml/1" prefHeight="400.0" prefWidth="600.0" styleClass="pane-center"
           xmlns="http://javafx.com/javafx/11"
           fx:controller="com.eipl.amcs.master.inventory.controller.ProductPurchaseRateController">
    <children>
        <VBox prefHeight="200.0" prefWidth="100.0" spacing="15.0">
            <children>
                <Label styleClass="header-text" text="%productpurchaserate"/>
                <TableView fx:id="tableProductPurchaseRate" prefHeight="350.0" prefWidth="600.0" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="colCode" prefWidth="150.0" text="%code" styleClass="cell-center-aligned"/>
                        <TableColumn fx:id="colProduct" prefWidth="150.0" text="%product"/>
                        <TableColumn fx:id="colWefDate" prefWidth="150.0" text="%wefdate"
                                     styleClass="cell-center-aligned"/>
                        <TableColumn fx:id="colRate" prefWidth="150.0" text="%rate" styleClass="cell-right-aligned"/>
                    </columns>
                </TableView>
                <HBox prefWidth="200.0" spacing="15">
                    <children>
                        <Button fx:id="btnAdd" mnemonicParsing="true" prefHeight="30.0" prefWidth="80.0"
                                styleClass="button-primary" text="%add"/>
                        <Button fx:id="btnEdit" mnemonicParsing="true" prefHeight="30.0" prefWidth="80.0" text="%edit"
                                disable="true"/>
                        <Button fx:id="btnDelete" mnemonicParsing="true" prefHeight="30.0" prefWidth="80.0"
                                text="%delete" disable="true"/>
                        <Button fx:id="btnClose" mnemonicParsing="true" prefHeight="30.0" prefWidth="80.0"
                                text="%close"/>
                    </children>
                </HBox>
            </children>
        </VBox>
    </children>
</StackPane>
