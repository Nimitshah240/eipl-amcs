<?xml version="1.0" encoding="UTF-8"?>

<?import com.eipl.amcs.controls.*?>
<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<StackPane fx:id="root" minWidth="800.0" prefWidth="800.0" styleClass="pane-center" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.eipl.amcs.master.account.controller.LedgerAddEditController">
    <children>
        <VBox prefHeight="550.0" prefWidth="550.0" spacing="20.0">
            <children>
                <Label styleClass="header-text" text="%ledger" />
                <GridPane fx:id="gridMaster" hgap="10.0" VBox.vgrow="ALWAYS">
                    <columnConstraints>
                        <ColumnConstraints hgrow="SOMETIMES" percentWidth="25.0" />
                        <ColumnConstraints hgrow="SOMETIMES" percentWidth="25.0" />
                        <ColumnConstraints hgrow="SOMETIMES" percentWidth="25.0" />
                        <ColumnConstraints hgrow="SOMETIMES" maxWidth="178.0" minWidth="115.0" percentWidth="25.0" prefWidth="146.0" />
                  <ColumnConstraints hgrow="SOMETIMES" maxWidth="1.7976931348623157E308" percentWidth="5.0" />
                  <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" percentWidth="25.0" prefWidth="100.0" />
                  <ColumnConstraints />
                    </columnConstraints>
                    <rowConstraints>
                        <RowConstraints minHeight="22.0" percentHeight="0.0" vgrow="SOMETIMES" />
                        <RowConstraints percentHeight="0.0" vgrow="SOMETIMES" />
                        <RowConstraints minHeight="22.0" percentHeight="0.0" vgrow="SOMETIMES" />
                        <RowConstraints percentHeight="0.0" vgrow="SOMETIMES" />
                  <RowConstraints percentHeight="0.0" vgrow="SOMETIMES" />
                    </rowConstraints>
                    <children>
                        <Label text="%name" GridPane.rowIndex="2" />
                        <Label text="%ledgergroup" GridPane.columnIndex="1" />
                        <ComboBox fx:id="cboxLedgerType" editable="true" maxWidth="1.7976931348623157E308" GridPane.rowIndex="1" />
                        <ComboBox fx:id="cboxLedgerGroup" editable="true" maxWidth="1.7976931348623157E308" GridPane.columnIndex="1" GridPane.rowIndex="1" />
                        <E_TextField fx:id="txtCode" disable="true" maxWidth="1.7976931348623157E308" prefHeight="25.0" prefWidth="116.0" GridPane.columnIndex="2" GridPane.rowIndex="1" />
                        <E_TextField fx:id="txtName" maxWidth="1.7976931348623157E308" GridPane.columnSpan="2" GridPane.rowIndex="3" />
                        <E_TextField fx:id="txtLocalName" maxWidth="1.7976931348623157E308" GridPane.columnIndex="2" GridPane.columnSpan="2" GridPane.rowIndex="3" />
                        <Label text="%code" GridPane.columnIndex="2" />
                        <Label text="%ledgertype" />
                        <Label text="%localname" GridPane.columnIndex="2" GridPane.rowIndex="2" />
                  <HBox fx:id="hboxMaster" alignment="CENTER_LEFT" maxWidth="200.0" prefHeight="25.0" spacing="15" GridPane.columnIndex="5" GridPane.columnSpan="2" GridPane.rowIndex="3">
                     <children>
                        <E_Button fx:id="btnSaveUpdate" mnemonicParsing="true" prefHeight="25.0" prefWidth="76.0" styleClass="button-primary" text="%save" />
                        <E_Button fx:id="btnClose" mnemonicParsing="true" prefHeight="30.0" prefWidth="80.0" text="%close" />
                     </children>
                  </HBox>
                  <CheckBox fx:id="chkBoxSubLedger" mnemonicParsing="false" text="%hassubledger" visible="false" GridPane.columnIndex="5" GridPane.rowIndex="1" />
                    </children>
                </GridPane>
                <GridPane fx:id="gridProduct" hgap="5.0" prefHeight="22.0" prefWidth="607.0" style="-fx-background-fill: black;">
                    <columnConstraints>
                        <ColumnConstraints hgrow="SOMETIMES" percentWidth="18.0" />
                        <ColumnConstraints hgrow="SOMETIMES" percentWidth="12.0" />
                        <ColumnConstraints hgrow="SOMETIMES" percentWidth="12.0" />
                        <ColumnConstraints hgrow="SOMETIMES" percentWidth="12.0" />
                  <ColumnConstraints hgrow="SOMETIMES" percentWidth="12.0" />
                  <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" percentWidth="12.0" prefWidth="100.0" />
                    </columnConstraints>
                    <rowConstraints>
                        <RowConstraints minHeight="22.0" percentHeight="0.0" vgrow="SOMETIMES" />
                        <RowConstraints percentHeight="0.0" vgrow="SOMETIMES" />
                        <RowConstraints percentHeight="0.0" vgrow="SOMETIMES" />
                        <RowConstraints percentHeight="0.0" vgrow="SOMETIMES" />
                    </rowConstraints>
               <children>
                  <CheckBox fx:id="chkBoxSelectAll" disable="true" mnemonicParsing="false" text="%selectall" visible="false" />
               </children>
                </GridPane>
                <TableView fx:id="tableSubLedgerData" focusTraversable="false" prefHeight="350.0" visible="false" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="colSelect" maxWidth="1.7976931348623157E308" minWidth="-1.0" prefWidth="100.0" text="%select" />
                        <TableColumn fx:id="colSubLedger" maxWidth="1.7976931348623157E308" minWidth="-1.0" prefWidth="-1.0" text="%subledgertype" />
                        <TableColumn fx:id="colCode" maxWidth="1.7976931348623157E308" minWidth="100.0" prefWidth="100.0" text="%code" />
                        <TableColumn fx:id="colName" maxWidth="1.7976931348623157E308" minWidth="-1.0" prefWidth="200.0" text="%name" />
                        <TableColumn fx:id="colLocalName" maxWidth="1.7976931348623157E308" minWidth="-1.0" prefWidth="200.0" text="%localname" />
                    </columns>
                    <VBox.margin>
                        <Insets />
                    </VBox.margin>
                </TableView>
            </children>
            <padding>
                <Insets bottom="15.0" left="25.0" right="25.0" top="15.0" />
            </padding>
        </VBox>
    </children>
    <padding>
        <Insets bottom="15.0" left="15.0" right="15.0" top="15.0" />
    </padding>
</StackPane>
