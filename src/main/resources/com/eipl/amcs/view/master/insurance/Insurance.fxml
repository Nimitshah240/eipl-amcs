<?xml version="1.0" encoding="UTF-8"?>

<?import com.eipl.amcs.controls.E_Button?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane fx:id="root" prefHeight="400.0" prefWidth="600.0" styleClass="pane-center" xmlns="http://javafx.com/javafx/20.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.eipl.amcs.master.insurance.controller.InsuranceMasterController">
    <children>
        <VBox prefHeight="200.0" prefWidth="100.0" spacing="15.0">
            <children>
                <HBox prefHeight="51.0" prefWidth="600.0" spacing="5.0">
                    <children>
                        <Label styleClass="header-text" text="%insurancemaster" HBox.hgrow="ALWAYS">
                            <HBox.margin>
                                <Insets />
                            </HBox.margin>
                        </Label>
                        <Label contentDisplay="RIGHT" prefHeight="31.0" prefWidth="176.0" text=" " />
                        <HBox alignment="CENTER_RIGHT" nodeOrientation="LEFT_TO_RIGHT" HBox.hgrow="ALWAYS" />
                    </children>
                </HBox>
                <TableView fx:id="tableInsuranceMaster" prefHeight="317.0" prefWidth="600.0" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="colInsuranceDescription" prefWidth="135.0" styleClass="cell-center-aligned" text="%insurancedescription" />
                        <TableColumn fx:id="colInsuranceStartDate" prefWidth="80.0" styleClass="cell-center-aligned" text="%insurancestartdate" />
                        <TableColumn fx:id="colInsuranceEndDate" prefWidth="130.0" styleClass="cell-center-aligned" text="%insuranceenddate" />
                  <TableColumn fx:id="colMinAge" prefWidth="130.0" styleClass="cell-center-aligned" text="%minage" />
                  <TableColumn fx:id="colMaxAge" prefWidth="130.0" styleClass="cell-center-aligned" text="%maxage" />
<!--                  <TableColumn fx:id="colStatus" prefWidth="130.0" styleClass="cell-center-aligned" text="%status" />-->
                    </columns>
                    <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                    </columnResizePolicy>
                </TableView>
                <HBox maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308" minHeight="80.0" spacing="15">
                    <children>
                        <E_Button fx:id="btnView" contentDisplay="TOP" styleClass="button-primary" text="%viewinsurance">
                     <graphic>
                        <ImageView fitHeight="40.0" fitWidth="40.0" pickOnBounds="true" preserveRatio="true">
                           <image>
                              <Image url="@../../images/search.png" />
                           </image>
                        </ImageView>
                     </graphic></E_Button>
                        <Label maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308" text=" " HBox.hgrow="ALWAYS" />
                        <E_Button fx:id="btnExport" contentDisplay="TOP" minHeight="35.0" minWidth="100.0" styleClass="button" text="%export">
                     <graphic>
                        <ImageView fitHeight="40.0" fitWidth="40.0" pickOnBounds="true" preserveRatio="true">
                           <image>
                              <Image url="@../../images/excel.png" />
                           </image>
                        </ImageView>
                     </graphic></E_Button>
                        <E_Button fx:id="btnFinalize" contentDisplay="TOP" styleClass="button-primary" text="%finalize">
                     <graphic>
                        <ImageView fitHeight="40.0" fitWidth="40.0" pickOnBounds="true" preserveRatio="true">
                           <image>
                              <Image url="@../../images/approve.png" />
                           </image>
                        </ImageView>
                     </graphic></E_Button>
                    </children>
                </HBox>
            </children>
        </VBox>
    </children>
</StackPane>
