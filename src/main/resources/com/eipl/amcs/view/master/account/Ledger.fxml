<?xml version="1.0" encoding="UTF-8"?>

<?import com.eipl.amcs.controls.E_Button?>
<?import com.eipl.amcs.controls.E_ComboBox?>
<?import com.eipl.amcs.controls.E_TextField?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane prefHeight="400.0" prefWidth="600.0" styleClass="pane-center" xmlns="http://javafx.com/javafx/20.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.eipl.amcs.master.account.controller.LedgerController">
    <children>
        <VBox prefHeight="200.0" prefWidth="100.0" spacing="15.0">
            <children>
            <HBox spacing="10.0">
               <children>
                      <Label styleClass="header-text" text="%ledger" />
                  <Label maxWidth="1.7976931348623157E308" styleClass="header-text" HBox.hgrow="ALWAYS" />
                  <E_ComboBox fx:id="cboxLedgerGroup" />
                  <E_TextField fx:id="txtSearch" />
                  <E_Button fx:id="btnClear" text="%clear" />
               </children>
            </HBox>
                <TableView fx:id="tableLedger" prefHeight="350.0" prefWidth="600.0" VBox.vgrow="ALWAYS">
                    <columns>
                  <TableColumn fx:id="colCode" prefWidth="150.0" text="%code" />
                        <TableColumn fx:id="colName" prefWidth="250.0" text="%name" />
                        <TableColumn fx:id="colLocalName" prefWidth="250.0" text="%localname" />
                        <TableColumn fx:id="colLedgerGroup" prefWidth="150.0" text="%ledgergroup" />
                    </columns>
                </TableView>
                <HBox prefWidth="200.0" spacing="15">
                    <children>
                        <Button fx:id="btnAdd" mnemonicParsing="true" prefHeight="30.0" prefWidth="80.0" styleClass="button-primary" text="%add" />
                        <Button fx:id="btnEdit" disable="true" mnemonicParsing="true" prefHeight="30.0" prefWidth="80.0" text="%edit" />
                        <Button fx:id="btnDelete" disable="true" mnemonicParsing="true" prefHeight="30.0" prefWidth="80.0" text="%delete" />
                        <Button fx:id="btnClose" mnemonicParsing="true" prefHeight="30.0" prefWidth="80.0" text="%close" />
                        <Label maxWidth="1.7976931348623157E308" HBox.hgrow="ALWAYS" />
                        <Button fx:id="btnExport" mnemonicParsing="true" prefHeight="30.0" prefWidth="80.0" text="%export" />
                    </children>
                </HBox>
            </children>
        </VBox>
    </children>
</StackPane>
