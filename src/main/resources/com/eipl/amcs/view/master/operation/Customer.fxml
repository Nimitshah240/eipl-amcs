<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane prefHeight="400.0" prefWidth="600.0" styleClass="pane-center" xmlns="http://javafx.com/javafx/11"
           xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="com.eipl.amcs.master.operation.controller.CustomerController">
    <children>
        <VBox prefHeight="200.0" prefWidth="100.0" spacing="15.0">
            <children>
                <Label styleClass="header-text" text="%customer"/>
                <TableView fx:id="tableCustomer" prefHeight="350.0" prefWidth="600.0" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="colCode" prefWidth="125.0" text="%code" styleClass="cell-center-aligned"/>
                        <TableColumn fx:id="colName" prefWidth="200.0" text="%name"/>
                        <TableColumn fx:id="colLocalName" prefWidth="200.0" text="%localname"/>
                        <TableColumn fx:id="colMobileNo" prefWidth="125.0" text="%mobileno"
                                     styleClass="cell-center-aligned"/>
                        <TableColumn fx:id="colType" prefWidth="125.0" text="%type" styleClass="cell-center-aligned"/>
                        <TableColumn fx:id="colStatus" prefWidth="125.0" text="%status"
                                     styleClass="cell-center-aligned"/>
                    </columns>
                </TableView>
                <HBox prefWidth="200.0" spacing="15">
                    <children>
                        <Button fx:id="btnAdd" prefHeight="30.0" prefWidth="80.0" styleClass="button-primary"
                                text="%add"/>
                        <Button fx:id="btnEdit" prefHeight="30.0" prefWidth="80.0" text="%edit"/>
                        <Button fx:id="btnDelete" prefHeight="30.0" prefWidth="80.0" text="%delete"/>
                        <Button fx:id="btnClose" prefHeight="30.0" prefWidth="80.0" text="%close"/>
                    </children>
                </HBox>
            </children>
        </VBox>
    </children>
</StackPane>