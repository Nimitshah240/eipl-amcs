<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.RowConstraints?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>


<StackPane fx:id="root" prefHeight="400.0" prefWidth="600.0" styleClass="pane-center"
           xmlns="http://javafx.com/javafx/18" xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="com.eipl.amcs.master.procurement.controller.SocietyPaymentCycleController">
    <children>
        <VBox prefHeight="200.0" prefWidth="100.0" spacing="15.0">
            <children>
                <HBox prefHeight="54.0" prefWidth="600.0" spacing="5.0">
                    <children>
                        <Label styleClass="header-text" text="%societypaymentcycle"/>
                        <Label contentDisplay="RIGHT" prefHeight="71.0" prefWidth="176.0" text=" "/>
                        <HBox alignment="TOP_RIGHT" nodeOrientation="LEFT_TO_RIGHT" HBox.hgrow="ALWAYS">
                            <children>
                                <GridPane alignment="TOP_RIGHT" hgap="10.0" prefHeight="40.0" prefWidth="646.0"
                                          vgap="5.0">
                                    <columnConstraints>
                                        <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" percentWidth="23.0"
                                                           prefWidth="100.0"/>
                                        <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" percentWidth="20.0"
                                                           prefWidth="100.0"/>
                                        <ColumnConstraints hgrow="SOMETIMES" maxWidth="106.0" minWidth="10.0"
                                                           percentWidth="23.0" prefWidth="102.0"/>
                                        <ColumnConstraints hgrow="SOMETIMES" maxWidth="117.0" minWidth="10.0"
                                                           percentWidth="23.0" prefWidth="106.0"/>
                                        <ColumnConstraints halignment="RIGHT" hgrow="SOMETIMES" maxWidth="88.0"
                                                           minWidth="10.0" percentWidth="13.0" prefWidth="69.0"/>
                                    </columnConstraints>
                                    <rowConstraints>
                                        <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES"/>
                                        <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES"/>
                                    </rowConstraints>
                                    <children>
                                        <Label text="%fromdate" GridPane.columnIndex="2"/>
                                        <DatePicker fx:id="dpFromDate" GridPane.columnIndex="2" GridPane.rowIndex="1"/>
                                        <Label text="%todate" GridPane.columnIndex="3"/>
                                        <DatePicker fx:id="dpToDate" GridPane.columnIndex="3" GridPane.rowIndex="1"/>
                                        <Button fx:id="btnSearch" alignment="CENTER" contentDisplay="RIGHT"
                                                graphicTextGap="0.0" maxWidth="1.7976931348623157E308"
                                                mnemonicParsing="false" text="%search" GridPane.columnIndex="4"
                                                GridPane.rowIndex="1"/>
                                    </children>
                                </GridPane>
                            </children>
                        </HBox>
                    </children>
                </HBox>
                <TableView fx:id="tableSocietyPaymentCycles" prefHeight="303.0" prefWidth="600.0" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="colCode" prefWidth="100.0" styleClass="cell-center-aligned" text="%code"/>
                        <TableColumn fx:id="colFromDate" prefWidth="120.0" styleClass="cell-center-aligned"
                                     text="%fromdate"/>
                        <TableColumn fx:id="colFromShift" prefWidth="100.0" styleClass="cell-center-aligned"
                                     text="%fromshift"/>
                        <TableColumn fx:id="colToDate" prefWidth="120.0" styleClass="cell-center-aligned"
                                     text="%todate"/>
                        <TableColumn fx:id="colToShift" prefWidth="100.0" styleClass="cell-center-aligned"
                                     text="%toshift"/>
                        <TableColumn fx:id="colIntervalValue" prefWidth="120.0" styleClass="cell-center-aligned"
                                     text="%intervalvalue"/>
                        <TableColumn fx:id="colIsBilling" prefWidth="100.0" styleClass="cell-center-aligned"
                                     text="%isbilling"/>
                        <TableColumn fx:id="colLockBillingProcess" prefWidth="175.0" styleClass="cell-center-aligned"
                                     text="%lockbillingprocess"/>
                    </columns>
                </TableView>
                <HBox prefWidth="200.0" spacing="15">
                    <children>
                        <Button fx:id="btnGenerate" contentDisplay="TOP" graphicTextGap="5.0" prefHeight="50.0"
                                prefWidth="70.0" text="%add">
                            <graphic>
                                <ImageView fitHeight="40.0" fitWidth="40.0" pickOnBounds="true" preserveRatio="true">
                                    <image>
                                        <Image url="@../../images/add.png"/>
                                    </image>
                                </ImageView>
                            </graphic>
                        </Button>
                        <Button fx:id="btnEdit" contentDisplay="TOP" disable="true" graphicTextGap="5.0"
                                mnemonicParsing="true" prefHeight="50.0" prefWidth="70.0" text="%edit">
                            <graphic>
                                <ImageView fitHeight="40.0" fitWidth="40.0" pickOnBounds="true" preserveRatio="true">
                                    <image>
                                        <Image url="@../../images/edit.png"/>
                                    </image>
                                </ImageView>
                            </graphic>
                        </Button>
                        <Button fx:id="btnDelete" contentDisplay="TOP" disable="true" graphicTextGap="5.0"
                                mnemonicParsing="true" prefHeight="50.0" prefWidth="70.0" text="%delete">
                            <graphic>
                                <ImageView fitHeight="40.0" fitWidth="40.0" pickOnBounds="true" preserveRatio="true">
                                    <image>
                                        <Image url="@../../images/delete.png"/>
                                    </image>
                                </ImageView>
                            </graphic>
                        </Button>
                        <Button fx:id="btnClose" contentDisplay="TOP" graphicTextGap="5.0" prefHeight="50.0"
                                prefWidth="70.0" text="%close">
                            <graphic>
                                <ImageView fitHeight="40.0" fitWidth="40.0" pickOnBounds="true" preserveRatio="true">
                                    <image>
                                        <Image url="@../../images/close.png"/>
                                    </image>
                                </ImageView>
                            </graphic>
                        </Button>
                    </children>
                </HBox>

            </children>
        </VBox>
    </children>
</StackPane>
