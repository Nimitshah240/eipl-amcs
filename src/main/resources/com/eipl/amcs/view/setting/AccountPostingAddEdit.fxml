<?xml version="1.0" encoding="UTF-8"?>

<?import com.eipl.amcs.controls.*?>
<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<StackPane fx:id="root" prefHeight="600.0" prefWidth="700.0" stylesheets="@../styles.css" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.eipl.amcs.setting.controller.AccountPostingAddEditNewController">
    <children>
        <VBox prefHeight="200.0" prefWidth="100.0" spacing="10.0">
            <children>
                <Label styleClass="header-text" text="%accountposting">
                    <padding>
                        <Insets top="20.0" />
                    </padding>
                </Label>
                <HBox alignment="TOP_RIGHT" spacing="15.0">
                    <children>
                        <GridPane alignment="TOP_RIGHT" hgap="15.0" vgap="10.0" HBox.hgrow="ALWAYS">
                            <columnConstraints>
                                <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="55.0" />
                                <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="55.0" />
                                <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="55.0" />
                                <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="55.0" />
                                <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="55.0" />
                                <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="55.0" />
                                <ColumnConstraints halignment="RIGHT" minWidth="10.0" prefWidth="80.0" />
                            </columnConstraints>
                            <rowConstraints>
                                <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
                                <RowConstraints minHeight="10.0" vgrow="SOMETIMES" />
                            </rowConstraints>
                            <children>
                                <E_DatePicker fx:id="dpFromDate" maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308" GridPane.columnIndex="2" GridPane.rowIndex="1" />
                                <E_ComboBox fx:id="cboxFromShift" maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308" GridPane.columnIndex="3" GridPane.rowIndex="1" />
                                <E_DatePicker fx:id="dpToDate" maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308" GridPane.columnIndex="4" GridPane.rowIndex="1" />
                                <E_ComboBox fx:id="cboxToShift" maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308" GridPane.columnIndex="5" GridPane.rowIndex="1" />
                                <E_ComboBox fx:id="cboxPostingType" maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308" GridPane.columnIndex="1" GridPane.rowIndex="1" />
                                <E_Button fx:id="btnSearch" maxHeight="1.7976931348623157E308" maxWidth="80.0" prefWidth="80.0" styleClass="button-primary" text="%search" GridPane.columnIndex="6" GridPane.rowIndex="1" />
                                <Label maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308" text="%todate" GridPane.columnIndex="4" />
                                <Label maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308" text="%fromshift" GridPane.columnIndex="3" />
                                <Label maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308" text="%postingtype" GridPane.columnIndex="1" />
                                <Label maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308" text="%toshift" GridPane.columnIndex="5" />
                                <Label maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308" text="%fromdate" GridPane.columnIndex="2" />
                                <E_ComboBox fx:id="cboxEvent" maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308" GridPane.rowIndex="1" />
                                <Label maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308" text="%event" />
                            </children>
                            <HBox.margin>
                                <Insets />
                            </HBox.margin>
                        </GridPane>
                    </children>
                </HBox>
                <TableView fx:id="tableAccountPosting" VBox.vgrow="ALWAYS">
                    <columns>
<!--                        <TableColumn fx:id="colVoucher" prefWidth="75.0" text="%voucher" />-->

                        <TableColumn fx:id="colEvent" prefWidth="75.0" text="%event" />
                        <TableColumn fx:id="colDate" prefWidth="75.0" text="%date" />

                        <TableColumn fx:id="colLedgerCode" prefWidth="75.0" text="%ledgercode" />
                        <TableColumn fx:id="colLedgerName" prefWidth="75.0" text="%ledgername" />
                        <TableColumn fx:id="colNarration" prefWidth="75.0" text="%narration" />
                        <TableColumn fx:id="colType" prefWidth="75.0" text="%type" />
                        <TableColumn fx:id="colDebit" prefWidth="75.0" text="%debit" />
                        <TableColumn fx:id="colCredit" prefWidth="75.0" text="%credit" />
                    </columns>
                    <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                    </columnResizePolicy>
                </TableView>
                <HBox spacing="15.0">
                    <children>
                        <Button fx:id="btnSave" maxWidth="80.0" mnemonicParsing="false" prefWidth="80.0" text="%save" />
                        <Button fx:id="btnClose" maxWidth="80.0" prefWidth="80.0" text="%close" />
                        <Label maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308" HBox.hgrow="ALWAYS" />
                        <Button fx:id="btnPosting" maxWidth="80.0" mnemonicParsing="false" prefWidth="80.0" styleClass="button-primary" text="%posting" />
                    </children>
                </HBox>
            </children>
            <padding>
                <Insets bottom="10.0" left="25.0" right="25.0" />
            </padding>
        </VBox>
    </children>
    <padding>
        <Insets bottom="15.0" left="15.0" right="15.0" top="15.0" />
    </padding>
</StackPane>
