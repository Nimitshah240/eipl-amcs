<?xml version="1.0" encoding="UTF-8"?>

<?import com.eipl.amcs.controls.E_Button?>
<?import com.eipl.amcs.controls.E_DatePicker?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.RowConstraints?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane fx:id="root" prefHeight="600.0" prefWidth="700.0" xmlns="http://javafx.com/javafx/20.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.eipl.amcs.setting.controller.AccountPostingController">
    <children>
        <VBox maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308" spacing="15.0">
            <children>
            <HBox fx:id="" alignment="TOP_RIGHT" maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308" spacing="15.0">
               <children>
                      <Label styleClass="header-text" text="%accountposting">
                     <padding>
                        <Insets top="20.0" />
                     </padding>
                  </Label>
                  <Label maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308" styleClass="header-text" HBox.hgrow="ALWAYS" />
                  <GridPane hgap="10.0">
                     <columnConstraints>
                        <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" />
                        <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" />
                        <ColumnConstraints hgrow="SOMETIMES" />
                     </columnConstraints>
                     <rowConstraints>
                        <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
                        <RowConstraints minHeight="10.0" vgrow="SOMETIMES" />
                     </rowConstraints>
                     <children>
                        <Label text="%todate" GridPane.columnIndex="1" />
                        <Label text="%fromdate" />
                        <E_DatePicker fx:id="dpFromDate" GridPane.rowIndex="1" />
                        <E_DatePicker fx:id="dpToDate" GridPane.columnIndex="1" GridPane.rowIndex="1" />
                        <E_Button fx:id="btnSearch" maxWidth="80.0" prefWidth="80.0" styleClass="button-primary" text="%search" GridPane.columnIndex="2" GridPane.rowIndex="1" />
                     </children>
                  </GridPane>
               </children>
            </HBox>
            <TableView fx:id="tblAccountPosting" maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308" styleClass="" VBox.vgrow="ALWAYS">
              <columns>
                  <TableColumn fx:id="colEvent" prefWidth="75.0" text="%event" />
                  <TableColumn fx:id="colPostingType" prefWidth="75.0" text="%postingtype" />
                <TableColumn fx:id="colFromDate" prefWidth="75.0" text="%fromdate" />
                  <TableColumn fx:id="colFromShift" prefWidth="75.0" text="%fromshift" />
                  <TableColumn fx:id="colToDate" prefWidth="75.0" text="%todate" />
                  <TableColumn fx:id="colToShift" prefWidth="75.0" text="%toshift" />
                  <TableColumn fx:id="colStatus" prefWidth="75.0" text="%status" />
              </columns>
               <columnResizePolicy>
                  <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
               </columnResizePolicy>
            </TableView>
            <HBox spacing="15.0">
               <children>
                  <E_Button fx:id="btnAdd" maxWidth="80.0" prefWidth="80.0" styleClass="button-primary" text="%add" />
                  <E_Button fx:id="btnView" maxWidth="80.0" prefWidth="80.0" styleClass="button-primary" text="%view" />
                  <E_Button fx:id="btnClose" maxWidth="80.0" prefWidth="80.0" text="%close" />
               </children>
            </HBox>
            </children>
            <padding>
                <Insets bottom="10.0" left="25.0" right="25.0" top="10.0" />
            </padding>
        </VBox>
    </children>
    <padding>
        <Insets bottom="15.0" left="15.0" right="15.0" top="15.0" />
    </padding>
</StackPane>
