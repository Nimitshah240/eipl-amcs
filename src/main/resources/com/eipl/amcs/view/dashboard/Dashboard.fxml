                                    </Button>
                                 </children>
                              </HBox>
                              <LineChart fx:id="lineChart" title="%monthlysummary">
                                <xAxis>
                                  <CategoryAxis label="%month" side="BOTTOM" />
                                </xAxis>
                                <yAxis>
                                  <NumberAxis label="%litre" prefHeight="132.0" prefWidth="54.0" side="LEFT" tickLength="6.0" upperBound="15000.0" />
                                </yAxis>
                              </LineChart>
                           </children>
                           <padding>
                              <Insets top="10.0" />
                           </padding>
                        </VBox>
                          </children>
                      </HBox>
                      <HBox maxWidth="1.7976931348623157E308" spacing="20.0" VBox.vgrow="ALWAYS">
