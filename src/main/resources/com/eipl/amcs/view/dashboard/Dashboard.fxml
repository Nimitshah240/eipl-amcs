                                              </VBox.margin>
                                          </HBox>
                                          <TableView fx:id="tableCollection" nodeOrientation="LEFT_TO_RIGHT" styleClass="pane-white-drop-border" VBox.vgrow="ALWAYS" />
                                      </children>
                                  </VBox>
                                <VBox spacing="20.0" styleClass="pane-white-drop-border" HBox.hgrow="ALWAYS">
                                    <children>
                                        <HBox alignment="CENTER" spacing="10.0" VBox.vgrow="ALWAYS">
                                            <children>
                                                <HBox alignment="CENTER_LEFT" HBox.hgrow="ALWAYS">
