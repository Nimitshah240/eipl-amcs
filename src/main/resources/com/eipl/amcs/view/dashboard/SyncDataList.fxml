<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<?import com.eipl.amcs.controls.E_Button?>
<StackPane fx:id="root" prefWidth="400.0" styleClass="pane-white-drop-border" xmlns="http://javafx.com/javafx/20.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.eipl.amcs.base.SyncDataListController">
    <children>
      <VBox>
         <children>
              <Label maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308" minHeight="35.0" prefHeight="35.0" styleClass="header-text" text="%syncdatapending">
                  <VBox.margin>
                  <Insets bottom="10.0" />
               </VBox.margin>
            </Label>
              <TableView fx:id="tablePendingSync" prefHeight="300.0">
                  <columns>
                      <TableColumn fx:id="colTableName" prefWidth="200.0" text="%tablename" />
                      <TableColumn fx:id="colPendingData" prefWidth="170.0" text="%count" />
                  </columns>
              </TableView>
            <HBox alignment="TOP_RIGHT">
               <children>
                   <E_Button fx:id="btnClose" minWidth="75.0" mnemonicParsing="true" styleClass="button-primary" text="%close">
                       <HBox.margin>
                           <Insets top="5.0" />
                       </HBox.margin>
                   </E_Button>
               </children>
               <padding>
                  <Insets right="10.0" />
               </padding>
            </HBox>
         </children>
      </VBox>
    </children>
    <padding>
        <Insets bottom="15.0" left="15.0" right="15.0" top="15.0" />
    </padding>
</StackPane>
