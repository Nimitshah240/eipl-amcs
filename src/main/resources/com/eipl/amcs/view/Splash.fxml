<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.StackPane?>

<StackPane fx:id="root" prefHeight="450.0" prefWidth="800.0" xmlns="http://javafx.com/javafx/11"
           xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.eipl.amcs.base.SplashController">
    <children>
        <StackPane maxHeight="450.0" maxWidth="800.0" prefHeight="150.0" prefWidth="200.0" styleClass="pane-white-drop">
            <children>
                <AnchorPane prefHeight="200.0" prefWidth="200.0" styleClass="splash">
                    <children>
                        <Label fx:id="lbl" alignment="CENTER" styleClass="bold" text="%initializing.application"
                               AnchorPane.bottomAnchor="25.0" AnchorPane.leftAnchor="100.0"
                               AnchorPane.rightAnchor="100.0"/>
                    </children>
                </AnchorPane>
            </children>
        </StackPane>
    </children>
</StackPane>
