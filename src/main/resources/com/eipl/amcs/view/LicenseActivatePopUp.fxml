<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<StackPane fx:id="root" prefHeight="265.0" prefWidth="340.0" xmlns="http://javafx.com/javafx/17.0.12"
           xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.eipl.amcs.base.controller.LicenseActivateController">
    <children>
        <VBox prefHeight="256.0" prefWidth="310.0" spacing="20.0" styleClass="">
            <children>
                <!-- Header using project style class -->
<!--                <Label styleClass="header-text" text="AMCS Activation"/>-->

                <GridPane fx:id="grid" hgap="15.0" vgap="10.0">
                    <columnConstraints>
                        <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0"/>
                    </columnConstraints>
                    <rowConstraints>
                        <RowConstraints minHeight="20.0" vgrow="SOMETIMES"/>
                        <RowConstraints minHeight="35.0" vgrow="SOMETIMES"/>
                        <RowConstraints minHeight="20.0" vgrow="SOMETIMES"/>
                        <RowConstraints minHeight="35.0" vgrow="SOMETIMES"/>
                    </rowConstraints>
                    <children>
                        <!-- Activation Key Section -->
                        <Label fx:id="lblActivationKey" text="%activationkey" GridPane.rowIndex="0"/>
                        <TextField fx:id="txtActivationKey" prefHeight="35.0" prefWidth="235.0" GridPane.rowIndex="1"/>

                        <!-- License Key Section -->
                        <Label fx:id="lblLicenceKey" text="%passcode" GridPane.rowIndex="2"/>
                        <TextField fx:id="txtLicenceKey" prefHeight="35.0" prefWidth="345.0" GridPane.rowIndex="3"/>
                    </children>
                </GridPane>

                <!-- Buttons aligned to the right like Dock design -->
                <HBox alignment="CENTER_RIGHT" spacing="15.0">
                    <children>
                        <Button fx:id="btnActivateKey" mnemonicParsing="true" prefHeight="30.0" prefWidth="100.0"
                                styleClass="button-primary" text="%verify"/>
                        <Button fx:id="btnClose" mnemonicParsing="true" prefHeight="30.0" prefWidth="80.0"
                                text="%close"/>
                    </children>
                </HBox>
            </children>
            <padding>
                <Insets bottom="25.0" left="25.0" right="25.0" top="25.0"/>
            </padding>
        </VBox>
    </children>
    <padding>
        <Insets bottom="15.0" left="15.0" right="15.0" top="15.0"/>
    </padding>
</StackPane>
