<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Label?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.StackPane?>


<StackPane fx:id="root" prefHeight="450.0" prefWidth="800.0" xmlns="http://javafx.com/javafx/11"
           xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.eipl.amcs.base.controller.EmcsAppController">
    <children>
        <BorderPane fx:id="contentPane" styleClass="pane-off-white" prefHeight="200.0" prefWidth="200.0"/>
        <StackPane fx:id="paneDrop" styleClass="panebackdrop" visible="false">
            <children>
                <AnchorPane maxHeight="150.0" maxWidth="300.0" prefHeight="200.0" prefWidth="200.0"
                            styleClass="pane-white-drop-border">
                    <children>
                        <ImageView fitHeight="16.0" fitWidth="16.0" layoutX="37.0" pickOnBounds="true"
                                   preserveRatio="true" AnchorPane.leftAnchor="142.0" AnchorPane.topAnchor="36.0">
                            <image>
                                <Image url="@images/ajax-loader.gif"/>
                            </image>
                        </ImageView>
                        <Label fx:id="lblLoaderMessage" alignment="CENTER" layoutX="136.0" layoutY="86.0" text="Loading..."
                               AnchorPane.leftAnchor="30.0" AnchorPane.rightAnchor="30.0" AnchorPane.topAnchor="85.0"/>
                    </children>
                </AnchorPane>
            </children>
        </StackPane>
    </children>
</StackPane>
