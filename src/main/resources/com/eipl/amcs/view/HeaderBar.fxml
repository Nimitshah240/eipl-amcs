                <Label maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308" HBox.hgrow="ALWAYS" />
                <HBox alignment="CENTER" spacing="10.0" style="-fx-background-color: #ebebeb;">
                    <children>
                        <Button fx:id="btnMinimize" maxWidth="35.0" mnemonicParsing="false" prefWidth="35.0" style="-fx-background-color: transperent; -fx-border-color: black;" text="-">
